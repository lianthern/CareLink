{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:PutObject",
        "oss:DeleteObject",
        "oss:PutObjectAcl"
      ],
      "Resource": [
        "acs:oss:*:*:REPLACE_BUCKET/unseen-backend/v1/*",
        "acs:oss:*:*:REPLACE_BUCKET/spaces/u*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:ListObjects"
      ],
      "Resource": [
        "acs:oss:*:*:REPLACE_BUCKET"
      ],
      "Condition": {
        "StringLike": {
          "oss:Prefix": [
            "unseen-backend/v1/*"
          ]
        }
      }
    }
  ]
}
