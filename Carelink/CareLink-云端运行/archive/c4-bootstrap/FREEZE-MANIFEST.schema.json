{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unseen-c4-freeze-manifest/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "status",
    "c4FreezeComplete",
    "c4FreezeCompleteOwner",
    "canonicalContractWriter",
    "completionGates",
    "historicalBootstrap",
    "effectiveContractRevision",
    "acceptance",
    "controllerDeclarations",
    "contractMetrics",
    "frozenContracts",
    "authorityEvidenceCopies",
    "visualEvidenceCopies",
    "rootLockfile",
    "sourceManifests",
    "tracks"
  ],
  "properties": {
    "$schema": { "const": "./FREEZE-MANIFEST.schema.json" },
    "schemaVersion": { "const": "unseen-c4-freeze-manifest/2" },
    "status": { "const": "c4_effective_revision_freeze_complete" },
    "c4FreezeComplete": { "const": true },
    "c4FreezeCompleteOwner": { "const": "controller_only" },
    "canonicalContractWriter": { "const": "none-after-effective-revision-freeze" },
    "completionGates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreLocalOperable", "coreR0", "bookLabMve", "overall"],
      "properties": {
        "coreLocalOperable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidenceRoot", "goNoGoOwner", "passDefinition", "releaseMeaning", "affectsOverall"],
          "properties": {
            "evidenceRoot": { "const": "release-evidence/local-operable/" },
            "goNoGoOwner": { "const": "controller_only" },
            "passDefinition": { "const": "track5_stage_l_real_local_api_web_viewer_with_explicit_locator_fixture" },
            "releaseMeaning": { "const": "local_operable_not_integration_rc_r0_or_production" },
            "affectsOverall": { "const": false }
          }
        },
        "coreR0": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidenceRoot", "goNoGoOwner", "passDefinition", "track7ConsumesOnlyThisBooleanGate"],
          "properties": {
            "evidenceRoot": { "const": "release-evidence/r0/" },
            "goNoGoOwner": { "const": "controller_only" },
            "passDefinition": { "const": "core_module_integration_release_and_final_independent_reviews" },
            "track7ConsumesOnlyThisBooleanGate": { "const": true }
          }
        },
        "bookLabMve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidenceRoot", "goNoGoOwner", "passDefinition", "featureFlagDefault"],
          "properties": {
            "evidenceRoot": { "const": "release-evidence/book-lab/" },
            "goNoGoOwner": { "const": "controller_only" },
            "passDefinition": { "const": "track8_mve_and_final_independent_review" },
            "featureFlagDefault": { "const": "off" }
          }
        },
        "overall": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expression", "claim"],
          "properties": {
            "expression": { "const": "coreR0 == PASS && bookLabMve == PASS" },
            "claim": { "const": "full_round_complete" }
          }
        }
      }
    },
    "historicalBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "meaning", "mainReadOnlyAfterCommit"],
      "properties": {
        "commit": { "const": "a790b3a2d152701e75171cb4dfdeeda52e7bfbd5" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "meaning": { "const": "original Track 0L bootstrap and actual starting commit for the original 13 tracks" },
        "mainReadOnlyAfterCommit": { "const": true }
      }
    },
    "effectiveContractRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "kind", "parentCommit", "resolvedFullCommitCommand", "requiredBeforeAffectedTrackResume"],
      "properties": {
        "token": { "const": "SELF" },
        "kind": { "const": "runtime_erratum_plus_l3_book_lab" },
        "parentCommit": { "const": "f09f0ce9b622a6fcad0c05614bbe06b229ffb572" },
        "resolvedFullCommitCommand": { "const": "git log -1 --format=%H -- FREEZE-MANIFEST.json" },
        "requiredBeforeAffectedTrackResume": { "const": true }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historical", "revision", "unresolvedSeverity"],
      "properties": {
        "historical": {
          "type": "object",
          "additionalProperties": false,
          "required": ["C2", "C3-contract"],
          "properties": {
            "C2": { "$ref": "#/$defs/passReceipt" },
            "C3-contract": { "$ref": "#/$defs/passReceipt" }
          }
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["Codex-C2", "Claude-Desktop-C3", "authoritativeCopy"],
          "properties": {
            "Codex-C2": { "$ref": "#/$defs/passReceipt" },
            "Claude-Desktop-C3": { "$ref": "#/$defs/passReceipt" },
            "authoritativeCopy": { "const": "contracts/source/C3-CONTRACT-REVISION-ACCEPTANCE.md" }
          }
        },
        "unresolvedSeverity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p0", "p1", "p2", "postLocalDebt"],
          "properties": {
            "p0": { "const": 0 },
            "p1": { "const": 0 },
            "p2": { "type": "integer", "minimum": 0 },
            "postLocalDebt": {
              "type": "array",
              "items": { "$ref": "#/$defs/postLocalDebt" }
            }
          }
        }
      }
    },
    "controllerDeclarations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controllerDeclaredC4FreezeComplete",
        "controllerIndependentReadback",
        "candidateStatus",
        "candidateDoesNotSelfDeclareC4Complete",
        "noDeployPublishCloudWrite"
      ],
      "properties": {
        "controllerDeclaredC4FreezeComplete": { "const": true },
        "controllerIndependentReadback": { "const": "PASS" },
        "candidateStatus": { "const": "accepted_by_controller" },
        "candidateDoesNotSelfDeclareC4Complete": { "const": true },
        "noDeployPublishCloudWrite": { "const": true }
      }
    },
    "contractMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "bookLab", "aggregate", "generatedContractIndex"],
      "properties": {
        "core": { "$ref": "#/$defs/coreMetrics" },
        "bookLab": { "$ref": "#/$defs/bookMetrics" },
        "aggregate": { "$ref": "#/$defs/aggregateMetrics" },
        "generatedContractIndex": { "$ref": "#/$defs/fileAnchor" }
      }
    },
    "frozenContracts": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/copyEntry" }
    },
    "authorityEvidenceCopies": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/copyEntry" }
    },
    "visualEvidenceCopies": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/copyEntry" }
    },
    "rootLockfile": { "$ref": "#/$defs/fileAnchor" },
    "sourceManifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractSourceManifest", "historicalFingerprintBaseline", "safeImportInventory", "verifier"],
      "properties": {
        "contractSourceManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativePath", "sha256", "fileCount", "frozenSemanticContractCount", "authorityEvidenceCount", "visualEvidenceCount"],
          "properties": {
            "relativePath": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "fileCount": { "const": 32 },
            "frozenSemanticContractCount": { "const": 13 },
            "authorityEvidenceCount": { "const": 12 },
            "visualEvidenceCount": { "const": 7 }
          }
        },
        "historicalFingerprintBaseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativePath", "sha256", "scopes"],
          "properties": {
            "relativePath": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "scopes": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "expectedCount", "expectedAggregateSha256"],
                "properties": {
                  "id": { "enum": ["formal_web", "recovered_source", "recovered_backend"] },
                  "expectedCount": { "type": "integer", "minimum": 1 },
                  "expectedAggregateSha256": { "$ref": "#/$defs/sha256" }
                }
              }
            }
          }
        },
        "safeImportInventory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativePath", "sha256", "summary"],
          "properties": {
            "relativePath": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "required": ["included", "excluded", "total"],
              "properties": {
                "included": { "const": 357 },
                "excluded": { "const": 178 },
                "total": { "const": 535 }
              }
            }
          }
        },
        "verifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativePath", "sha256", "requiredTerminator"],
          "properties": {
            "relativePath": { "$ref": "#/$defs/relativePath" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "requiredTerminator": { "const": "C4_SOURCE_MANIFEST_OK" }
          }
        }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "fileAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256"],
      "properties": {
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "copyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath",
        "sourceAbsolutePath",
        "sourceSha256",
        "authoritativeCopy",
        "copySha256",
        "bytes",
        "mode",
        "authorityRole",
        "status"
      ],
      "properties": {
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "sourceAbsolutePath": { "type": "string", "pattern": "^/Users/max/" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "authoritativeCopy": { "type": "string", "pattern": "^contracts/source/" },
        "copySha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "mode": { "type": "string", "pattern": "^-rw-------$|^-rw-r--r--$" },
        "authorityRole": { "type": "string", "minLength": 1 },
        "status": { "const": "byte_exact_authoritative_copy" }
      }
    },
    "passReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "p0", "p1", "p2", "sha256", "authoritativeCopy"],
      "properties": {
        "status": { "const": "PASS" },
        "p0": { "const": 0 },
        "p1": { "const": 0 },
        "p2": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "authoritativeCopy": { "type": "string", "pattern": "^contracts/source/" },
        "finalGate": { "type": "string", "minLength": 1 }
      }
    },
    "postLocalDebt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "classification", "disposition", "doesNotAffect"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "classification": { "const": "non_blocking_governance_or_quality" },
        "disposition": { "const": "post_local_operable" },
        "doesNotAffect": {
          "const": ["authorization", "privacy", "data_consistency", "real_integration_seam"]
        }
      }
    },
    "coreMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "actionSourceReferenceChecks", "stringPhasePairs", "canonicalHttpMutationUniqueEndpoints", "coverageMutationUniqueEndpoints", "versionCasDictionaryFields", "technicalOperationEntries", "internalOperationEntries"],
      "properties": {
        "actions": { "const": 90 },
        "actionSourceReferenceChecks": { "const": 360 },
        "stringPhasePairs": { "const": 810 },
        "canonicalHttpMutationUniqueEndpoints": { "const": 59 },
        "coverageMutationUniqueEndpoints": { "const": 59 },
        "versionCasDictionaryFields": { "const": 47 },
        "technicalOperationEntries": { "const": 8 },
        "internalOperationEntries": { "const": 2 }
      }
    },
    "bookMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "actionSourceReferenceChecks", "stringPhasePairs", "canonicalHttpMutationUniqueEndpoints", "coverageMutationUniqueEndpoints", "versionCasDictionaryFields", "technicalOperationEntries", "internalOperationEntries", "stateMachineEntries"],
      "properties": {
        "actions": { "const": 20 },
        "actionSourceReferenceChecks": { "const": 80 },
        "stringPhasePairs": { "const": 180 },
        "canonicalHttpMutationUniqueEndpoints": { "const": 15 },
        "coverageMutationUniqueEndpoints": { "const": 15 },
        "versionCasDictionaryFields": { "const": 8 },
        "technicalOperationEntries": { "const": 0 },
        "internalOperationEntries": { "const": 2 },
        "stateMachineEntries": { "const": 5 }
      }
    },
    "aggregateMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "actionSourceReferenceChecks", "stringPhasePairs", "canonicalHttpMutationUniqueEndpoints", "coverageMutationUniqueEndpoints", "versionCasDictionaryFields", "technicalOperationEntries", "internalOperationEntries"],
      "properties": {
        "actions": { "const": 110 },
        "actionSourceReferenceChecks": { "const": 440 },
        "stringPhasePairs": { "const": 990 },
        "canonicalHttpMutationUniqueEndpoints": { "const": 74 },
        "coverageMutationUniqueEndpoints": { "const": 74 },
        "versionCasDictionaryFields": { "const": 55 },
        "technicalOperationEntries": { "const": 8 },
        "internalOperationEntries": { "const": 4 }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "branch", "worktreeAbsolutePath", "lifecycle", "base", "requiredEffectiveRevision", "startGate", "readOnlyDependencies", "writePaths", "conditionalWritePaths", "evidencePaths", "handoffCondition", "writeRestrictions"],
      "properties": {
        "id": { "enum": ["0L", "1A", "2", "3A", "4", "6A", "1B", "3B", "5", "6B", "7", "R-C", "R-D", "8A", "8B", "8C"] },
        "branch": { "type": "string", "minLength": 1 },
        "worktreeAbsolutePath": { "type": "string", "pattern": "^/Users/max/code/unseen(?:-worktrees/[^/]+)?$" },
        "lifecycle": { "enum": ["existing", "planned_not_created"] },
        "base": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "commit"],
              "properties": {
                "kind": { "const": "historical_bootstrap" },
                "commit": { "const": "a790b3a2d152701e75171cb4dfdeeda52e7bfbd5" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "requiredGate"],
              "properties": {
                "kind": { "const": "effective_revision_gate" },
                "requiredGate": { "const": "effective_revision_frozen" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "sourceTrack", "requiredGate"],
              "properties": {
                "kind": { "const": "future_fixed_gate" },
                "sourceTrack": { "const": "5" },
                "requiredGate": { "const": "fixed_core_rc" }
              }
            }
          ]
        },
        "requiredEffectiveRevision": { "const": "SELF" },
        "startGate": { "type": "string", "minLength": 1 },
        "readOnlyDependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "writePaths": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
        "conditionalWritePaths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "condition"],
            "properties": {
              "path": { "$ref": "#/$defs/relativePath" },
              "condition": { "enum": ["all_other_writers_stopped", "fixed_core_rc_and_prior_owner_stopped"] }
            }
          }
        },
        "evidencePaths": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
        "handoffCondition": { "type": "string", "minLength": 1 },
        "writeRestrictions": { "type": "string", "minLength": 1 }
      }
    }
  }
}
