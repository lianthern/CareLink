# Non-secret template for the MiniMax private-ai worker's systemd EnvironmentFile.
# `ops/server/enable-minimax-worker.sh` generates the real file (with the MiniMax API key filled in from stdin)
# at /etc/unseen/minimax-worker.env, mode 0600 — do not hand-copy this example onto a server with real values
# appended by hand; use the enable script so the key is never written by a shell that echoes it.
#
# This example is intentionally left DISABLED and otherwise fully populated, matching the same convention as
# infra/integration/mac-codex-private-worker/config.example.json: "disabled" means administratively off, not
# "unconfigured" — loadWorkerConfig() in worker.mjs validates every field below even when the switch is false.

UNSEEN_MINIMAX_WORKER_ENABLED=false

# services/api's private-ai wire endpoint (the same origin/hostname the Mac Codex worker talks to).
UNSEEN_PRIVATE_AI_ORIGIN=https://unseen.maxxam.xyz
UNSEEN_PRIVATE_AI_EXPECTED_HOSTNAME=unseen.maxxam.xyz
UNSEEN_PRIVATE_AI_TLS_MODE=system-ca

# Absolute path to the shared private-ai wire bearer token (see README "Server enablement checklist" step 3).
# Must already exist, mode 0400 or 0600, before this worker can start — this is NOT the MiniMax API key.
UNSEEN_PRIVATE_AI_WORKER_TOKEN_FILE=/etc/unseen/minimax-worker/private-ai.token

# The MiniMax API key itself is never placed in this example file — see UNSEEN_MINIMAX_API_KEY /
# UNSEEN_MINIMAX_KEY_FILE in the README's configuration table. The enable script writes it directly into the
# real 0600 env file from stdin.

UNSEEN_MINIMAX_BASE_URL=https://api.minimaxi.com
UNSEEN_MINIMAX_VISION_MODEL=MiniMax-M3
UNSEEN_MINIMAX_REQUEST_TIMEOUT_MS=20000
UNSEEN_MINIMAX_TEMPERATURE=0.6
UNSEEN_MINIMAX_MAX_TOKENS=400
UNSEEN_MINIMAX_WORKER_HTTP_TIMEOUT_MS=15000

UNSEEN_PRIVATE_AI_MIN_LEASE_REMAINING_MS=60000
UNSEEN_PRIVATE_AI_CLEANUP_BUDGET_MS=5000
UNSEEN_PRIVATE_AI_MAX_PIXELS=16777216

# The matching server-side configuration (set on the services/api process, NOT here) must be:
#   UNSEEN_PRIVATE_AI_WORKER_ENABLED=true
#   UNSEEN_PRIVATE_AI_WORKER_TOKEN_HASH_FILE=<sha256 of the same raw token, in its own 0400/0600 file>
#   UNSEEN_PRIVATE_AI_PROMPT_HASH=93fc66f5d385ccba16eb2688c61619d42d9bee699d1c626fd71cff831b90fd43
#   UNSEEN_PRIVATE_AI_POLICY_HASH=8e853583c4bc0bbc287a5aecad2f3a4d90c1b0a100b519f16242887e23f97079
#   UNSEEN_PRIVATE_AI_MODEL=MiniMax-M3
#   UNSEEN_PRIVATE_AI_MODEL_VERSION=minimax-private-worker/1/MiniMax-M3
# The prompt/policy hashes are this worker's own pinned constants (MINIMAX_WORKER_VISION_PROMPT_HASH /
# MINIMAX_WORKER_VISION_POLICY_HASH in minimax-vision-analyzer.mjs) — deliberately different from the Codex
# worker's, since the prompt text itself is different. Re-derive and update both lines above if
# UNSEEN_MINIMAX_VISION_MODEL is changed from MiniMax-M3, or if minimax-vision-analyzer.mjs's prompt text ever
# changes.
