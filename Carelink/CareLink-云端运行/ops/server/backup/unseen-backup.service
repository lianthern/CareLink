[Unit]
Description=UNSEEN daily backup (sqlite snapshot + media/config archive + encrypted secrets bundle), then offsite upload to Tencent COS
Documentation=file:///opt/unseen/backup/README.md
After=network-online.target
Wants=network-online.target

[Service]
# No Restart= directive on purpose: this is a oneshot that either completes or fails visibly. The
# next scheduled run (see unseen-backup.timer) will simply try again the next day — a backup that
# half-runs and silently auto-retries is harder to reason about than one that fails loudly once
# per day until someone looks.
Type=oneshot
User=root
Group=root
# Deliberately NOT under /opt/unseen/releases/<commit> — see the report for why this subsystem is
# installed to a stable path instead of being pinned to a specific, eventually-cleaned-up release
# directory the way the application units are.
WorkingDirectory=/opt/unseen/backup
ExecStart=/opt/unseen/backup/backup.sh
ExecStart=/opt/unseen/backup/upload-to-cos.sh
TimeoutStartSec=900
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
# ProtectSystem=strict (back to the original setting — read on for why it left and why it's
# back). `strict` mounts the ENTIRE filesystem read-only except for API filesystems (/dev, /proc,
# /sys) and the paths listed in ReadWritePaths=/ReadOnlyPaths=/etc; each such path gets bind-
# mounted as its OWN, separate mount point.
#
# History, so nobody has to re-derive this from the git log:
#   1. This unit originally ran `ProtectSystem=strict` + `ReadWritePaths=/var/backups/unseen`.
#      backup.sh's media sync at the time used `cp -al` to HARD-LINK media/ into the backup tree
#      (recursive hard-link copy, not a byte copy). Under strict, `link()` returns EXDEV between
#      backup_root (its own ReadWritePaths= bind mount) and the live data dir (either not writable
#      at all, or another separate bind mount) even though both paths are on the exact same disk
#      underneath — that check is purely about mount topology, not the underlying block device.
#      Diagnosing this cost real time in production because the two paths reported the identical
#      device number (64770) and a root shell OUTSIDE the unit's mount namespace hard-linked them
#      fine — the failure was specific to running under systemd's bind-mount sandboxing.
#   2. The fix that shipped for that: `ProtectSystem=full` (does not bind-mount /var at all, so no
#      artificial mount boundary between backup_root and the data dir) with `ReadWritePaths=`
#      removed entirely (adding the data dir there too was tried and made it WORSE — a second,
#      independent bind mount instead of one). Measured on the server (23 real media files,
#      compared by inode): strict + ReadWritePaths = 0/23 became real hard links; full, no
#      ReadWritePaths = 23/23 became real hard links. This "worked" but only because it was
#      chasing a hard-link-specific mount-topology problem.
#   3. That whole approach was the wrong fix. `cp -al` hard-linking media/ against the LIVE media
#      directory is exactly what filesystem-media-store.mjs:22 exists to reject — it asserts every
#      media object file has `nlink === 1`, and a hard link from the backup tree pushes that to 2+.
#      This is not a mount-topology bug to work around; it is a correctness bug. It shipped anyway
#      and the next scheduled run flipped nlink to 2+ on every live media file, and every media
#      read in production returned 503 media_store_permissions_invalid — site-wide, for every
#      photo, in every space — until someone deleted the hard-linked copies out of the backup tree.
#      See the DO-NOT-HARD-LINK warning above sync_media() in backup.sh for the full story.
#   4. backup.sh's media sync is now `cp -a` — a real byte copy, never a hard link, against ANY
#      target, live media or otherwise. There is therefore no `link()` call anywhere in this
#      pipeline anymore, so the strict-vs-full bind-mount/EXDEV distinction from steps 1–2 no
#      longer applies to anything this unit does — `cp -a` copies bytes identically whether the
#      two paths are on the same filesystem, different filesystems, or split across bind-mount
#      boundaries. `ProtectSystem=full` was only ever justified by the hard-link workaround; now
#      that the workaround's own root cause (hard-linking live media) is deleted, keeping `full`
#      would just be leaving a real security downgrade (the whole filesystem read-write instead of
#      read-only-by-default) in place for no remaining benefit. Restored to `strict` +
#      `ReadWritePaths=/var/backups/unseen` (the only path this unit ever legitimately writes to)
#      accordingly.
#
# If anyone in the future is tempted to reach for `cp -al` / hard links again for speed or disk
# reasons: don't. It is not a mount-topology problem to route around a second time — it directly
# violates services/api/src/ports/media/filesystem-media-store.mjs:22's nlink===1 invariant and
# WILL take down photo reads in production again. See backup.sh's sync_media() comment.
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
ReadWritePaths=/var/backups/unseen
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unseen-backup

[Install]
WantedBy=multi-user.target
