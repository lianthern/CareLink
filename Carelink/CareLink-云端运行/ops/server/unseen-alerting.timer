[Unit]
Description=Run UNSEEN server alerting check (unseen-alerting.service) every ~2 minutes

[Timer]
# Runs shortly after boot, then every 2 minutes on a monotonic clock (not wall-clock OnCalendar,
# so it isn't sensitive to timezone/DST edge cases the way unseen-backup.timer's daily
# OnCalendar deliberately is -- this one just needs a steady short cadence).
OnBootSec=1min
OnUnitActiveSec=2min
AccuracySec=15s
Unit=unseen-alerting.service

[Install]
WantedBy=timers.target
