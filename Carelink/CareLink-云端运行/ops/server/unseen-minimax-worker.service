[Unit]
Description=UNSEEN MiniMax private-ai pull worker (photo_visible_facts_question_v1)
Documentation=file:///opt/unseen/current/infra/integration/minimax-private-worker/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unseen
Group=unseen
# The release-commit placeholder below must be replaced with the exact release checkout this unit runs against,
# matching the convention in ops/release/unseen.service.example — never point this at a moving "current" alias.
WorkingDirectory=/opt/unseen/releases/REQUIRED_IMMUTABLE_RELEASE_COMMIT
EnvironmentFile=/etc/unseen/minimax-worker.env
UnsetEnvironment=NODE_OPTIONS NODE_PATH PATH LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT LD_DEBUG LD_DEBUG_OUTPUT LD_PROFILE GCONV_PATH BASH_ENV ENV PYTHONPATH PYTHONHOME PERL5OPT RUBYOPT OPENSSL_CONF OPENSSL_MODULES SSLKEYLOGFILE
ExecStart=/usr/local/bin/node infra/integration/minimax-private-worker/worker.mjs
Restart=always
RestartSec=5s
# Give an in-flight lease/MiniMax/complete cycle time to finish gracefully (see worker.mjs `runWorkerLoop`'s
# "finish in-flight work, then stop" SIGTERM handling) before systemd escalates to SIGKILL.
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
# MemoryMax was already set (256M vs an observed RSS of ~50-57MB, i.e. already >4x headroom) —
# left unchanged. MemoryHigh is new: a soft throttle well below the existing hard cap, standard
# practice for pairing the two, with no change to what can trigger an actual kill.
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
LimitNOFILE=1024
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=unseen-minimax-worker

[Install]
WantedBy=multi-user.target
