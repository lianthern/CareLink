/* UNSEEN upload-first 小程序全局视觉基线。 */
page {
  --u-shell: #F4EEF0;
  --u-bg: #FFF9F7;
  --u-card: #FFFCFB;
  --u-ink: #59383E;
  --u-muted: #765A60;
  --u-pink: #F8C8D6;
  --u-orange: #FDE0A8;
  --u-active: #FF7F9F;
  --u-danger: #B6465D;
  --u-line: rgba(89, 56, 62, 0.11);
  --u-grad: linear-gradient(100deg, #F8C8D6, #FDE0A8);
  --u-shadow: 0 14rpx 42rpx rgba(89, 56, 62, 0.08);
  --u-radius: 32rpx;
  --u-pill: 999rpx;
  min-height: 100%;
  background: var(--u-bg);
  color: var(--u-ink);
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", sans-serif;
  font-size: 32rpx;
  -webkit-font-smoothing: antialiased;
}

view, text, button, image, input, textarea, scroll-view {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  font: inherit;
  line-height: normal;
  color: inherit;
  background: none;
}

button::after { border: 0; }

.page-shell {
  min-height: 100vh;
  background: var(--u-bg);
}

.native-nav {
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr) 72rpx;
  align-items: center;
  padding: 0 24rpx;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  font-size: 50rpx;
}

.nav-title {
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 29rpx;
  font-weight: 650;
}

.nav-spacer { width: 72rpx; }

.primary-button {
  min-height: 104rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: var(--u-grad);
  box-shadow: 0 14rpx 32rpx rgba(255, 127, 159, 0.18);
  color: var(--u-ink);
  font-size: 30rpx;
  font-weight: 700;
}

.primary-button[disabled] { opacity: 0.52; }

.secondary-button {
  min-height: 92rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--u-line);
  border-radius: 26rpx;
  background: var(--u-card);
  color: var(--u-ink);
  font-size: 28rpx;
  font-weight: 650;
}

.card {
  border: 2rpx solid var(--u-line);
  border-radius: var(--u-radius);
  background: var(--u-card);
  box-shadow: var(--u-shadow);
}

.empty-state {
  padding: 54rpx 36rpx;
  text-align: center;
  color: var(--u-muted);
  font-size: 27rpx;
  line-height: 1.7;
}

.notice {
  padding: 20rpx 24rpx;
  border: 2rpx solid rgba(255, 127, 159, 0.18);
  border-radius: 22rpx;
  background: rgba(248, 200, 214, 0.22);
  color: var(--u-muted);
  font-size: 24rpx;
  line-height: 1.55;
}
