<view class="page-shell detail-page" style="padding-top:{{navBarTop}}px">
  <view class="native-nav" style="height:{{navBarHeight}}px">
    <button class="nav-back" bindtap="onBack" aria-label="返回">‹</button>
    <text class="nav-title">记忆空间</text>
    <view class="nav-spacer"></view>
  </view>

  <view class="detail-main">
    <view wx:if="{{loading}}" class="card empty-state">正在打开空间…</view>
    <view wx:elif="{{loadError}}" class="card empty-state">
      <text>{{loadError}}</text>
      <button class="secondary-button retry" bindtap="onRetry">重新加载</button>
    </view>

    <block wx:else>
      <view class="space-heading">
        <view class="heading-row">
          <text class="eyebrow">MEMORY SPACE</text>
          <text class="local-badge" wx:if="{{localOnly}}">本机保存</text>
          <text class="cloud-badge" wx:else>云端空间</text>
        </view>
        <text class="heading">{{space.title}}</text>
        <text class="space-date" wx:if="{{metaLine}}">{{metaLine}}</text>
      </view>

      <button class="panorama-card card" wx:if="{{space.panorama}}" bindtap="onPanorama">
        <image class="panorama-image" src="{{space.panorama.thumbSrc || space.panorama.src}}" mode="aspectFill" />
        <view class="panorama-overlay">
          <view>
            <text class="panorama-kicker">EXTERNAL PANORAMA</text>
            <text class="panorama-title">查看 2:1 成品全景</text>
          </view>
          <text class="panorama-arrow">›</text>
        </view>
      </button>
      <view wx:else class="no-panorama card">
        <text class="no-panorama-title">这个空间没有成品全景</text>
        <text class="no-panorama-copy">普通照片上传与时间轴不受影响。UNSEEN 当前不提供拍摄或拼接。</text>
      </view>

      <view class="stats card">
        <view class="stat"><text class="stat-value">{{photoCount}}</text><text class="stat-label">张照片</text></view>
        <view class="stat-divider"></view>
        <view class="stat"><text class="stat-value">2:1</text><text class="stat-label">成品全景规范</text></view>
      </view>

      <button class="primary-button" bindtap="onUploadPhotos">从相册上传照片</button>
      <button class="share-button" wx:if="{{canShare}}" open-type="share">分享给微信好友</button>
      <button class="secondary-button timeline-button" bindtap="onTimeline">查看照片时间轴</button>

      <view class="notice" wx:if="{{localOnly}}">这是仅保存在本机的空间，不能分享给好友；照片与全景图也不会同步到其他手机。</view>
      <view class="notice" wx:else><text wx:if="{{offline}}">当前显示的是本机历史快照；联网后可刷新和上传。 </text>云端照片只有完成上传并登记后才会出现在时间轴，失败会保留重试项。<text wx:if="{{pendingCount}}"> 当前还有 {{pendingCount}} 份旧版投稿等待主办方确认。</text></view>
    </block>
  </view>
</view>
