.detail-page { background: linear-gradient(160deg, var(--u-bg), #FFF5F1); }
.detail-main { padding: 30rpx 30rpx 76rpx; }
.retry { margin-top: 24rpx; width: 260rpx; }
.space-heading { padding: 20rpx 4rpx 28rpx; }
.heading-row { display: flex; align-items: center; justify-content: space-between; }
.eyebrow { color: var(--u-active); font-size: 20rpx; font-weight: 760; letter-spacing: .18em; }
.local-badge, .cloud-badge { padding: 7rpx 16rpx; border-radius: var(--u-pill); font-size: 20rpx; }
.local-badge { background: rgba(248,200,214,.28); color: var(--u-active); }
.cloud-badge { background: rgba(253,224,168,.34); color: #9B6A24; }
.heading { display: block; margin-top: 18rpx; font-size: 50rpx; line-height: 1.2; font-weight: 760; }
.space-date { display: block; margin-top: 12rpx; color: var(--u-muted); font-size: 25rpx; }
.panorama-card { width: 100%; height: 330rpx; position: relative; overflow: hidden; text-align: left; }
.panorama-image { width: 100%; height: 100%; }
.panorama-overlay { position: absolute; inset: auto 0 0; padding: 60rpx 28rpx 26rpx; display: flex; align-items: flex-end; justify-content: space-between; background: linear-gradient(transparent, rgba(44,24,28,.72)); color: #FFF; }
.panorama-kicker { display: block; font-size: 20rpx; font-weight: 750; letter-spacing: .14em; opacity: .9; }
.panorama-title { display: block; margin-top: 7rpx; font-size: 29rpx; font-weight: 700; }
.panorama-arrow { font-size: 52rpx; }
.no-panorama { padding: 34rpx; }
.no-panorama-title { display: block; font-size: 29rpx; font-weight: 700; }
.no-panorama-copy { display: block; margin-top: 12rpx; color: var(--u-muted); font-size: 24rpx; line-height: 1.6; }
.stats { margin: 22rpx 0; padding: 26rpx 10rpx; display: grid; grid-template-columns: 1fr 2rpx 1fr; align-items: center; }
.stat { display: flex; flex-direction: column; align-items: center; gap: 5rpx; }
.stat-value { font-size: 37rpx; font-weight: 760; }
.stat-label { color: var(--u-muted); font-size: 23rpx; }
.stat-divider { width: 2rpx; height: 54rpx; background: var(--u-line); }
.timeline-button { margin-top: 16rpx; }
.share-button { margin-top: 16rpx; min-height: 92rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(255,127,159,.3); border-radius: 24rpx; background: rgba(248,200,214,.18); color: var(--u-ink); font-size: 27rpx; font-weight: 680; }
.notice { margin-top: 24rpx; }
