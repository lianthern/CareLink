.detail-page{width:100%;min-height:100vh;background:radial-gradient(circle at 88% 5%,rgba(253,224,168,.42),transparent 26%),var(--u-bg);overflow-x:hidden}.detail-nav{padding-left:24rpx;padding-right:24rpx}.detail-main{padding:30rpx 40rpx 100rpx}.detail-hero{position:relative;overflow:hidden;padding:48rpx 42rpx;border-radius:50rpx;background:linear-gradient(135deg,#f7c8d6,#fce0b3 66%,#f5eee5);box-shadow:var(--u-shadow)}.detail-eyebrow,.detail-accent,.detail-title,.detail-lead{display:block}.detail-eyebrow{color:rgba(89,56,62,.72);font-size:20rpx;font-weight:850;letter-spacing:.12em}.detail-accent{position:absolute;right:-8rpx;top:22rpx;color:rgba(255,255,255,.5);font-size:112rpx;line-height:1;font-weight:900;letter-spacing:-.08em}.detail-title{position:relative;max-width:11em;margin-top:64rpx;font-size:56rpx;line-height:1.13;font-weight:800;letter-spacing:-.04em}.detail-lead{position:relative;margin-top:24rpx;color:rgba(89,56,62,.76);font-size:25rpx;line-height:1.7}.detail-sections{margin-top:24rpx;display:flex;flex-direction:column;gap:14rpx}.detail-section{padding:28rpx;border:2rpx solid var(--u-line);border-radius:32rpx;display:grid;grid-template-columns:66rpx minmax(0,1fr);gap:18rpx;background:#fffdfc}.detail-number{color:var(--u-active);font-size:20rpx;font-weight:850;letter-spacing:.08em}.detail-section view text{display:block}.detail-section view text:first-child{font-size:28rpx;font-weight:780}.detail-section view text:last-child{margin-top:9rpx;color:var(--u-muted);font-size:22rpx;line-height:1.62}.detail-action{width:100%;min-height:96rpx;margin-top:26rpx;border-radius:28rpx;display:flex;align-items:center;justify-content:center;gap:14rpx;background:#493439;color:white;font-size:25rpx;font-weight:760}.detail-action text{font-size:32rpx}.detail-note{margin-top:18rpx;text-align:center;color:var(--u-muted);font-size:19rpx}
