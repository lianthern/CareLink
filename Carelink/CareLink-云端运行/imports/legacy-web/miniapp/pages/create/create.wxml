<view class="page-shell create-page" style="padding-top:{{navBarTop}}px">
  <view class="native-nav" style="height:{{navBarHeight}}px">
    <button class="nav-back" bindtap="onBack" aria-label="返回">‹</button>
    <text class="nav-title">创建记忆空间</text>
    <view class="nav-spacer"></view>
  </view>

  <view class="create-main">
    <view>
      <text class="eyebrow">NEW MEMORY SPACE</text>
      <text class="heading">从一个名字开始</text>
      <text class="lead">默认创建可分享的云端空间，之后即可邀请朋友从相册补充照片。成品全景完全可选。</text>
    </view>

    <view class="form-card card">
      <text class="field-label">空间名称 *</text>
      <input class="field-input" maxlength="32" value="{{title}}" bindinput="onTitleInput" placeholder="例如：毕业展的那个下午" placeholder-class="input-placeholder" disabled="{{submitting}}" />
      <text class="field-label field-label--next">场景</text>
      <picker mode="selector" range="{{sceneOptions}}" value="{{sceneIndex}}" bindchange="onSceneChange" disabled="{{submitting}}">
        <view class="field-input picker-value">{{sceneOptions[sceneIndex]}}</view>
      </picker>
      <text class="field-label field-label--next">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange" disabled="{{submitting}}">
        <view class="field-input picker-value {{date ? '' : 'picker-placeholder'}}">{{date || '选择日期（可选）'}}</view>
      </picker>
      <text class="field-label field-label--next">地点</text>
      <input class="field-input" maxlength="80" value="{{place}}" bindinput="onPlaceInput" placeholder="例如：布里斯班河畔（可选）" placeholder-class="input-placeholder" disabled="{{submitting}}" />
    </view>

    <view class="pano-card card">
      <view class="pano-head">
        <view class="pano-copy">
          <text class="pano-title">外部成品 2:1 全景</text>
          <text class="pano-sub">可选 · JPEG / PNG / WebP · 最大 50 MB</text>
        </view>
        <text class="optional">可选</text>
      </view>
      <block wx:if="{{panorama}}">
        <image class="pano-preview" src="{{panorama.tempFilePath}}" mode="aspectFill" />
        <view class="pano-meta-row">
          <text>{{panorama.width}}×{{panorama.height}} · {{panorama.sizeText}}</text>
          <button class="remove-link" bindtap="onRemovePanorama" disabled="{{submitting}}">移除</button>
        </view>
      </block>
      <button wx:else class="choose-pano" bindtap="onChoosePanorama" loading="{{panoramaChecking}}" disabled="{{submitting || panoramaChecking}}">{{panoramaChecking ? '正在校验全景…' : '从相册选择成品全景'}}</button>
      <text class="field-error" wx:if="{{panoramaError}}">{{panoramaError}}</text>
      <text class="pano-rule">UNSEEN 当前不提供全景拍摄或自动拼接。全景必须至少 1600×800，宽高比在 1.90–2.10 之间；HEIC/HEIF 不支持。</text>
    </view>

    <view class="notice">云端空间可以分享给微信好友。主办方凭证只保存在本机，不会写入邀请链接；删除本机记录不会删除云端内容。</view>
    <view class="cloud-error" wx:if="{{cloudError}}">
      <text>{{cloudError}}</text>
      <text class="cloud-error-note">表单和已选择的全景图都还在，可以直接重试；系统不会悄悄改存为本机空间。</text>
    </view>
    <button class="primary-button submit" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting || panoramaChecking}}">{{submitting ? submitStage : panoramaChecking ? '正在校验图片…' : '创建云端共享空间'}}</button>
    <button class="secondary-button local-submit" bindtap="onSaveLocal" disabled="{{submitting || panoramaChecking}}">仅保存在本机</button>
    <text class="local-help">本机空间只在这台手机可见，不能分享给好友。</text>
  </view>
</view>
