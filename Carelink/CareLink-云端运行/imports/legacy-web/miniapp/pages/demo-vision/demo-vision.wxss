.vision-page { width: 100%; overflow-x: hidden; background: var(--u-bg); }
.vision-nav { padding-left: 24rpx; padding-right: 24rpx; }
.vision-cover { height: 560rpx; overflow: hidden; position: relative; background: #201619; }
.vision-cover > image { width: 100%; height: 100%; }
.vision-cover-shade { position: absolute; inset: 28% 0 0; background: linear-gradient(transparent, rgba(24,11,15,.84)); }
.vision-badge { position: absolute; top: 34rpx; left: 40rpx; padding: 14rpx 20rpx; border: 2rpx solid rgba(255,255,255,.3); border-radius: 999rpx; background: rgba(23,12,15,.36); color: white; font-size: 19rpx; font-weight: 800; letter-spacing: .12em; }
.vision-cover-copy { position: absolute; z-index: 2; left: 40rpx; right: 40rpx; bottom: 40rpx; color: white; }
.vision-cover-copy text { display: block; color: rgba(255,255,255,.74); font-size: 23rpx; line-height: 1.45; }
.vision-cover-copy .vision-cover-title { margin: 4rpx 0 6rpx; color: white; font-size: 58rpx; line-height: 1.15; font-weight: 760; }
.vision-tabs { position: sticky; z-index: 12; top: 0; padding: 18rpx 24rpx; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10rpx; border-bottom: 2rpx solid var(--u-line); background: rgba(255,249,247,.96); }
.vision-tab { min-width: 0; padding: 18rpx 4rpx; border-radius: 20rpx; color: var(--u-muted); text-align: center; font-size: 23rpx; font-weight: 700; }
.vision-tab--active { background: var(--u-grad); color: var(--u-ink); }
.vision-panel { padding: 42rpx 40rpx 20rpx; }
.vision-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }
.vision-head > view { min-width: 0; }
.vision-kicker,.vision-heading { display: block; }
.vision-kicker { color: var(--u-active); font-size: 21rpx; font-weight: 800; letter-spacing: .12em; }
.vision-heading { max-width: 12em; margin-top: 8rpx; font-size: 38rpx; line-height: 1.3; font-weight: 730; }
.vision-status { flex: none; padding: 10rpx 16rpx; border-radius: 999rpx; background: rgba(248,200,214,.24); color: var(--u-muted); font-size: 20rpx; font-weight: 700; }
.vision-stats { margin-top: 28rpx; display: grid; grid-template-columns: repeat(3,1fr); gap: 14rpx; }
.vision-stats view { padding: 24rpx 10rpx; border: 2rpx solid var(--u-line); border-radius: 26rpx; background: white; text-align: center; }
.vision-stats text { display: block; }
.vision-stats text:first-child { font-size: 38rpx; font-weight: 780; }
.vision-stats text:last-child { margin-top: 4rpx; color: var(--u-muted); font-size: 21rpx; }
.vision-live { margin-top: 18rpx; padding: 22rpx; border-radius: 30rpx; display: flex; align-items: center; background: linear-gradient(100deg,rgba(248,200,214,.27),rgba(253,224,168,.28)); }
.vision-avatar { width: 64rpx; height: 64rpx; margin-right: -12rpx; border: 6rpx solid #FFFAF8; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #60424A; color: white; font-size: 20rpx; font-weight: 800; }
.vision-avatar--pink { background: var(--u-active); }.vision-avatar--gold { margin-right: 20rpx; background: #BA8D5F; }
.vision-live view { min-width: 0; }
.vision-live view text { display: block; }
.vision-live view text:first-child { font-size: 24rpx; font-weight: 700; }
.vision-live view text:last-child { margin-top: 2rpx; color: var(--u-muted); font-size: 20rpx; }
.memory-list { margin-top: 20rpx; display: flex; flex-direction: column; gap: 16rpx; }
.memory-card { overflow: hidden; border: 2rpx solid var(--u-line); border-radius: 30rpx; display: grid; grid-template-columns: 210rpx minmax(0,1fr); align-items: center; background: white; }
.memory-card image { width: 210rpx; height: 164rpx; }
.memory-card view { min-width: 0; padding: 20rpx; }
.memory-card text { display: block; }
.memory-card text:first-child { font-size: 25rpx; font-weight: 700; }
.memory-card text:last-child { margin-top: 6rpx; color: var(--u-muted); font-size: 21rpx; line-height: 1.5; }
.vision-next { min-height: 132rpx; margin-top: 20rpx; padding: 24rpx 28rpx; border-radius: 30rpx; display: flex; align-items: center; gap: 18rpx; background: var(--u-grad); }
.vision-next view { min-width: 0; flex: 1; }.vision-next view text { display: block; }.vision-next view text:first-child { font-size: 25rpx; font-weight: 700; }.vision-next view text:last-child { margin-top: 4rpx; color: var(--u-muted); font-size: 21rpx; }
.timeline-grid { margin-top: 28rpx; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14rpx; }
.timeline-card { min-width: 0; height: 330rpx; overflow: hidden; position: relative; border-radius: 30rpx; background: #EDE2E4; }
.timeline-card image { width: 100%; height: 100%; }
.timeline-card::after { content: ""; position: absolute; inset: 44% 0 0; background: linear-gradient(transparent,rgba(18,8,11,.74)); }
.timeline-card view { position: absolute; z-index: 2; left: 22rpx; right: 22rpx; bottom: 20rpx; color: white; }
.timeline-card text { display: block; }.timeline-card text:first-child { font-size: 24rpx; font-weight: 800; }.timeline-card text:last-child { color: rgba(255,255,255,.76); font-size: 20rpx; }
.pano-scroll { height: 440rpx; margin-top: 28rpx; overflow: hidden; border-radius: 34rpx; background: #1A1214; white-space: nowrap; }
.pano-scroll image { width: 1560rpx; height: 440rpx; }
.pano-label { display: table; margin: -62rpx auto 0; padding: 13rpx 20rpx; position: relative; z-index: 2; border-radius: 999rpx; background: rgba(20,10,13,.68); color: white; font-size: 21rpx; font-weight: 700; }
.direction-row { margin-top: 34rpx; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10rpx; }
.direction-row button { min-width: 0; min-height: 76rpx; padding: 8rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid var(--u-line); border-radius: 22rpx; background: white; color: var(--u-muted); font-size: 21rpx; font-weight: 700; }
.direction-row button.active { border-color: var(--u-active); background: rgba(248,200,214,.28); color: var(--u-ink); }
.vision-note { margin-top: 24rpx; padding: 24rpx; border: 2rpx solid var(--u-line); border-radius: 26rpx; background: #FFFAF4; }
.vision-note text { display: block; }.vision-note text:first-child { font-size: 24rpx; font-weight: 750; }.vision-note text:last-child { margin-top: 6rpx; color: var(--u-muted); font-size: 21rpx; line-height: 1.65; }
.pov-stage { height: 520rpx; margin-top: 28rpx; overflow: hidden; position: relative; border-radius: 38rpx; background: #1A1214; }
.pov-stage > image { width: 100%; height: 100%; }
.pov-shade { position: absolute; inset: 48% 0 0; background: linear-gradient(transparent,rgba(18,8,11,.78)); }
.pov-label { position: absolute; z-index: 3; left: 26rpx; bottom: 24rpx; padding: 13rpx 20rpx; border-radius: 999rpx; background: rgba(20,10,13,.68); color: white; font-size: 21rpx; font-weight: 700; }
.pov-radar { width: 142rpx; height: 142rpx; position: absolute; z-index: 3; right: 24rpx; top: 24rpx; border: 2rpx solid rgba(255,255,255,.45); border-radius: 50%; background: rgba(16,9,11,.48); }
.pov-radar::before,.pov-radar::after { content:""; position:absolute; background:rgba(255,255,255,.24); }.pov-radar::before{width:2rpx;top:18rpx;bottom:18rpx;left:50%;}.pov-radar::after{height:2rpx;left:18rpx;right:18rpx;top:50%;}
.pov-radar view { width: 12rpx; height: 12rpx; position: absolute; z-index: 2; border-radius: 50%; background: var(--u-active); }.pov-radar view:nth-child(1){top:12rpx;left:64rpx}.pov-radar view:nth-child(2){right:12rpx;top:64rpx}.pov-radar view:nth-child(3){bottom:12rpx;left:64rpx}.pov-radar view:nth-child(4){left:12rpx;top:64rpx}
.pov-radar text { position: absolute; z-index: 2; inset: 0; display: flex; align-items: center; justify-content: center; color: white; font-size: 20rpx; }
.pov-copy { padding: 26rpx 4rpx 0; }.pov-copy text { display: block; }.pov-copy text:first-child { font-size: 32rpx; font-weight: 750; }.pov-copy text:last-child { margin-top: 7rpx; color: var(--u-muted); font-size: 23rpx; line-height: 1.55; }
.vision-footer { padding: 30rpx 40rpx calc(50rpx + env(safe-area-inset-bottom)); display: flex; align-items: center; justify-content: center; gap: 16rpx; color: var(--u-muted); font-size: 22rpx; }.vision-footer text:first-child,.vision-footer text:last-child { color: var(--u-ink); font-weight: 700; }
