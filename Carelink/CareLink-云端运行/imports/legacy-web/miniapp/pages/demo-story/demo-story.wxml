<view class="page-shell story-page" style="padding-top:{{navBarTop}}px">
  <view class="native-nav story-nav" style="height:{{navBarHeight}}px">
    <view class="nav-back" bindtap="onBack" aria-role="button" aria-label="返回">‹</view>
    <text class="nav-title">六幕产品故事</text>
    <text class="story-counter">0{{current + 1}} / 06</text>
  </view>

  <view class="story-progress"><view style="width:{{(current + 1) * 16.6667}}%"></view></view>
  <swiper class="story-swiper" current="{{current}}" bindchange="onChange" duration="320">
    <swiper-item wx:for="{{slides}}" wx:key="title">
      <scroll-view class="story-scroll" scroll-y>
        <view class="story-content">
          <view class="story-art story-art--{{item.tone}}">
            <image src="{{item.image}}" mode="aspectFill" />
            <view class="story-shade"></view>
            <view class="story-orbit orbit-one"></view><view class="story-orbit orbit-two"></view>
            <view class="story-tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text></view>
          </view>
          <view class="story-copy-block">
            <text class="story-kicker">{{item.kicker}}</text>
            <text class="story-title">{{item.title}}</text>
            <text class="story-copy">{{item.copy}}</text>
            <text class="story-quote">{{item.quote}}</text>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>

  <view class="story-bottom">
    <view class="story-dots"><view class="story-dot {{index === current ? 'story-dot--active' : ''}}" wx:for="{{slides}}" wx:key="title" data-index="{{index}}" bindtap="onDot"></view></view>
    <view class="story-actions"><button class="secondary-button" bindtap="onPrev" disabled="{{current === 0}}">上一幕</button><button class="primary-button" bindtap="onNext">{{nextLabel}} <text>→</text></button></view>
  </view>
</view>
