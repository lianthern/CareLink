.story-page { height: 100vh; overflow: hidden; display: flex; flex-direction: column; background: var(--u-bg); }
.story-nav { padding-left: 24rpx; padding-right: 24rpx; flex: none; }
.story-counter { width: 96rpx; color: var(--u-muted); text-align: right; font-size: 21rpx; font-weight: 800; letter-spacing: .08em; }
.story-progress { height: 8rpx; margin: 8rpx 40rpx 0; overflow: hidden; flex: none; border-radius: 999rpx; background: #F0E5E8; }
.story-progress view { height: 100%; border-radius: inherit; background: var(--u-grad); transition: width .2s ease; }
.story-swiper { min-height: 0; flex: 1; }
.story-scroll { height: 100%; }
.story-content { padding: 24rpx 40rpx 32rpx; }
.story-art { height: 560rpx; overflow: hidden; position: relative; border-radius: 48rpx; background: #211719; box-shadow: var(--u-shadow); }
.story-art image { width: 100%; height: 100%; }
.story-shade { position: absolute; inset: 30% 0 0; background: linear-gradient(transparent, rgba(24,12,15,.76)); }
.story-orbit { position: absolute; border: 3rpx solid rgba(255,255,255,.52); border-radius: 50%; }
.orbit-one { width: 300rpx; height: 300rpx; right: -70rpx; top: -58rpx; }
.orbit-two { width: 180rpx; height: 180rpx; left: -50rpx; bottom: 42rpx; }
.story-tags { position: absolute; z-index: 2; left: 28rpx; right: 28rpx; bottom: 28rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.story-tags text { padding: 11rpx 18rpx; border: 2rpx solid rgba(255,255,255,.32); border-radius: 999rpx; background: rgba(28,15,18,.45); color: white; font-size: 22rpx; font-weight: 700; }
.story-copy-block { padding: 34rpx 4rpx 0; }
.story-kicker,.story-title,.story-copy,.story-quote { display: block; }
.story-kicker { color: var(--u-active); font-size: 23rpx; font-weight: 800; letter-spacing: .08em; }
.story-title { margin-top: 14rpx; max-width: 13em; font-size: 48rpx; line-height: 1.2; font-weight: 760; letter-spacing: -.035em; }
.story-copy { margin-top: 22rpx; color: var(--u-muted); font-size: 26rpx; line-height: 1.75; }
.story-quote { margin-top: 24rpx; padding: 22rpx 24rpx; border-left: 6rpx solid var(--u-active); border-radius: 0 24rpx 24rpx 0; background: rgba(248,200,214,.18); font-size: 25rpx; line-height: 1.55; font-weight: 700; }
.story-bottom { flex: none; padding: 10rpx 40rpx calc(26rpx + env(safe-area-inset-bottom)); border-top: 2rpx solid var(--u-line); background: rgba(255,252,251,.96); }
.story-dots { height: 28rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.story-dot { width: 34rpx; height: 8rpx; border-radius: 999rpx; background: #E8DCDF; }
.story-dot--active { width: 58rpx; background: var(--u-active); }
.story-actions { margin-top: 10rpx; display: grid; grid-template-columns: 210rpx minmax(0,1fr); gap: 16rpx; }
.story-actions .secondary-button,.story-actions .primary-button { min-height: 92rpx; }
.story-actions button[disabled] { opacity: .42; }
@media (max-height: 720px) { .story-art { height: 430rpx; } .story-title { font-size: 42rpx; } }
