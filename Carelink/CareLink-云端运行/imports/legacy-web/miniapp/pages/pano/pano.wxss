.pano-page { min-height: 100vh; background: #21191B; color: #FFF9F7; }
.pano-nav { color: #FFF9F7; }
.pano-nav .nav-back { background: rgba(255,255,255,.1); color: #FFF; }
.pano-main { padding: 24rpx 24rpx 56rpx; }
.pano-heading { padding: 8rpx 8rpx 24rpx; }
.eyebrow { display: block; color: #FFD4DF; font-size: 20rpx; font-weight: 750; letter-spacing: .16em; }
.heading { display: block; margin-top: 14rpx; overflow: hidden; font-size: 38rpx; font-weight: 720; text-overflow: ellipsis; white-space: nowrap; }
.lead { display: block; margin-top: 12rpx; color: rgba(255,249,247,.78); font-size: 24rpx; line-height: 1.55; }
.viewer { width: 100%; height: 720rpx; position: relative; overflow: hidden; border: 2rpx solid rgba(255,255,255,.12); border-radius: 30rpx; background: #090708; }
.movable-image { width: 100%; height: 100%; }
.pano-image { width: 100%; height: 100%; display: block; }
.loading-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: flex; align-items: center; justify-content: center; background: #090708; color: rgba(255,255,255,.7); font-size: 25rpx; }
.viewer-empty { min-height: 520rpx; padding: 60rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 26rpx; border-radius: 30rpx; background: #090708; color: rgba(255,255,255,.7); font-size: 26rpx; text-align: center; }
.retry-button { min-height: 78rpx; padding: 0 28rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: var(--u-grad); color: var(--u-ink); font-size: 25rpx; font-weight: 680; }
.fallback-note { display: block; margin: 14rpx 6rpx 0; color: rgba(255,249,247,.78); font-size: 23rpx; }
.notice { margin-top: 20rpx; border-color: rgba(248,200,214,.28); background: rgba(248,200,214,.1); color: rgba(255,249,247,.78); }
