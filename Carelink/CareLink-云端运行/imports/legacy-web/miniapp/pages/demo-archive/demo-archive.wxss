.archive-page { width: 100%; overflow-x: hidden; background: radial-gradient(circle at 90% 5%,rgba(253,224,168,.36),transparent 25%),var(--u-bg); }
.archive-nav { padding-left: 24rpx; padding-right: 24rpx; }
.archive-main { width: 100%; padding: 30rpx 40rpx 100rpx; }
.archive-hero { padding: 46rpx; border-radius: 52rpx; background: radial-gradient(circle at 88% 16%,rgba(255,255,255,.66) 0 12%,transparent 13%),linear-gradient(132deg,#F7CAD8,#FCE2B6 62%,#F5EDDF); box-shadow: var(--u-shadow); }
.archive-kicker,.archive-title,.archive-copy { display: block; }
.archive-kicker { color: rgba(89,56,62,.72); font-size: 21rpx; font-weight: 800; letter-spacing: .16em; }
.archive-title { max-width: 12em; margin-top: 14rpx; font-size: 54rpx; line-height: 1.16; font-weight: 780; letter-spacing: -.035em; }
.archive-copy { margin-top: 24rpx; color: rgba(89,56,62,.76); font-size: 24rpx; line-height: 1.68; }
.archive-stats { margin-top: 28rpx; display: grid; grid-template-columns: repeat(3,1fr); gap: 10rpx; }
.archive-stats view { padding: 16rpx 8rpx; border-radius: 999rpx; background: rgba(255,252,251,.7); text-align: center; }
.archive-stats text { display: inline; color: var(--u-muted); font-size: 19rpx; }.archive-stats text:first-child { margin-right: 5rpx; color: var(--u-ink); font-size: 25rpx; font-weight: 800; }
.archive-current { margin-top: 24rpx; padding: 26rpx; border: 2rpx solid var(--u-line); border-radius: 34rpx; background: white; }
.archive-current > view:first-child text { display: block; }.archive-current > view:first-child text:first-child { font-size: 28rpx; font-weight: 750; }.archive-current > view:first-child text:last-child { margin-top: 6rpx; color: var(--u-muted); font-size: 22rpx; line-height: 1.52; }
.archive-current-actions { margin-top: 20rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }.archive-current-actions button { min-height: 76rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; background: var(--u-grad); font-size: 23rpx; font-weight: 700; }.archive-current-actions button:last-child { border: 2rpx solid var(--u-line); background: white; }
.ai-feature { margin-top:24rpx; overflow:hidden; border-radius:42rpx; background:#1B1215; color:white; box-shadow:0 26rpx 62rpx rgba(43,23,29,.2); }
.ai-collage { height:470rpx; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:3rpx; background:#2C1A20; }
.ai-collage > view { min-width:0; overflow:hidden; position:relative; background:#21171A; }
.ai-collage image { width:100%; height:100%; }
.ai-collage > view::after { content:""; position:absolute; inset:42% 0 0; background:linear-gradient(transparent,rgba(15,7,10,.76)); }
.ai-collage > view > view { position:absolute; z-index:2; left:16rpx; right:16rpx; bottom:14rpx; }
.ai-collage text { display:block; }
.ai-collage text:first-child { color:white; font-size:20rpx; font-weight:760; }
.ai-collage text:last-child { margin-top:2rpx; color:rgba(255,255,255,.66); font-size:17rpx; }
.ai-feature-copy { padding:32rpx; display:flex; flex-direction:column; background:radial-gradient(circle at 92% 8%,rgba(248,200,214,.22),transparent 28%),#21161A; }
.ai-feature-copy > text { display:block; }
.ai-badge { align-self:flex-start; padding:12rpx 17rpx; border:2rpx solid rgba(255,255,255,.17); border-radius:999rpx; background:rgba(255,255,255,.07); color:#F9D8E1; font-size:19rpx; font-weight:800; }
.ai-id { margin-top:24rpx; color:#DEB9C3; font-size:18rpx; font-weight:800; letter-spacing:.08em; }
.ai-title { max-width:11em; margin-top:8rpx; color:white; font-size:42rpx; line-height:1.18; font-weight:780; letter-spacing:-.03em; }
.ai-copy { margin-top:16rpx; color:rgba(255,255,255,.72); font-size:22rpx; line-height:1.68; }
.ai-go { margin-top:25rpx; color:#F7D5A5; font-size:22rpx; font-weight:800; }
.archive-groups { margin-top:24rpx; display:flex; flex-direction:column; gap:14rpx; }
.archive-group { overflow:hidden; border:2rpx solid var(--u-line); border-radius:34rpx; background:#FFFDFC; box-shadow:0 12rpx 32rpx rgba(89,56,62,.045); }
.archive-group-toggle { min-height:166rpx; padding:26rpx 28rpx; display:grid; grid-template-columns:minmax(0,1fr) 76rpx; align-items:center; gap:18rpx; }
.archive-group-toggle > view { min-width:0; }
.archive-group-toggle > view text { display:block; }
.archive-group-toggle > view text:first-child { color:var(--u-active); font-size:18rpx; font-weight:850; letter-spacing:.08em; }
.archive-group-toggle > view text:nth-child(2) { margin-top:6rpx; font-size:29rpx; font-weight:760; }
.archive-group-toggle > view text:nth-child(3) { margin-top:6rpx; color:var(--u-muted); font-size:20rpx; line-height:1.5; }
.archive-group-toggle > text { width:76rpx; height:76rpx; border-radius:25rpx; display:flex; align-items:center; justify-content:center; background:linear-gradient(130deg,rgba(248,200,214,.46),rgba(253,224,168,.5)); color:var(--u-ink); font-size:22rpx; font-weight:850; }
.archive-group--open .archive-group-toggle { border-bottom:2rpx solid var(--u-line); }
.archive-group-body { padding:22rpx; background:#FFF9F7; }
.archive-section-head { margin-top: 44rpx; margin-bottom: 18rpx; display: flex; align-items: flex-end; justify-content: space-between; gap: 20rpx; }.archive-section-head > view { min-width: 0; }.archive-section-head > view text { display: block; }.archive-section-head > view text:first-child { font-size: 31rpx; font-weight: 750; }.archive-section-head > view text:last-child { margin-top: 5rpx; color: var(--u-muted); font-size: 21rpx; line-height: 1.45; }.archive-section-head > text { flex: none; color: var(--u-muted); font-size: 17rpx; font-weight: 800; letter-spacing: .08em; }
.room-scroll { width: calc(100% + 40rpx); margin-right: -40rpx; white-space: nowrap; }.room-row { padding-right: 40rpx; display: inline-flex; gap: 16rpx; }.room-card { width: 320rpx; height: 390rpx; overflow: hidden; position: relative; border: 3rpx solid transparent; border-radius: 34rpx; background: #20171A; }.room-card--active { border-color: var(--u-active); }.room-card > image { width: 100%; height: 100%; }.room-card::after { content:""; position:absolute; inset:42% 0 0; background:linear-gradient(transparent,rgba(17,7,10,.85)); }.room-card > view { position:absolute; z-index:2; left:24rpx; right:24rpx; bottom:24rpx; color:white; }.room-card text { display:block; }.room-card text:nth-child(1) { color:rgba(255,255,255,.68); font-size:19rpx; }.room-card text:nth-child(2) { margin-top:5rpx; font-size:29rpx; font-weight:750; }.room-card text:nth-child(3) { margin-top:5rpx; color:rgba(255,255,255,.68); font-size:20rpx; }
.mode-grid { display: flex; flex-direction: column; gap: 16rpx; }.mode-card { min-height: 190rpx; padding: 24rpx; border: 2rpx solid var(--u-line); border-radius: 34rpx; display: grid; grid-template-columns: 82rpx minmax(0,1fr) auto; align-items:center; gap:20rpx; background:white; box-shadow:var(--u-shadow); }.mode-card--active { border-color:var(--u-active); background:linear-gradient(120deg,rgba(248,200,214,.18),white); }.mode-icon { width:82rpx; height:82rpx; border-radius:27rpx; display:flex; align-items:center; justify-content:center; background:var(--u-grad); font-size:34rpx; font-weight:800; }.mode-card > view { min-width:0; }.mode-card > view text { display:block; }.mode-card > view text:nth-child(1) { color:var(--u-active); font-size:19rpx; font-weight:800; }.mode-card > view text:nth-child(2) { margin-top:4rpx; font-size:28rpx; font-weight:750; }.mode-card > view text:nth-child(3) { margin-top:6rpx; color:var(--u-muted); font-size:21rpx; line-height:1.5; }.mode-card > text:last-child { color:var(--u-muted); font-size:28rpx; }
.pitch-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14rpx; }.pitch-card { min-height:242rpx; padding:24rpx; border:2rpx solid var(--u-line); border-radius:30rpx; display:flex; flex-direction:column; background:linear-gradient(145deg,#FFFDFC,#FAF1F2); box-shadow:var(--u-shadow); }.pitch-card text { display:block; }.pitch-card text:nth-child(1) { color:var(--u-active); font-size:17rpx; font-weight:800; letter-spacing:.06em; }.pitch-card text:nth-child(2) { margin-top:7rpx; font-size:26rpx; line-height:1.25; font-weight:750; }.pitch-card text:nth-child(3) { margin-top:9rpx; color:var(--u-muted); font-size:20rpx; line-height:1.46; }.pitch-card text:nth-child(4) { margin-top:auto; padding-top:16rpx; color:var(--u-ink); font-size:19rpx; font-weight:750; }
.archive-preview { margin-top: 42rpx; padding: 28rpx; border: 2rpx solid var(--u-line); border-radius: 42rpx; background: #FFFCFB; box-shadow: var(--u-shadow); }.preview-head { margin-bottom:24rpx; display:flex; align-items:flex-end; justify-content:space-between; gap:16rpx; }.preview-head > view { min-width:0; }.preview-head > view text { display:block; }.preview-head > view text:first-child { color:var(--u-active); font-size:19rpx; font-weight:800; }.preview-head > view text:last-child { margin-top:5rpx; font-size:34rpx; font-weight:750; }.preview-head > text { flex:none; padding:9rpx 13rpx; border-radius:999rpx; background:rgba(248,200,214,.25); color:var(--u-muted); font-size:18rpx; }
.journey-route { display:grid; grid-template-columns:repeat(4,1fr); gap:8rpx; }.journey-route view { padding:15rpx 4rpx; border:2rpx solid var(--u-line); border-radius:19rpx; text-align:center; }.journey-route view.active { border-color:var(--u-active); background:rgba(248,200,214,.26); }.journey-route text { display:block; }.journey-route text:first-child { font-size:18rpx; font-weight:800; }.journey-route text:last-child { margin-top:3rpx; color:var(--u-muted); font-size:17rpx; }
.pano-card { height:500rpx; margin-top:16rpx; overflow:hidden; position:relative; border-radius:30rpx; background:#1A1114; }.pano-card scroll-view { width:100%; height:100%; white-space:nowrap; }.pano-card image { width:1500rpx; height:500rpx; }.pano-card::after { content:""; position:absolute; pointer-events:none; inset:44% 0 0; background:linear-gradient(transparent,rgba(18,7,10,.84)); }.pano-card > view { position:absolute; z-index:2; left:24rpx; right:24rpx; bottom:24rpx; color:white; }.pano-card > view text { display:block; }.pano-card > view text:first-child { color:rgba(255,255,255,.68); font-size:20rpx; }.pano-card > view text:nth-child(2) { margin-top:4rpx; font-size:34rpx; font-weight:750; }.pano-card > view text:nth-child(3) { margin-top:5rpx; color:rgba(255,255,255,.7); font-size:20rpx; }.direction-label { display:block; margin-top:15rpx; color:var(--u-muted); text-align:center; font-size:20rpx; }
.direction-row { margin-top:14rpx; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8rpx; }.direction-row button { width:100%; min-width:0; min-height:64rpx; padding:0 4rpx; border:2rpx solid var(--u-line); border-radius:18rpx; display:flex; align-items:center; justify-content:center; background:white; color:var(--u-muted); font-size:19rpx; line-height:1; }.direction-row button.active { border-color:var(--u-active); background:rgba(248,200,214,.28); color:var(--u-ink); font-weight:750; }
.preview-timeline { display:flex; flex-direction:column; gap:14rpx; }.preview-timeline > view { min-height:132rpx; overflow:hidden; border-radius:25rpx; display:grid; grid-template-columns:76rpx 160rpx minmax(0,1fr); align-items:center; gap:14rpx; background:#F8F1F2; }.preview-timeline image { width:160rpx; height:132rpx; }.preview-timeline text:first-child { padding-left:14rpx; font-size:20rpx; font-weight:800; }.preview-timeline text:last-child { padding-right:14rpx; color:var(--u-muted); font-size:21rpx; }
.preview-album { display:grid; grid-template-columns:repeat(2,1fr); gap:10rpx; }.preview-album image { width:100%; height:240rpx; border-radius:22rpx; }
.preview-machine { padding:8rpx; display:grid; grid-template-columns:repeat(2,1fr); gap:6rpx; background:#181214; }.preview-machine > view { height:230rpx; overflow:hidden; position:relative; background:#2A2023; }.preview-machine image { width:100%; height:100%; filter:saturate(.72) contrast(1.08); }.preview-machine > view::after { content:""; position:absolute; inset:44% 0 0; background:linear-gradient(transparent,rgba(0,0,0,.82)); }.preview-machine > view > view { position:absolute; z-index:2; left:12rpx; right:12rpx; bottom:12rpx; color:white; }.preview-machine text { display:block; }.preview-machine text:first-child { font-size:24rpx; font-weight:800; }.preview-machine text:nth-child(2) { color:rgba(255,255,255,.65); font-size:17rpx; }.preview-machine text:last-child { position:absolute; right:0; bottom:0; color:#F8D5AA; font-size:17rpx; }
.preview-film { display:grid; grid-template-columns:repeat(3,1fr); gap:8rpx; }.preview-film > view:not(.film-copy) { height:170rpx; overflow:hidden; position:relative; border-radius:18rpx; }.preview-film image { width:100%; height:100%; }.preview-film > view:not(.film-copy) text { position:absolute; left:9rpx; top:9rpx; width:34rpx; height:34rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; background:rgba(19,8,11,.62); color:white; font-size:16rpx; }.film-copy { grid-column:1/-1; padding:22rpx 2rpx 0; }.film-copy text { display:block; }.film-copy text:first-child { font-size:27rpx; font-weight:750; }.film-copy text:nth-child(2) { margin-top:6rpx; color:var(--u-muted); font-size:21rpx; line-height:1.55; }.film-copy button { min-height:82rpx; margin-top:18rpx; border-radius:24rpx; display:flex; align-items:center; justify-content:center; background:var(--u-grad); font-size:23rpx; font-weight:700; }
.archive-note { margin-top:28rpx; padding:24rpx; border-radius:26rpx; background:rgba(248,200,214,.2); color:var(--u-muted); font-size:22rpx; line-height:1.6; }.archive-note text:first-child { color:var(--u-ink); font-weight:750; }

@media (max-width: 350px) { .archive-main { padding-left:32rpx; padding-right:32rpx; }.archive-hero { padding:40rpx; }.archive-title { font-size:48rpx; }.mode-card { grid-template-columns:72rpx minmax(0,1fr); }.mode-icon { width:72rpx; height:72rpx; }.mode-card > text:last-child { grid-column:2; }.archive-preview { padding:22rpx; } }
