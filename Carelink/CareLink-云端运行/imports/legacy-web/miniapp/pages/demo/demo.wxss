.demo-page {
  width: 100%;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 88% 7%, rgba(253, 224, 168, 0.44), transparent 30%),
    radial-gradient(circle at 8% 22%, rgba(248, 200, 214, 0.36), transparent 28%),
    var(--u-bg);
}

.demo-nav { padding-left: 24rpx; padding-right: 24rpx; }
.demo-main { width: 100%; padding: 30rpx 40rpx 90rpx; }

.demo-hero {
  width: 100%;
  padding: 46rpx;
  overflow: hidden;
  position: relative;
  border-radius: 52rpx;
  background:
    radial-gradient(circle at 88% 18%, rgba(255,255,255,.62) 0 17%, transparent 18%),
    linear-gradient(125deg, #F8C8D6 0%, #FDE0A8 72%, #FFF1CF 100%);
  box-shadow: var(--u-shadow);
}

.demo-kicker { display: block; color: rgba(89,56,62,.72); font-size: 24rpx; line-height: 1.4; font-weight: 800; letter-spacing: .18em; }
.demo-title { display: block; margin-top: 16rpx; max-width: 12em; font-size: 58rpx; line-height: 1.18; font-weight: 760; letter-spacing: -.035em; }
.demo-copy { display: block; margin-top: 26rpx; color: rgba(89,56,62,.74); font-size: 26rpx; line-height: 1.65; }
.demo-legend { margin-top: 28rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.legend-item { padding: 10rpx 16rpx; border-radius: 999rpx; display: flex; align-items: center; gap: 10rpx; background: rgba(255,252,251,.72); font-size: 21rpx; font-weight: 700; }
.legend-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.legend-dot--product { background: var(--u-active); }
.legend-dot--experiment { background: #60424A; }
.legend-dot--research { background: #7C8D84; }

.demo-section-head { margin-top: 42rpx; margin-bottom: 18rpx; }
.section-lead { display: block; margin-top: 6rpx; color: var(--u-muted); font-size: 24rpx; line-height: 1.5; }

.demo-steps { width: 100%; padding: 24rpx; border: 2rpx solid var(--u-line); border-radius: 32rpx; display: grid; grid-template-columns: 1fr 36rpx 1fr 36rpx 1fr; align-items: center; background: var(--u-card); }
.demo-step { min-width: 0; color: var(--u-muted); text-align: center; font-size: 20rpx; line-height: 1.35; }
.demo-step text { display: block; }
.demo-step-number { color: var(--u-ink); font-size: 24rpx; font-weight: 800; }
.demo-step-line { height: 2rpx; background: var(--u-grad); }

.archive-callout { width: 100%; min-height: 214rpx; margin-top: 24rpx; padding: 28rpx; border: 2rpx solid rgba(255,127,159,.2); border-radius: 38rpx; display: grid; grid-template-columns: 104rpx minmax(0,1fr) auto; align-items: center; gap: 22rpx; background: linear-gradient(120deg,rgba(248,200,214,.38),rgba(253,224,168,.4)); box-shadow: var(--u-shadow); }
.archive-callout-mark { width: 104rpx; height: 104rpx; border-radius: 32rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #5B3F46; color: #FFF9F7; }
.archive-callout-mark text:first-child { font-size: 36rpx; line-height: 1; font-weight: 850; }
.archive-callout-mark text:last-child { margin-top: 7rpx; color: rgba(255,255,255,.68); font-size: 15rpx; letter-spacing: .08em; }
.archive-callout-copy { min-width: 0; }
.archive-callout-copy text { display: block; }
.archive-callout-copy text:first-child { font-size: 30rpx; font-weight: 750; }
.archive-callout-copy text:last-child { margin-top: 8rpx; color: var(--u-muted); font-size: 22rpx; line-height: 1.52; }
.archive-callout-go { color: var(--u-active); font-size: 36rpx; font-weight: 700; }

.demo-list { display: flex; flex-direction: column; gap: 18rpx; }
.demo-card {
  width: 100%;
  min-width: 0;
  min-height: 220rpx;
  padding: 26rpx;
  border: 2rpx solid var(--u-line);
  border-radius: 38rpx;
  display: grid;
  grid-template-columns: 96rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 22rpx;
  background: var(--u-card);
  text-align: left;
  box-shadow: var(--u-shadow);
}
.demo-card--experiment { background: linear-gradient(135deg, #FFFAF9, #F7EFF1); }
.demo-card--research { background: linear-gradient(135deg, #FFFCFB, #F2F6F2); }
.demo-card--featured { min-height: 330rpx; padding: 0; overflow: hidden; grid-template-columns: 220rpx minmax(0, 1fr); grid-template-rows: 1fr auto; border-color: rgba(255,127,159,.24); background: linear-gradient(135deg, #FFFAF9, #FFF4E1); }
.demo-feature-image { width: 220rpx; height: 330rpx; grid-row: 1 / 3; background: #2B2023; }
.demo-card--featured .demo-card-copy { padding: 28rpx 26rpx 10rpx 0; }
.demo-card--featured .demo-card-go { grid-column: 2; justify-self: start; padding: 0 0 26rpx; }
.demo-card-icon { width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 32rpx; background: var(--u-grad); font-size: 40rpx; font-weight: 800; }
.demo-card-icon--dark { background: #60424A; color: #FFF9F7; }
.demo-card-icon--research { background: #DFE9E2; color: #40594A; }
.demo-card-copy { min-width: 0; }
.demo-card-meta, .demo-card-title, .demo-card-sub { display: block; }
.demo-card-meta { color: var(--u-active); font-size: 21rpx; line-height: 1.4; font-weight: 800; }
.demo-card-meta--experiment { color: #785D65; }
.demo-card-meta--research { color: #5B7765; }
.demo-card-title { margin-top: 4rpx; font-size: 30rpx; line-height: 1.35; font-weight: 720; }
.demo-card-sub { margin-top: 9rpx; color: var(--u-muted); font-size: 23rpx; line-height: 1.5; }
.demo-card-go { align-self: end; color: var(--u-muted); font-size: 21rpx; font-weight: 700; white-space: nowrap; }

.demo-safety { margin-top: 38rpx; }
.notice-strong { font-weight: 800; }

@media (max-width: 350px) {
  .demo-main { padding-left: 32rpx; padding-right: 32rpx; }
  .demo-hero { padding: 40rpx; }
  .demo-title { font-size: 52rpx; }
  .demo-card { grid-template-columns: 84rpx minmax(0, 1fr); }
  .demo-card-icon { width: 84rpx; height: 84rpx; }
  .demo-card-go { grid-column: 2; justify-self: start; }
  .demo-card--featured { grid-template-columns: 190rpx minmax(0, 1fr); }
  .demo-feature-image { width: 190rpx; }
}
