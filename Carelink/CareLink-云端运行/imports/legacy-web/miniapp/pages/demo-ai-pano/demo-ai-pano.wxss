.ai-pano-page { width:100%; overflow-x:hidden; background:#171013; color:white; }
.ai-pano-nav { padding-left:24rpx; padding-right:24rpx; background:#171013; }
.ai-pano-nav .nav-back { background:rgba(255,255,255,.09); color:white; }
.ai-pano-nav .nav-title { color:white; }
.ai-pano-main { width:100%; }
.ai-pano-hero { height:600rpx; overflow:hidden; position:relative; background:#24181D; }
.ai-pano-hero > image { width:100%; height:100%; }
.ai-pano-shade { position:absolute; inset:24% 0 0; background:linear-gradient(transparent,rgba(16,7,11,.9)); }
.ai-pano-badge { position:absolute; top:34rpx; left:36rpx; padding:13rpx 18rpx; border:2rpx solid rgba(255,255,255,.28); border-radius:999rpx; background:rgba(20,9,13,.38); color:#F9D8E1; font-size:18rpx; font-weight:850; letter-spacing:.1em; }
.ai-pano-cover-copy { position:absolute; z-index:2; left:38rpx; right:38rpx; bottom:38rpx; }
.ai-pano-cover-copy text { display:block; }
.ai-pano-cover-copy text:first-child { color:rgba(255,255,255,.65); font-size:21rpx; font-weight:700; }
.ai-pano-cover-copy text:nth-child(2) { margin-top:5rpx; font-size:62rpx; line-height:1.08; font-weight:780; letter-spacing:-.04em; }
.ai-pano-cover-copy text:last-child { margin-top:5rpx; color:rgba(255,255,255,.75); font-size:24rpx; }
.scene-tabs { padding:18rpx 22rpx; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:9rpx; border-bottom:2rpx solid rgba(255,255,255,.08); background:#1D1417; }
.scene-tab { min-width:0; min-height:84rpx; padding:13rpx 4rpx; border:2rpx solid transparent; border-radius:22rpx; text-align:center; }
.scene-tab text { display:block; color:rgba(255,255,255,.55); font-size:18rpx; }
.scene-tab text:last-child { margin-top:2rpx; color:rgba(255,255,255,.82); font-size:21rpx; font-weight:700; }
.scene-tab--active { border-color:rgba(248,200,214,.58); background:rgba(248,200,214,.11); }
.scene-tab--active text:first-child { color:#F7D5A5; }
.ai-pano-content { padding:38rpx 36rpx calc(72rpx + env(safe-area-inset-bottom)); }
.ai-pano-head { display:flex; align-items:flex-end; justify-content:space-between; gap:16rpx; }
.ai-pano-head > view { min-width:0; }
.ai-pano-head > view text { display:block; }
.ai-pano-head > view text:first-child { color:#DEB9C3; font-size:18rpx; font-weight:850; letter-spacing:.1em; }
.ai-pano-head > view text:last-child { margin-top:5rpx; color:white; font-size:34rpx; font-weight:750; }
.ai-pano-head > text { flex:none; color:rgba(255,255,255,.48); font-size:20rpx; font-weight:700; }
.ai-panorama { height:520rpx; margin-top:24rpx; overflow:hidden; border:2rpx solid rgba(255,255,255,.1); border-radius:34rpx; background:#251A1E; white-space:nowrap; }
.ai-panorama image { width:1560rpx; height:780rpx; margin-top:-130rpx; }
.ai-direction-label { display:table; margin:-64rpx auto 0; padding:13rpx 19rpx; position:relative; z-index:2; border-radius:999rpx; background:rgba(20,8,12,.72); color:white; font-size:20rpx; font-weight:700; }
.ai-directions { margin-top:35rpx; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:9rpx; }
.ai-directions button { min-width:0; min-height:72rpx; padding:6rpx; border:2rpx solid rgba(255,255,255,.12); border-radius:21rpx; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,.045); color:rgba(255,255,255,.62); font-size:20rpx; font-weight:700; }
.ai-directions button.active { border-color:#F8C8D6; background:rgba(248,200,214,.15); color:white; }
.ai-scene-copy { padding:34rpx 2rpx 0; }
.ai-scene-copy text { display:block; }
.ai-scene-copy text:first-child { color:#DEB9C3; font-size:19rpx; font-weight:800; }
.ai-scene-copy text:nth-child(2) { margin-top:7rpx; font-size:34rpx; font-weight:760; }
.ai-scene-copy text:last-child { margin-top:10rpx; color:rgba(255,255,255,.62); font-size:23rpx; line-height:1.66; }
.ai-pano-facts { margin-top:28rpx; display:grid; grid-template-columns:repeat(3,1fr); gap:10rpx; }
.ai-pano-facts view { padding:22rpx 6rpx; border:2rpx solid rgba(255,255,255,.09); border-radius:25rpx; background:rgba(255,255,255,.035); text-align:center; }
.ai-pano-facts text { display:block; }
.ai-pano-facts text:first-child { color:#F7D5A5; font-size:31rpx; font-weight:800; }
.ai-pano-facts text:last-child { margin-top:4rpx; color:rgba(255,255,255,.53); font-size:18rpx; }
.ai-disclosure { margin-top:22rpx; padding:25rpx; border:2rpx solid rgba(248,200,214,.14); border-radius:28rpx; background:rgba(248,200,214,.07); }
.ai-disclosure text { display:block; }
.ai-disclosure text:first-child { color:#F9D8E1; font-size:22rpx; font-weight:750; }
.ai-disclosure text:last-child { margin-top:6rpx; color:rgba(255,255,255,.57); font-size:21rpx; line-height:1.62; }
.ai-pano-back { min-height:88rpx; margin-top:24rpx; border-radius:26rpx; display:flex; align-items:center; justify-content:center; background:linear-gradient(100deg,#F8C8D6,#FDE0A8); color:#59383E; font-size:23rpx; font-weight:760; }
