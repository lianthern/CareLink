<view class="pano-page" style="padding-top:{{navBarTop}}px">
  <view class="native-nav pano-nav" style="height:{{navBarHeight}}px">
    <button class="nav-back" bindtap="onBack" aria-label="返回">‹</button>
    <text class="nav-title">2D 成品全景</text>
    <view class="nav-spacer"></view>
  </view>

  <view class="pano-main">
    <view class="pano-heading">
      <text class="eyebrow">EQUIRECTANGULAR · 2:1</text>
      <text class="heading">{{title}}</text>
      <text class="lead">默认展示安全、稳定的 2D 等距柱状原图。双指可缩放，拖动可查看细节。</text>
    </view>

    <view wx:if="{{loading}}" class="viewer-empty">正在打开全景…</view>
    <view wx:elif="{{loadError}}" class="viewer-empty">
      <text>{{loadError}}</text>
      <button class="retry-button" bindtap="onRetry">重新加载</button>
    </view>
    <movable-area wx:else class="viewer">
      <movable-view class="movable-image" direction="all" scale scale-min="1" scale-max="4" scale-value="1">
        <image class="pano-image" src="{{panorama.src}}" mode="aspectFit" bindload="onImageLoad" binderror="onImageError" />
      </movable-view>
      <view class="loading-overlay" wx:if="{{!imageLoaded}}"><text>图片加载中…</text></view>
    </movable-area>
    <text class="fallback-note" wx:if="{{usingFallback && imageLoaded}}">原图加载失败，已自动切换轻量版。</text>

    <view class="notice">这里不调用相机、不自动截图、不做本地拼接，也不依赖 WebGL。即使设备图形能力有限，2D 图片仍是唯一展示路径。</view>
  </view>
</view>
