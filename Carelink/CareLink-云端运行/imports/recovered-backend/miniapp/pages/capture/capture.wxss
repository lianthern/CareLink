page { width: 100%; height: 100%; background: #050405; color: #fffaf8; }
.capture-page { position: absolute; inset: 0; background: #050405; }
.world-canvas { position: absolute; inset: 0; width: 100%; height: 100%; background: #000; }
.capture-layer, .process-layer, .result-layer { position: absolute; z-index: 2; inset: 0; }
.capture-layer--hidden, .result-layer--hidden { visibility: hidden; pointer-events: none; }
.capture-layer::after {
  content: "";
  position: absolute;
  z-index: 1;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(0,0,0,.4), transparent 26%, transparent 70%, rgba(0,0,0,.68));
}
.preview-label {
  position: absolute;
  z-index: 7;
  left: 50%;
  top: 132rpx;
  transform: translateX(-50%);
  padding: 12rpx 24rpx;
  border: 1px solid rgba(255,255,255,.24);
  border-radius: 999rpx;
  color: rgba(255,250,248,.68);
  background: rgba(0,0,0,.5);
  font-size: 20rpx;
  letter-spacing: .08em;
  white-space: nowrap;
}
.capture-head, .result-head {
  position: absolute;
  z-index: 10;
  left: 24rpx;
  right: 24rpx;
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  gap: 20rpx;
}
.round-btn {
  width: 80rpx;
  height: 80rpx;
  border: 1px solid rgba(255,255,255,.24);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fffaf8;
  background: rgba(0,0,0,.5);
  font-size: 44rpx;
}
.capture-count { text-align: center; text-shadow: 0 2rpx 14rpx #000; }
.capture-count-main, .capture-count-sub { display: block; }
.capture-count-main { font-size: 28rpx; font-weight: 700; }
.capture-count-sub { margin-top: 4rpx; color: rgba(255,250,248,.68); font-size: 20rpx; }
.live-window {
  position: absolute;
  z-index: 4;
  left: 50%;
  top: 50%;
  width: 540rpx;
  height: 720rpx;
  transform: translate(-50%, -50%);
  border: 3rpx solid rgba(255,255,255,.9);
  border-radius: 42rpx;
  background: #111;
  box-shadow: 0 36rpx 110rpx rgba(0,0,0,.48);
  overflow: hidden;
}
.camera, .camera-empty {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 42rpx;
  background: #080808;
}
.camera { z-index: 0; }
.camera--inactive { opacity: 0; pointer-events: none; }
.camera-empty {
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 44rpx 44rpx 56rpx;
  color: rgba(255,250,248,.62);
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}
.capture-flash { position: absolute; z-index: 2; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
.capture-flash--on { animation: flash .22s ease-out; }
@keyframes flash { from { opacity: .84; } to { opacity: 0; } }
.fixed-reticle {
  position: absolute;
  z-index: 8;
  left: 50%;
  top: 50%;
  width: 98rpx;
  height: 98rpx;
  transform: translate(-50%, -50%);
  border: 3rpx solid rgba(255,255,255,.92);
  border-radius: 50%;
  box-shadow: 0 0 0 2rpx rgba(0,0,0,.32);
  pointer-events: none;
}
.fixed-reticle::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #fff;
}
.target-dot {
  position: absolute;
  z-index: 7;
  width: 70rpx;
  height: 70rpx;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: conic-gradient(#ffcf72 var(--dwell), rgba(255,255,255,.34) 0);
  box-shadow: 0 8rpx 38rpx rgba(0,0,0,.5);
  transition: opacity .14s ease;
  pointer-events: none;
}
.target-core { position: absolute; inset: 10rpx; border-radius: 50%; background: #fff; }
.target-dot--aligned .target-core { background: #ffe3a3; }
.target-dot--hidden { opacity: 0; }
.target-dot--offscreen {
  width: 60rpx;
  height: 60rpx;
  border: 3rpx solid rgba(255,255,255,.86);
  background: rgba(0,0,0,.44);
}
.target-dot--offscreen .target-core { inset: 15rpx; }
.capture-guide {
  position: absolute;
  z-index: 9;
  left: 7%;
  right: 7%;
  bottom: calc(210rpx + env(safe-area-inset-bottom));
  text-align: center;
  text-shadow: 0 4rpx 20rpx #000;
}
.guide-title, .guide-detail { display: block; }
.guide-title { font-size: 26rpx; font-weight: 700; }
.guide-detail { margin-top: 8rpx; color: rgba(255,250,248,.7); font-size: 22rpx; }
.capture-diagnostic {
  display: block;
  max-width: 620rpx;
  margin: 10rpx auto 0;
  color: rgba(255,250,248,.48);
  font-size: 18rpx;
  line-height: 1.35;
}
.capture-actions, .result-actions {
  position: absolute;
  z-index: 10;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr 1.7fr 1fr;
  gap: 16rpx;
}
.ghost-btn, .primary-btn {
  min-height: 92rpx;
  margin: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}
.ghost-btn { border: 1px solid rgba(255,255,255,.24); color: #fffaf8; background: rgba(24,17,21,.8); }
.primary-btn { border: 0; color: #3e2430; background: linear-gradient(110deg,#ff9fc0,#ffc26b); }
.ghost-btn[disabled], .primary-btn[disabled] { opacity: .38; }
.process-layer {
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: radial-gradient(circle at 50% 24%, rgba(255,159,192,.18), transparent 34%), #080607;
  text-align: center;
}
.spinner { width: 92rpx; height: 92rpx; border: 8rpx solid rgba(255,255,255,.14); border-top-color: #ffc26b; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.process-title { margin-top: 42rpx; font-size: 40rpx; font-weight: 750; }
.process-copy { margin-top: 20rpx; color: rgba(255,250,248,.68); font-size: 24rpx; line-height: 1.65; }
.progress-track { width: 100%; height: 14rpx; margin-top: 48rpx; overflow: hidden; border-radius: 999rpx; background: rgba(255,255,255,.12); }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#ff9fc0,#ffc26b); transition: width .16s ease; }
.progress-number { margin-top: 20rpx; font-size: 36rpx; font-weight: 700; }
.result-layer { z-index: 15; padding: 180rpx 28rpx 180rpx; background: radial-gradient(circle at 50% 0%, rgba(255,159,192,.15), transparent 36%), #080607; }
.result-head { top: 0; grid-template-columns: 88rpx 1fr; }
.result-title-main, .result-title-sub { display: block; }
.result-title-main { font-size: 30rpx; font-weight: 700; }
.result-title-sub { margin-top: 4rpx; color: rgba(255,250,248,.66); font-size: 20rpx; }
.result-frame { position: relative; width: 100%; aspect-ratio: 2 / 1; border: 1px solid rgba(255,255,255,.22); border-radius: 28rpx; background: #000; }
.result-canvas, .viewer-canvas { position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 28rpx; }
.canvas-hidden { opacity: 0; pointer-events: none; }
.viewer-message { position: absolute; left: 24rpx; right: 24rpx; bottom: 18rpx; padding: 14rpx 20rpx; border-radius: 999rpx; color: #fff; background: rgba(0,0,0,.72); font-size: 20rpx; text-align: center; }
.result-copy { margin-top: 28rpx; }
.result-mode, .result-note { display: block; }
.result-mode { font-size: 30rpx; font-weight: 700; }
.result-note { margin-top: 10rpx; color: rgba(255,250,248,.66); font-size: 22rpx; line-height: 1.55; }
.result-actions { grid-template-columns: 1fr 1fr; }
.help-sheet { position: absolute; z-index: 50; inset: 0; display: flex; align-items: flex-end; padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); background: rgba(0,0,0,.68); }
.help-card { width: 100%; padding: 42rpx; border: 1px solid rgba(255,255,255,.18); border-radius: 42rpx; background: #1d171a; }
.help-title, .help-copy { display: block; }
.help-title { font-size: 34rpx; font-weight: 750; }
.help-copy { margin-top: 20rpx; color: rgba(255,250,248,.7); font-size: 24rpx; line-height: 1.7; }
.help-card .primary-btn { margin-top: 32rpx; width: 100%; }
.capability-sheet {
  position: absolute;
  z-index: 60;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: radial-gradient(circle at 50% 24%, rgba(255,159,192,.18), transparent 34%), #080607;
}
.capability-card {
  width: 100%;
  padding: 48rpx 42rpx;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 42rpx;
  background: #1d171a;
  box-shadow: 0 36rpx 120rpx rgba(0,0,0,.46);
}
.capability-kicker, .capability-title, .capability-copy { display: block; }
.capability-kicker { color: #ffc26b; font-size: 20rpx; letter-spacing: .12em; }
.capability-title { margin-top: 16rpx; font-size: 36rpx; font-weight: 750; line-height: 1.35; }
.capability-copy { margin-top: 20rpx; color: rgba(255,250,248,.7); font-size: 24rpx; line-height: 1.65; }
.capability-card .primary-btn { width: 100%; margin-top: 36rpx; }
.source-canvas-fallback { position: absolute; left: 0; top: 0; width: 2px; height: 2px; opacity: 0; pointer-events: none; }
