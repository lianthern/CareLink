page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #060506;
  color: #fffaf8;
}

.sweep-page,
.capture-layer,
.processing-layer,
.result-layer,
.blocked-layer {
  position: absolute;
  inset: 0;
}

.camera-preview,
.camera-placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: #0a090a;
}

.camera-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255, 250, 248, .42);
  font-size: 26rpx;
}

.shade {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(0, 0, 0, .58), transparent 28%, transparent 66%, rgba(0, 0, 0, .76));
}

.nav {
  position: absolute;
  z-index: 8;
  left: 24rpx;
  right: 24rpx;
  display: grid;
  grid-template-columns: 84rpx 1fr;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.round-btn {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, .24);
  border-radius: 50%;
  background: rgba(0, 0, 0, .44);
  font-size: 44rpx;
}

.title,
.subtitle {
  display: block;
  text-shadow: 0 3rpx 18rpx #000;
}

.title {
  font-size: 30rpx;
  font-weight: 750;
}

.subtitle {
  margin-top: 4rpx;
  color: rgba(255, 250, 248, .68);
  font-size: 21rpx;
}

.horizon {
  position: absolute;
  z-index: 5;
  left: 9%;
  right: 9%;
  top: 50%;
  height: 60rpx;
  transform: translateY(-50%);
  transition: color .15s ease;
}

.horizon-line {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  height: 2rpx;
  background: rgba(255, 255, 255, .86);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .7);
}

.center-tick {
  position: absolute;
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 60rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: #fff;
}

.horizon--warn .horizon-line,
.horizon--warn .center-tick {
  background: #ffc26b;
}

.direction-guide {
  position: absolute;
  z-index: 6;
  left: 7%;
  right: 7%;
  top: calc(50% + 84rpx);
  display: grid;
  grid-template-columns: 88rpx 1fr 88rpx;
  align-items: center;
  text-align: center;
  text-shadow: 0 3rpx 16rpx #000;
}

.arrow {
  color: rgba(255, 255, 255, .38);
  font-size: 64rpx;
  transition: color .15s ease, transform .15s ease;
}

.arrow--active {
  color: #ffc26b;
  transform: scale(1.18);
}

.guide-title,
.guide-detail {
  display: block;
}

.guide-title {
  font-size: 28rpx;
  font-weight: 750;
}

.guide-detail {
  margin-top: 9rpx;
  color: rgba(255, 250, 248, .72);
  font-size: 21rpx;
  line-height: 1.45;
}

.status-row {
  position: absolute;
  z-index: 6;
  left: 0;
  right: 0;
  top: calc(50% - 116rpx);
  display: flex;
  justify-content: center;
  gap: 14rpx;
}

.status-pill {
  padding: 10rpx 22rpx;
  border: 1px solid rgba(255, 255, 255, .2);
  border-radius: 999rpx;
  background: rgba(0, 0, 0, .5);
  font-size: 20rpx;
}

.status-pill--warn {
  color: #3e2430;
  border-color: transparent;
  background: #ffc26b;
}

.progress-panel {
  position: absolute;
  z-index: 6;
  left: 8%;
  right: 8%;
  bottom: calc(154rpx + env(safe-area-inset-bottom));
}

.progress-track {
  height: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .16);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #ff9fc0, #ffc26b);
  transition: width .12s linear;
}

.diagnostic {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 250, 248, .52);
  font-size: 18rpx;
  text-align: center;
}

.actions,
.result-actions {
  position: absolute;
  z-index: 8;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: grid;
  grid-template-columns: 1fr 1.8fr;
  gap: 16rpx;
}

.primary-btn,
.secondary-btn {
  min-height: 92rpx;
  margin: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 750;
}

.primary-btn {
  color: #3e2430;
  border: 0;
  background: linear-gradient(110deg, #ff9fc0, #ffc26b);
}

.secondary-btn {
  color: #fffaf8;
  border: 1px solid rgba(255, 255, 255, .24);
  background: rgba(24, 17, 21, .82);
}

.primary-btn[disabled],
.secondary-btn[disabled] {
  opacity: .38;
}

.processing-layer {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  text-align: center;
  background: radial-gradient(circle at 50% 28%, rgba(255, 159, 192, .18), transparent 35%), #080607;
}

.spinner {
  width: 88rpx;
  height: 88rpx;
  border: 8rpx solid rgba(255, 255, 255, .14);
  border-top-color: #ffc26b;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.processing-title {
  margin-top: 38rpx;
  font-size: 38rpx;
  font-weight: 750;
}

.processing-copy,
.result-note {
  margin-top: 18rpx;
  color: rgba(255, 250, 248, .66);
  font-size: 22rpx;
}

.result-layer {
  box-sizing: border-box;
  padding: 190rpx 26rpx 170rpx;
  background: radial-gradient(circle at 50% 0%, rgba(255, 159, 192, .15), transparent 38%), #080607;
}

.result-frame {
  position: relative;
  width: 100%;
  height: 58vh;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, .2);
  border-radius: 28rpx;
  background: #000;
}

.result-canvas,
.result-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.result-image {
  background: #000;
}

.result-note {
  display: block;
  text-align: center;
}

.blocked-layer {
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  background: #080607;
}

.blocked-card {
  width: 100%;
  box-sizing: border-box;
  padding: 44rpx;
  border: 1px solid rgba(255, 255, 255, .18);
  border-radius: 38rpx;
  background: #1d171a;
}

.blocked-title,
.blocked-copy {
  display: block;
}

.blocked-title {
  font-size: 34rpx;
  font-weight: 750;
}

.blocked-copy {
  margin: 20rpx 0 32rpx;
  color: rgba(255, 250, 248, .7);
  font-size: 24rpx;
  line-height: 1.6;
}
