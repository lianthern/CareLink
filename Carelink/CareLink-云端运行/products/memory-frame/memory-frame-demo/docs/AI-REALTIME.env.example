# Example only. Never put real credentials in this tracked file.
# Copy to ignored .tools/ai-realtime.local.env. Enable only after account and live checks.
AI_REALTIME_ENABLED=0
AI_REALTIME_PROVIDER=tencent-trtc
AI_REALTIME_TRTC_APP_ID=
AI_REALTIME_TRTC_SDK_SECRET=
AI_REALTIME_TRTC_SECRET_ID=
AI_REALTIME_TRTC_SECRET_KEY=
AI_REALTIME_TRTC_TOKEN=
AI_REALTIME_TRTC_REGION=ap-shanghai
# Set only after the TRTC application room-permission feature is enabled/tested.
AI_REALTIME_TRTC_ROOM_AUTH=0
# Recommended mode: own same-environment model-only bridge. TRTC receives a
# per-call grant, never the CloudBase administrator API key. Requires the new
# bridge code and live cloud/provider checks; a template is not activation.
MEMORY_CLOUDBASE_ENV=
AI_REALTIME_LLM_MODE=cloudbase-bridge
# Existing direct integrations may explicitly choose direct and supply their
# separately authorized OpenAI-compatible endpoint; bridge mode ignores it.
AI_REALTIME_LLM_JSON=
# Newly prepared configurations use the current documented Flow 02. Explicit
# flow_01_turbo remains supported for old accounts; no automatic paid fallback.
AI_REALTIME_TTS_JSON={"TTSType":"flow","Model":"flow_02_turbo","VoiceId":"v-female-R2s4N9qJ"}
# Private Timer function only; never enables a deployed resource by itself.
AI_REALTIME_CLEANUP_ENABLED=0
# Emergency stop-all is separate from disabling new starts. Default sweep only
# stops expired/stopping entries, even when the Timer has no LLM/signing config.
AI_REALTIME_CLEANUP_STOP_ALL=0
