# Optional immediate trial URL on an existing hostname while fresh DNS propagates.
# Insert inside maxxam.xyz's existing site block.
handle_path /spaces-preview/* {
    root * /var/www/unseen-spaces/current/spaces
    @previewImmutable path_regexp previewImmutable \.[a-f0-9]{16}\.(sog|mjs|js|css)$
    header @previewImmutable Cache-Control "public, max-age=31536000, immutable"
    @previewImages path *.jpg *.jpeg *.png *.webp
    header @previewImages Cache-Control "public, max-age=3600"
    header ?Cache-Control "no-cache"
    @previewModules path *.mjs
    header @previewModules Content-Type "application/javascript"
    header X-Robots-Tag "noindex, nofollow"
    file_server {
        precompressed br gzip
    }
}
