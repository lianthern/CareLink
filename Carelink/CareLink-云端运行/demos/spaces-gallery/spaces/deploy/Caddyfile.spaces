# Append this site block to the existing Caddyfile after validating the full file.
# Point current at an immutable build-server.mjs output directory.
spaces.maxxam.xyz {
    root * /var/www/unseen-spaces/current
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Robots-Tag "noindex, nofollow"
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    @root path /
    redir @root /spaces/ 302
    @immutable path_regexp immutable \.[a-f0-9]{16}\.(sog|mjs|js|css)$
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @images path *.jpg *.jpeg *.png *.webp
    header @images Cache-Control "public, max-age=3600"
    header ?Cache-Control "no-cache"
    @modules path *.mjs
    header @modules Content-Type "application/javascript"
    file_server {
        precompressed br gzip
        hide release-manifest.json
    }
}
