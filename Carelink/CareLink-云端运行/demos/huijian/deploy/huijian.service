[Unit]
Description=回见 (huijian) demo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=huijian
Group=huijian
WorkingDirectory=/opt/huijian
ExecStart=/usr/bin/env node /opt/huijian/server.mjs
Environment=PORT=4611
# MINIMAX_API_KEY lives here, root-owned 0640, never in the unit file or the repo.
EnvironmentFile=/etc/huijian/env
Restart=on-failure
RestartSec=3

# The process serves static files and proxies one API call. It needs nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/huijian
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=512M

[Install]
WantedBy=multi-user.target
