# Example only: replace the hostname before use. This configuration does not add authentication,
# quotas, or rate limiting; do not expose the paid model endpoint publicly without those controls.

huijian.example.com {
	encode zstd gzip

	# noindex is not an access-control mechanism.
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	handle /robots.txt {
		respond "User-agent: *
Disallow: /" 200
	}

	reverse_proxy 127.0.0.1:4611

	log {
		output file /var/log/caddy/huijian.log
		format json
	}
}
