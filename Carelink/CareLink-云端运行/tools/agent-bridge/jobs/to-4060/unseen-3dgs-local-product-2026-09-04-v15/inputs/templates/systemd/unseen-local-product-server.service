[Unit]
Description=UNSEEN loopback-only local product server
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/max/src/unseen-local-product
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/max/src/unseen-local-product/.venv/bin/python /home/max/src/unseen-local-product/app/unseen_local_product.py --root /home/max/unseen-local-product server --host 127.0.0.1 --port 8780
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
