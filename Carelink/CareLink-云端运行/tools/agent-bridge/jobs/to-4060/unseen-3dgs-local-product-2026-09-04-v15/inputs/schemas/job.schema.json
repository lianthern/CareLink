{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unseen.local/schemas/local-product-runner-job-v1.json",
  "title": "UNSEEN local runner job",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "kind",
    "scene",
    "inputPath",
    "inputSha256",
    "productRoot",
    "workDir",
    "progressPath",
    "resultPath"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "jobId": {"type": "string", "pattern": "^job-[0-9a-f]{12}$"},
    "kind": {"enum": ["scene_preview", "photo_localize"]},
    "inputPath": {"$ref": "#/$defs/absolutePath"},
    "inputSha256": {"$ref": "#/$defs/sha256"},
    "productRoot": {"$ref": "#/$defs/absolutePath"},
    "workDir": {"$ref": "#/$defs/absolutePath"},
    "progressPath": {"$ref": "#/$defs/absolutePath"},
    "resultPath": {"$ref": "#/$defs/absolutePath"},
    "colmapUseGpu": {"enum": [false, 0, "0"]},
    "scene": {"$ref": "#/$defs/scene"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "scene_preview"}}, "required": ["kind"]},
      "then": {"properties": {"scene": {"properties": {"state": {"const": "queued"}}}}}
    },
    {
      "if": {"properties": {"kind": {"const": "photo_localize"}}, "required": ["kind"]},
      "then": {
        "properties": {
          "scene": {
            "properties": {
              "state": {"const": "ready"},
              "result": {
                "type": "object",
                "required": ["status"],
                "properties": {"status": {"const": "ready"}}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "minLength": 2},
    "timestamp": {"type": "string", "minLength": 10},
    "scene": {
      "type": "object",
      "required": [
        "id",
        "revision_id",
        "display_name",
        "source_path",
        "source_sha256",
        "bytes",
        "width",
        "height",
        "duration_seconds",
        "state",
        "result",
        "error",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^scene-[0-9a-f]{12}$"},
        "revision_id": {"type": "string", "pattern": "^scene-[0-9a-f]{12}-r[0-9]{3}$"},
        "display_name": {"type": "string", "minLength": 1},
        "source_path": {"$ref": "#/$defs/absolutePath"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "number", "minimum": 10, "maximum": 600},
        "state": {"enum": ["uploaded", "queued", "ready", "failed"]},
        "result": {"type": ["object", "null"]},
        "error": {"type": ["string", "null"]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
