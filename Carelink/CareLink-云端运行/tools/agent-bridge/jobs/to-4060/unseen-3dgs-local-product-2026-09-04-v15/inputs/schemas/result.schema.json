{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unseen.local/schemas/local-product-result-v1.json",
  "title": "UNSEEN local runner result",
  "type": "object",
  "required": ["schemaVersion", "status", "kind", "sceneRevisionId", "inputSha256", "commands"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "status": {"enum": ["ready", "dry-run"]},
    "kind": {"enum": ["scene_preview", "photo_localize"]},
    "sceneRevisionId": {"type": "string", "pattern": "^scene-[0-9a-f]{12}-r[0-9]{3}$"},
    "inputSha256": {"$ref": "#/$defs/sha256"},
    "commands": {"$ref": "#/$defs/commands"},
    "groundTruthRead": {"type": "boolean"},
    "hardcodedPoseUsed": {"type": "boolean"},
    "registeredViews": {"type": "integer", "minimum": 270},
    "registeredDirections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"enum": ["front", "front_right", "right", "back_right", "back", "back_left", "left", "front_left", "up"]}
    },
    "registeredTimeIndices": {"type": "integer", "minimum": 30},
    "colmapModel": {"type": "string", "pattern": "^colmap/sparse/[A-Za-z0-9._-]+$"},
    "colmapModelCounts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9._-]+$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "trainingIterations": {"const": 7000},
    "trainingResumedFromStep": {"type": ["integer", "null"], "minimum": 0, "maximum": 6999},
    "trainingLastAttemptWallSeconds": {"type": "number", "minimum": 0},
    "trainingLastAttemptPeakVramMiB": {"type": ["integer", "null"], "minimum": 0},
    "checkpointBytes": {"type": "integer", "minimum": 1},
    "checkpointSha256": {"$ref": "#/$defs/sha256"},
    "plyBytes": {"type": "integer", "minimum": 1},
    "plySha256": {"$ref": "#/$defs/sha256"},
    "sogPath": {"$ref": "#/$defs/absolutePath"},
    "sogBytes": {"type": "integer", "minimum": 1},
    "sogSha256": {"$ref": "#/$defs/sha256"},
    "viewerRoot": {"$ref": "#/$defs/absolutePath"},
    "viewerCommand": {"type": "string", "minLength": 1},
    "heldOutManifest": {"$ref": "#/$defs/absolutePath"},
    "oom": {"const": false},
    "productionConnected": {"const": false},
    "anchor": {"$ref": "#/$defs/anchor"},
    "registrationQuality": {"$ref": "#/$defs/registrationQuality"},
    "viewerManifest": {"$ref": "#/$defs/absolutePath"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "ready"}, "kind": {"const": "scene_preview"}}, "required": ["status", "kind"]},
      "then": {
        "required": [
          "registeredViews",
          "registeredDirections",
          "registeredTimeIndices",
          "colmapModel",
          "colmapModelCounts",
          "trainingIterations",
          "trainingResumedFromStep",
          "trainingLastAttemptWallSeconds",
          "trainingLastAttemptPeakVramMiB",
          "checkpointBytes",
          "checkpointSha256",
          "plyBytes",
          "plySha256",
          "sogPath",
          "sogBytes",
          "sogSha256",
          "viewerRoot",
          "viewerCommand",
          "heldOutManifest",
          "oom",
          "productionConnected"
        ]
      }
    },
    {
      "if": {"properties": {"status": {"const": "ready"}, "kind": {"const": "photo_localize"}}, "required": ["status", "kind"]},
      "then": {
        "required": ["groundTruthRead", "hardcodedPoseUsed", "anchor", "registrationQuality", "viewerManifest"],
        "properties": {"groundTruthRead": {"const": false}, "hardcodedPoseUsed": {"const": false}}
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "pattern": "^/", "minLength": 2},
    "commands": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string"}
      }
    },
    "anchor": {
      "type": "object",
      "required": ["id", "label", "sceneRevisionId", "position", "quaternion", "fov"],
      "properties": {
        "id": {"type": "string", "pattern": "^photo-[0-9a-f]{12}$"},
        "label": {"type": "string", "minLength": 1},
        "sceneRevisionId": {"type": "string", "pattern": "^scene-[0-9a-f]{12}-r[0-9]{3}$"},
        "position": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "quaternion": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "fov": {"type": "number", "minimum": 10, "maximum": 150}
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": ["minGeometricInliers", "minGeometricInlierRatio", "maxMedianReprojectionPx"],
      "properties": {
        "minGeometricInliers": {"const": 20},
        "minGeometricInlierRatio": {"const": 0.1},
        "maxMedianReprojectionPx": {"const": 3.5}
      },
      "additionalProperties": false
    },
    "localDatabaseIsolation": {
      "type": "object",
      "required": [
        "sourceDatabaseCopied",
        "sourceDatabaseSha256",
        "baseReferenceImages",
        "removedNonModelImages",
        "removedOutOfModelPairRows",
        "onlyQueryUnregistered",
        "queryDatabaseImageId",
        "databaseImageCountAfterQuery"
      ],
      "properties": {
        "sourceDatabaseCopied": {"const": true},
        "sourceDatabaseSha256": {"$ref": "#/$defs/sha256"},
        "baseReferenceImages": {"type": "integer", "minimum": 1},
        "removedNonModelImages": {"type": "integer", "minimum": 0},
        "removedOutOfModelPairRows": {"type": "integer", "minimum": 0},
        "onlyQueryUnregistered": {"const": true},
        "queryDatabaseImageId": {"type": "integer", "minimum": 1},
        "databaseImageCountAfterQuery": {"type": "integer", "minimum": 2}
      },
      "additionalProperties": false
    },
    "registrationQuality": {
      "type": "object",
      "required": [
        "geometricInliers",
        "geometricInlierRatio",
        "medianReprojectionPx",
        "maxReprojectionPx",
        "queryKeypoints",
        "inlierRatioDefinition",
        "thresholds",
        "gatePassed",
        "existingFramesFixed",
        "onlyQueryAdded",
        "referenceFramesCompared",
        "referenceFramesWhitelisted",
        "referenceFramesInIsolatedDatabase",
        "maxReferenceRotationDelta",
        "maxReferencePositionDelta",
        "referenceGaugeTolerance",
        "registrationImageList",
        "localDatabaseIsolation",
        "colmapGpuRequested"
      ],
      "properties": {
        "geometricInliers": {"type": "integer", "minimum": 20},
        "geometricInlierRatio": {"type": "number", "minimum": 0.1, "maximum": 1},
        "medianReprojectionPx": {"type": "number", "minimum": 0, "maximum": 3.5},
        "maxReprojectionPx": {"type": "number", "minimum": 0},
        "queryKeypoints": {"type": "integer", "minimum": 1},
        "inlierRatioDefinition": {"const": "registered-3d-observations/query-keypoints"},
        "thresholds": {"$ref": "#/$defs/thresholds"},
        "gatePassed": {"const": true},
        "existingFramesFixed": {"const": true},
        "onlyQueryAdded": {"const": true},
        "referenceFramesCompared": {"type": "integer", "minimum": 1},
        "referenceFramesWhitelisted": {"type": "integer", "minimum": 1},
        "referenceFramesInIsolatedDatabase": {"type": "integer", "minimum": 1},
        "maxReferenceRotationDelta": {"type": "number", "minimum": 0},
        "maxReferencePositionDelta": {"type": "number", "minimum": 0},
        "referenceGaugeTolerance": {"type": "number", "exclusiveMinimum": 0},
        "registrationImageList": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "pattern": "^query\\.(jpg|jpeg|png)$"}
        },
        "localDatabaseIsolation": {"$ref": "#/$defs/localDatabaseIsolation"},
        "colmapGpuRequested": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
