@@ -0,0 +1,203 @@
+#!/usr/bin/env python3
+"""Export the gated v7 best checkpoint and build a round-tripped Viewer SOG."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import shutil
+import subprocess
+import time
+from pathlib import Path
+from typing import Any
+
+
+SCENE_REVISION = "pexels-classroom-5735358-r001"
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(4 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def quote_command(command: list[str]) -> str:
+    return " ".join(subprocess.list2cmdline([part]) for part in command)
+
+
+def run(command: list[str], log_path: Path, commands: list[str], timeout: int | None = None) -> str:
+    commands.append(quote_command(command))
+    proc = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout)
+    with log_path.open("a", encoding="utf-8") as handle:
+        handle.write(f"\n$ {quote_command(command)}\n{proc.stdout}")
+    if proc.returncode:
+        raise subprocess.CalledProcessError(proc.returncode, command, output=proc.stdout)
+    return proc.stdout
+
+
+def parse_info(text: str) -> dict[str, Any]:
+    start = text.rfind("\n{")
+    if start < 0:
+        start = text.find("{")
+    else:
+        start += 1
+    if start < 0:
+        raise RuntimeError("splat-transform output did not contain JSON info")
+    parsed, _ = json.JSONDecoder().raw_decode(text[start:])
+    return parsed
+
+
+def read_ply_header(path: Path) -> dict[str, Any]:
+    with path.open("rb") as handle:
+        data = handle.read(64 * 1024)
+    marker = b"end_header\n"
+    end = data.find(marker)
+    if end < 0:
+        raise RuntimeError(f"PLY header exceeds inspection limit: {path}")
+    lines = data[: end + len(marker)].decode("ascii").splitlines()
+    vertex = next(int(line.split()[2]) for line in lines if line.startswith("element vertex "))
+    rest = sum(1 for line in lines if re.match(r"property \w+ f_rest_\d+$", line))
+    total_coefficients = rest // 3 + 1 if rest else 1
+    sh_degree = round(total_coefficients ** 0.5 - 1)
+    return {"gaussians": vertex, "shDegree": sh_degree, "headerBytes": end + len(marker)}
+
+
+def ensure_no_active_job() -> None:
+    proc = subprocess.run(["pgrep", "-af", "[c]olmap|[n]s-train|[n]s-export"], text=True, stdout=subprocess.PIPE)
+    if proc.returncode == 0 and proc.stdout.strip():
+        raise RuntimeError("another training, COLMAP, or export process is active:\n" + proc.stdout.strip())
+
+
+def main() -> int:
+    project_root = Path(__file__).resolve().parents[1]
+    report_root = project_root / "reports/v7" / SCENE_REVISION
+    stage_result = json.loads((report_root / "stages/7000/stage-result.json").read_text(encoding="utf-8"))
+    evaluation = json.loads((report_root / "stages/7000/evaluation.json").read_text(encoding="utf-8"))
+    failed_15k = json.loads((report_root / "stages/15000/gate-decision.json").read_text(encoding="utf-8"))
+    if stage_result.get("status") != "TRAINING_COMPLETE" or not evaluation.get("hardGate", {}).get("pass"):
+        raise SystemExit("7k is not a gated checkpoint")
+    if failed_15k.get("replacePrevious"):
+        raise SystemExit("a later stage replaced 7k; refusing wrong best checkpoint")
+    ensure_no_active_job()
+    export_root = project_root / "artifacts/export/v7" / SCENE_REVISION / "best-7000"
+    viewer_asset = project_root / "viewer/assets/v7" / "pexels-classroom-v7.scene.sog"
+    result_path = report_root / "export-result.json"
+    raw_ply = export_root / "splat.ply"
+    roundtrip = export_root / "sog-roundtrip.ply"
+    resume_finalize = export_root.is_dir() and raw_ply.is_file() and viewer_asset.is_file() and not roundtrip.exists() and not result_path.exists()
+    if (export_root.exists() or viewer_asset.exists() or result_path.exists()) and not resume_finalize:
+        raise SystemExit("refusing to overwrite existing v7 export")
+    log_path = report_root / "logs/export-v7.log"
+    log_path.parent.mkdir(parents=True, exist_ok=True)
+    commands: list[str] = []
+    config = Path(stage_result["config"])
+    node_dir = project_root / ".tools/node/bin"
+    cli = project_root / "tools/splat-transform/node_modules/.bin/splat-transform"
+    environment = os.environ.copy()
+    environment["PATH"] = str(node_dir) + os.pathsep + environment.get("PATH", "")
+    os.environ["PATH"] = environment["PATH"]
+    selected_sh = 2
+    fallback_reason = None
+    sh2_command = [str(cli), "-g", "0", "-i", "10", str(raw_ply), "-H", "2", str(viewer_asset)]
+    conversion_seconds = None
+    if resume_finalize:
+        commands.extend(
+            [
+                quote_command(["ns-export", "gaussian-splat", "--load-config", str(config), "--output-dir", str(export_root)]),
+                quote_command(sh2_command),
+            ]
+        )
+        fallback_reason = "none; resumed metadata finalization after the completed SH2 conversion"
+    else:
+        export_root.mkdir(parents=True)
+        viewer_asset.parent.mkdir(parents=True, exist_ok=True)
+        run(
+            ["ns-export", "gaussian-splat", "--load-config", str(config), "--output-dir", str(export_root)],
+            log_path,
+            commands,
+        )
+        if not raw_ply.is_file():
+            raise SystemExit("ns-export did not produce splat.ply")
+        conversion_start = time.time()
+        commands.append(quote_command(sh2_command))
+        try:
+            proc = subprocess.run(
+                sh2_command,
+                env=environment,
+                text=True,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.STDOUT,
+                timeout=600,
+            )
+            with log_path.open("a", encoding="utf-8") as handle:
+                handle.write(f"\n$ {quote_command(sh2_command)}\n{proc.stdout}")
+            if proc.returncode or not viewer_asset.is_file():
+                raise RuntimeError(f"SH2 WebGPU conversion failed with exit {proc.returncode}")
+        except (RuntimeError, subprocess.TimeoutExpired) as exc:
+            fallback_reason = str(exc)
+            if viewer_asset.exists():
+                viewer_asset.unlink()
+            selected_sh = 1
+            run(
+                [str(cli), "-g", "cpu", "-i", "10", str(raw_ply), "-H", "1", str(viewer_asset)],
+                log_path,
+                commands,
+                timeout=600,
+            )
+        conversion_seconds = time.time() - conversion_start
+    raw_info = parse_info(
+        run([str(cli), str(raw_ply), "--info", "json", "null"], log_path, commands, timeout=120)
+    )
+    sog_info = parse_info(
+        run([str(cli), str(viewer_asset), "--info", "json", "null"], log_path, commands, timeout=120)
+    )
+    run([str(cli), str(viewer_asset), str(roundtrip)], log_path, commands, timeout=300)
+    roundtrip_info = parse_info(
+        run([str(cli), str(roundtrip), "--info", "json", "null"], log_path, commands, timeout=120)
+    )
+    result = {
+        "schemaVersion": "1.0",
+        "sceneRevisionId": SCENE_REVISION,
+        "bestStage": 7000,
+        "checkpoint": stage_result["outputCheckpoint"],
+        "rawPly": {
+            "path": str(raw_ply),
+            "bytes": raw_ply.stat().st_size,
+            "sha256": sha256(raw_ply),
+            **read_ply_header(raw_ply),
+            "info": raw_info,
+        },
+        "sog": {
+            "path": str(viewer_asset),
+            "bytes": viewer_asset.stat().st_size,
+            "sha256": sha256(viewer_asset),
+            "gaussians": sog_info["numGaussians"],
+            "shDegree": sog_info["shBands"],
+            "info": sog_info,
+        },
+        "roundtrip": {
+            "path": str(roundtrip),
+            "bytes": roundtrip.stat().st_size,
+            "sha256": sha256(roundtrip),
+            "gaussians": roundtrip_info["numGaussians"],
+            "shDegree": roundtrip_info["shBands"],
+            "gaussianCountPreserved": raw_info["numGaussians"] == sog_info["numGaussians"] == roundtrip_info["numGaussians"],
+            "info": roundtrip_info,
+        },
+        "selectedShDegree": selected_sh,
+        "sh1FallbackReason": fallback_reason,
+        "conversionWallSeconds": round(conversion_seconds, 3) if conversion_seconds is not None else None,
+        "commands": commands,
+        "status": "PASS" if raw_info["numGaussians"] == sog_info["numGaussians"] == roundtrip_info["numGaussians"] else "FAIL",
+    }
+    result_path.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, indent=2))
+    return 0 if result["status"] == "PASS" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
