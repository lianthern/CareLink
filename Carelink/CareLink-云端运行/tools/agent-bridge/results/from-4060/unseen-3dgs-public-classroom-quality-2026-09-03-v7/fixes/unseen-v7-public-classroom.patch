+#!/usr/bin/env python3
+"""Build the frozen v7 classroom dataset through a guarded COLMAP pipeline."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import re
+import shutil
+import statistics
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any, Iterable
+
+
+EXPECTED_SOURCE_BYTES = 12_273_501
+EXPECTED_SOURCE_SHA256 = "b4dca2e138b475d5168bde72e61fe54beab9820b90aca1b22a4fe3739ea04ce6"
+EXPECTED_DURATION_SECONDS = 17.884533
+EXPECTED_SCENE_REVISION = "pexels-classroom-5735358-r001"
+EXPECTED_FRAMES = 105
+EXPECTED_MAX_WIDTH = 1280
+JPEG_QSCALE = 2
+ANCHORS = ("frame_0001.jpg", "frame_0053.jpg", "frame_0105.jpg")
+INTAKE_JOB_PATTERN = re.compile(r"^local-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def quote_command(command: Iterable[object]) -> str:
+    return " ".join(subprocess.list2cmdline([str(part)]) for part in command)
+
+
+def is_relative_to(path: Path, parent: Path) -> bool:
+    try:
+        path.relative_to(parent)
+        return True
+    except ValueError:
+        return False
+
+
+def reject_symlink_chain(path: Path, stop: Path) -> None:
+    current = path
+    stop = stop.absolute()
+    while True:
+        if current.is_symlink():
+            raise RuntimeError(f"refusing symlink in intake path: {current}")
+        if current.absolute() == stop:
+            return
+        if current.parent == current:
+            raise RuntimeError(f"path does not descend from intake root: {path}")
+        current = current.parent
+
+
+def validate_intake_metadata_path(
+    project_root: Path, intake_job_id: str, metadata: dict[str, Any]
+) -> tuple[Path, Path]:
+    if not INTAKE_JOB_PATTERN.fullmatch(intake_job_id):
+        raise RuntimeError(f"invalid intake job id: {intake_job_id}")
+    intake_root = (project_root / "data/local-intake").absolute()
+    intake_dir = (intake_root / intake_job_id).absolute()
+    reject_symlink_chain(intake_dir, intake_root)
+    if metadata.get("jobId") != intake_job_id:
+        raise RuntimeError("intake metadata jobId mismatch")
+    if metadata.get("status") != "UPLOADED_VALIDATED_AWAITING_EXPLICIT_PREVIEW":
+        raise RuntimeError(f"intake is not ready for explicit processing: {metadata.get('status')}")
+    source_info = metadata.get("source")
+    if not isinstance(source_info, dict):
+        raise RuntimeError("intake metadata has no source object")
+    raw_source = source_info.get("localPath")
+    if not isinstance(raw_source, str) or not Path(raw_source).is_absolute():
+        raise RuntimeError("intake source localPath must be absolute")
+    source = Path(raw_source).absolute()
+    expected_source = intake_dir / "source.mp4"
+    if source != expected_source or not is_relative_to(source, intake_dir):
+        raise RuntimeError(f"intake source escapes the named job directory: {source}")
+    reject_symlink_chain(source, intake_root)
+    return intake_dir, source
+
+
+def load_and_validate_intake(project_root: Path, intake_job_id: str, *, probe: bool) -> tuple[dict[str, Any], Path]:
+    intake_root = project_root / "data/local-intake"
+    if not INTAKE_JOB_PATTERN.fullmatch(intake_job_id):
+        raise RuntimeError(f"invalid intake job id: {intake_job_id}")
+    metadata_path = intake_root / intake_job_id / "intake.json"
+    reject_symlink_chain(metadata_path, intake_root)
+    if metadata_path.is_symlink() or not metadata_path.is_file():
+        raise RuntimeError(f"missing regular intake metadata: {metadata_path}")
+    metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
+    _, source = validate_intake_metadata_path(project_root, intake_job_id, metadata)
+    if not source.is_file() or source.is_symlink():
+        raise RuntimeError(f"missing regular intake source: {source}")
+    source_info = metadata["source"]
+    actual_bytes = source.stat().st_size
+    actual_hash = sha256(source)
+    if actual_bytes != EXPECTED_SOURCE_BYTES or int(source_info.get("bytes", -1)) != EXPECTED_SOURCE_BYTES:
+        raise RuntimeError(f"frozen source byte mismatch: {actual_bytes}")
+    if actual_hash != EXPECTED_SOURCE_SHA256 or str(source_info.get("sha256", "")).lower() != EXPECTED_SOURCE_SHA256:
+        raise RuntimeError(f"frozen source SHA256 mismatch: {actual_hash}")
+    metadata_duration = float(source_info.get("ffprobe", {}).get("normalizedDurationSeconds", -1))
+    if abs(metadata_duration - EXPECTED_DURATION_SECONDS) > 1e-6:
+        raise RuntimeError(f"intake duration mismatch: {metadata_duration}")
+    if probe:
+        output = subprocess.check_output(
+            ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "default=nw=1:nk=1", str(source)],
+            text=True,
+        ).strip()
+        if abs(float(output) - EXPECTED_DURATION_SECONDS) > 1e-6:
+            raise RuntimeError(f"source ffprobe duration mismatch: {output}")
+    return metadata, source
+
+
+def scene_paths(project_root: Path, scene_revision_id: str) -> dict[str, Path]:
+    data_root = project_root / "data/v7" / scene_revision_id
+    report_root = project_root / "reports/v7" / scene_revision_id
+    return {
+        "data": data_root,
+        "frames": data_root / "frames",
+        "frame_contract": data_root / "frames.contract.json",
+        "sfm": data_root / "sfm",
+        "processed": data_root / "processed",
+        "report": report_root,
+        "log": report_root / "logs/process-v7.log",
+        "result": report_root / "processing-result.json",
+        "training_marker": report_root / "training-attempt.started",
+    }
+
+
+def assert_output_absent(paths: dict[str, Path]) -> None:
+    conflicts = [paths[key] for key in ("data", "report", "training_marker") if paths[key].exists()]
+    if conflicts:
+        raise RuntimeError("refusing existing v7 output: " + ", ".join(map(str, conflicts)))
+
+
+def expected_frame_names(max_frames: int) -> list[str]:
+    return [f"frame_{index:04d}.jpg" for index in range(1, max_frames + 1)]
+
+
+def build_frame_contract(source: Path, max_frames: int, max_width: int) -> dict[str, Any]:
+    return {
+        "schemaVersion": "1.0",
+        "source": {
+            "bytes": EXPECTED_SOURCE_BYTES,
+            "sha256": EXPECTED_SOURCE_SHA256,
+            "durationSeconds": EXPECTED_DURATION_SECONDS,
+            "path": str(source),
+        },
+        "extraction": {
+            "frames": max_frames,
+            "maxWidth": max_width,
+            "jpegQscale": JPEG_QSCALE,
+            "fpsExpression": f"{max_frames}/{EXPECTED_DURATION_SECONDS:.6f}",
+            "outputPattern": "frame_%04d.jpg",
+        },
+    }
+
+
+def add_frame_hashes(contract: dict[str, Any], frame_dir: Path, max_frames: int) -> dict[str, Any]:
+    names = expected_frame_names(max_frames)
+    actual = sorted(path.name for path in frame_dir.glob("frame_*.jpg") if path.is_file())
+    if actual != names:
+        raise RuntimeError(f"extracted frame set mismatch: expected {max_frames}, found {len(actual)}")
+    enriched = json.loads(json.dumps(contract))
+    enriched["files"] = [{"name": name, "bytes": (frame_dir / name).stat().st_size, "sha256": sha256(frame_dir / name)} for name in names]
+    digest = hashlib.sha256()
+    for row in enriched["files"]:
+        digest.update(f"{row['name']}\0{row['bytes']}\0{row['sha256']}\n".encode("utf-8"))
+    enriched["frameSetSha256"] = digest.hexdigest()
+    return enriched
+
+
+def verify_frame_contract(contract_path: Path, frame_dir: Path, expected: dict[str, Any]) -> None:
+    if not contract_path.is_file():
+        raise RuntimeError("existing frames lack immutable contract")
+    actual = json.loads(contract_path.read_text(encoding="utf-8"))
+    for key in ("schemaVersion", "source", "extraction"):
+        if actual.get(key) != expected.get(key):
+            raise RuntimeError(f"frame contract mismatch in {key}")
+    rebuilt = add_frame_hashes(expected, frame_dir, int(expected["extraction"]["frames"]))
+    if actual.get("files") != rebuilt.get("files") or actual.get("frameSetSha256") != rebuilt.get("frameSetSha256"):
+        raise RuntimeError("existing frame bytes do not match immutable contract")
+
+
+ANALYZER_PATTERNS: dict[str, tuple[str, type[int] | type[float]]] = {
+    "cameras": (r"^Cameras:\s+(\d+)", int),
+    "images": (r"^Images:\s+(\d+)", int),
+    "registeredImages": (r"^Registered images:\s+(\d+)", int),
+    "points": (r"^Points:\s+(\d+)", int),
+    "observations": (r"^Observations:\s+(\d+)", int),
+    "meanTrackLength": (r"^Mean track length:\s+([0-9.eE+-]+)", float),
+    "meanObservationsPerImage": (r"^Mean observations per image:\s+([0-9.eE+-]+)", float),
+    "meanReprojectionErrorPx": (r"^Mean reprojection error:\s+([0-9.eE+-]+)px", float),
+}
+
+
+def parse_model_analyzer(text: str) -> dict[str, int | float | None]:
+    parsed: dict[str, int | float | None] = {}
+    for key, (pattern, cast) in ANALYZER_PATTERNS.items():
+        match = re.search(pattern, text, re.MULTILINE)
+        parsed[key] = cast(match.group(1)) if match else None
+    return parsed
+
+
+def parse_images_txt(path: Path) -> list[dict[str, Any]]:
+    rows: list[dict[str, Any]] = []
+    content = [line.strip() for line in path.read_text(encoding="utf-8").splitlines() if not line.startswith("#")]
+    index = 0
+    while index < len(content):
+        if not content[index]:
+            index += 1
+            continue
+        fields = content[index].split()
+        if len(fields) < 10:
+            raise RuntimeError(f"malformed COLMAP image row: {content[index]}")
+        rows.append(
+            {
+                "imageId": int(fields[0]),
+                "qvec": tuple(float(value) for value in fields[1:5]),
+                "tvec": tuple(float(value) for value in fields[5:8]),
+                "cameraId": int(fields[8]),
+                "name": " ".join(fields[9:]),
+            }
+        )
+        index += 2
+    return rows
+
+
+def quaternion_rotation(qvec: tuple[float, float, float, float]) -> tuple[tuple[float, float, float], ...]:
+    qw, qx, qy, qz = qvec
+    norm = math.sqrt(qw * qw + qx * qx + qy * qy + qz * qz)
+    if norm == 0:
+        raise RuntimeError("zero COLMAP quaternion")
+    qw, qx, qy, qz = (value / norm for value in qvec)
+    return (
+        (1 - 2 * (qy * qy + qz * qz), 2 * (qx * qy - qz * qw), 2 * (qx * qz + qy * qw)),
+        (2 * (qx * qy + qz * qw), 1 - 2 * (qx * qx + qz * qz), 2 * (qy * qz - qx * qw)),
+        (2 * (qx * qz - qy * qw), 2 * (qy * qz + qx * qw), 1 - 2 * (qx * qx + qy * qy)),
+    )
+
+
+def camera_center(row: dict[str, Any]) -> tuple[float, float, float]:
+    rotation = quaternion_rotation(row["qvec"])
+    translation = row["tvec"]
+    return tuple(-sum(rotation[j][i] * translation[j] for j in range(3)) for i in range(3))
+
+
+def coverage_gate(rows: list[dict[str, Any]], max_frames: int) -> dict[str, Any]:
+    names = {row["name"] for row in rows}
+    ordered = sorted(rows, key=lambda row: row["name"])
+    centers = [camera_center(row) for row in ordered]
+    steps = [math.dist(centers[index - 1], centers[index]) for index in range(1, len(centers))]
+    median_step = statistics.median(steps) if steps else 0.0
+    max_step = max(steps, default=0.0)
+    zero_steps = sum(step <= 1e-12 for step in steps)
+    required_anchors = ("frame_0001.jpg", f"frame_{(max_frames + 1) // 2:04d}.jpg", f"frame_{max_frames:04d}.jpg")
+    return {
+        "registered": len(rows),
+        "requiredAnchors": list(required_anchors),
+        "anchorsPresent": all(anchor in names for anchor in required_anchors),
+        "firstPresent": required_anchors[0] in names,
+        "lastPresent": required_anchors[-1] in names,
+        "zeroAdjacentSteps": zero_steps,
+        "medianAdjacentStep": median_step,
+        "maxAdjacentStep": max_step,
+        "maxToMedianRatio": max_step / median_step if median_step > 0 else None,
+        "pass": len(rows) >= 100
+        and all(anchor in names for anchor in required_anchors)
+        and zero_steps == 0
+        and median_step > 0
+        and max_step <= median_step * 2.5,
+    }
+
+
+def read_camera_gate(path: Path) -> dict[str, Any]:
+    lines = [line.strip() for line in path.read_text(encoding="utf-8").splitlines() if line.strip() and not line.startswith("#")]
+    if len(lines) != 1:
+        raise RuntimeError(f"expected one COLMAP camera, found {len(lines)}")
+    fields = lines[0].split()
+    if len(fields) != 8:
+        raise RuntimeError(f"expected SIMPLE_RADIAL camera fields, got: {lines[0]}")
+    camera_id, model, width, height = int(fields[0]), fields[1], int(fields[2]), int(fields[3])
+    focal, cx, cy, k = (float(value) for value in fields[4:8])
+    gate = {
+        "cameraId": camera_id,
+        "model": model,
+        "width": width,
+        "height": height,
+        "focal": focal,
+        "cx": cx,
+        "cy": cy,
+        "k": k,
+        "focalRatio": focal / max(width, height),
+        "principalOffsetXRatio": abs(cx - width / 2) / width,
+        "principalOffsetYRatio": abs(cy - height / 2) / height,
+    }
+    gate["pass"] = (
+        model == "SIMPLE_RADIAL"
+        and 0.5 <= gate["focalRatio"] <= 2.0
+        and gate["principalOffsetXRatio"] <= 0.05
+        and gate["principalOffsetYRatio"] <= 0.05
+        and abs(k) <= 0.5
+    )
+    return gate
+
+
+def sfm_gate(summary: dict[str, Any], coverage: dict[str, Any], camera: dict[str, Any]) -> dict[str, Any]:
+    metrics_pass = (
+        int(summary.get("registeredImages") or 0) >= 100
+        and int(summary.get("points") or 0) >= 6500
+        and int(summary.get("observations") or 0) >= 120000
+        and float(summary.get("meanTrackLength") or 0) >= 10
+        and float(summary.get("meanReprojectionErrorPx") or float("inf")) <= 1.5
+    )
+    return {"metricsPass": metrics_pass, "coverage": coverage, "camera": camera, "pass": metrics_pass and bool(coverage["pass"]) and bool(camera["pass"])}
+
+
+def apply_explicit_split(transform_data: dict[str, Any], eval_count: int = 10) -> dict[str, Any]:
+    """Freeze a held-out split while keeping all three photo anchors in training."""
+    paths = sorted(str(frame["file_path"]) for frame in transform_data.get("frames", []))
+    if len(paths) != EXPECTED_FRAMES or len(set(paths)) != EXPECTED_FRAMES:
+        raise RuntimeError(f"expected {EXPECTED_FRAMES} unique transformed frames, found {len(paths)}")
+    anchors = {"images/frame_00001.jpg", "images/frame_00053.jpg", "images/frame_00105.jpg"}
+    if not anchors.issubset(paths):
+        raise RuntimeError("processed dataset is missing one or more photo anchors")
+    chosen: list[str] = []
+    for rank in range(1, eval_count + 1):
+        target = round(rank * (len(paths) - 1) / (eval_count + 1))
+        candidates = sorted(range(len(paths)), key=lambda index: (abs(index - target), index))
+        selected = next(paths[index] for index in candidates if paths[index] not in anchors and paths[index] not in chosen)
+        chosen.append(selected)
+    eval_paths = sorted(chosen)
+    train_paths = [path for path in paths if path not in set(eval_paths)]
+    if not anchors.issubset(train_paths):
+        raise RuntimeError("explicit split placed a photo anchor in held-out data")
+    transform_data["train_filenames"] = train_paths
+    transform_data["val_filenames"] = eval_paths
+    transform_data["test_filenames"] = eval_paths
+    return {
+        "trainCount": len(train_paths),
+        "heldOutCount": len(eval_paths),
+        "anchorFilenames": sorted(anchors),
+        "heldOutFilenames": eval_paths,
+    }
+
+
+def run(command: list[str], log_path: Path, commands: list[str]) -> str:
+    rendered = quote_command(command)
+    commands.append(rendered)
+    proc = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+    with log_path.open("a", encoding="utf-8") as handle:
+        handle.write(f"\n$ {rendered}\n{proc.stdout}")
+    if proc.returncode:
+        raise subprocess.CalledProcessError(proc.returncode, command, output=proc.stdout)
+    return proc.stdout
+
+
+def ensure_no_active_job() -> None:
+    proc = subprocess.run(["pgrep", "-af", "[c]olmap|[n]s-train|[n]s-export"], text=True, stdout=subprocess.PIPE)
+    if proc.returncode == 0 and proc.stdout.strip():
+        raise RuntimeError("another GPU/COLMAP/export job is active:\n" + proc.stdout.strip())
+
+
+def execute(args: argparse.Namespace) -> dict[str, Any]:
+    project_root = args.project_root.resolve()
+    paths = scene_paths(project_root, args.scene_revision_id)
+    metadata, source = load_and_validate_intake(project_root, args.intake_job_id, probe=not args.dry_run)
+    frame_contract = build_frame_contract(source, args.max_frames, args.max_width)
+    plan = {
+        "intakeJobId": args.intake_job_id,
+        "sceneRevisionId": args.scene_revision_id,
+        "source": str(source),
+        "paths": {key: str(value) for key, value in paths.items()},
+        "frameContract": frame_contract,
+        "dryRun": bool(args.dry_run),
+    }
+    if args.dry_run:
+        return plan
+    ensure_no_active_job()
+    assert_output_absent(paths)
+    paths["frames"].mkdir(parents=True)
+    paths["sfm"].mkdir(parents=True)
+    paths["log"].parent.mkdir(parents=True)
+    commands: list[str] = []
+    try:
+        ffmpeg = [
+            "ffmpeg", "-hide_banner", "-loglevel", "warning", "-i", str(source),
+            "-vf", f"fps={args.max_frames}/{EXPECTED_DURATION_SECONDS:.6f},scale='min({args.max_width},iw)':-2",
+            "-frames:v", str(args.max_frames), "-q:v", str(JPEG_QSCALE), str(paths["frames"] / "frame_%04d.jpg"),
+        ]
+        run(ffmpeg, paths["log"], commands)
+        enriched_contract = add_frame_hashes(frame_contract, paths["frames"], args.max_frames)
+        paths["frame_contract"].write_text(json.dumps(enriched_contract, indent=2) + "\n", encoding="utf-8")
+        verify_frame_contract(paths["frame_contract"], paths["frames"], frame_contract)
+
+        database = paths["sfm"] / "database.db"
+        sparse = paths["sfm"] / "sparse"
+        sparse.mkdir()
+        run(
+            [
+                "colmap", "feature_extractor", "--database_path", str(database), "--image_path", str(paths["frames"]),
+                "--ImageReader.single_camera", "1", "--ImageReader.camera_model", "SIMPLE_RADIAL",
+                "--ImageReader.camera_params", "1072.494661,640,360,-0.0358097",
+            ],
+            paths["log"], commands,
+        )
+        run(["colmap", "exhaustive_matcher", "--database_path", str(database)], paths["log"], commands)
+        run(
+            [
+                "colmap", "mapper", "--database_path", str(database), "--image_path", str(paths["frames"]),
+                "--output_path", str(sparse), "--Mapper.ba_global_function_tolerance", "1e-6",
+            ],
+            paths["log"], commands,
+        )
+
+        model_results: list[dict[str, Any]] = []
+        for model_dir in sorted(path for path in sparse.iterdir() if path.is_dir()):
+            run(
+                [
+                    "colmap", "bundle_adjuster", "--input_path", str(model_dir), "--output_path", str(model_dir),
+                    "--BundleAdjustment.refine_principal_point", "0",
+                ],
+                paths["log"], commands,
+            )
+            analyzer_text = run(["colmap", "model_analyzer", "--path", str(model_dir)], paths["log"], commands)
+            text_dir = paths["sfm"] / f"model-txt-{model_dir.name}"
+            text_dir.mkdir()
+            run(
+                ["colmap", "model_converter", "--input_path", str(model_dir), "--output_path", str(text_dir), "--output_type", "TXT"],
+                paths["log"], commands,
+            )
+            summary = parse_model_analyzer(analyzer_text)
+            coverage = coverage_gate(parse_images_txt(text_dir / "images.txt"), args.max_frames)
+            camera = read_camera_gate(text_dir / "cameras.txt")
+            gate = sfm_gate(summary, coverage, camera)
+            model_results.append({"modelDirectory": model_dir.name, "summary": summary, "gate": gate})
+        if not model_results:
+            raise RuntimeError("COLMAP mapper produced no model")
+        qualified = [row for row in model_results if row["gate"]["pass"]]
+        if not qualified:
+            raise RuntimeError("no single COLMAP model passed the complete SfM gate")
+        best = max(
+            qualified,
+            key=lambda row: (
+                int(row["summary"].get("registeredImages") or 0),
+                int(row["summary"].get("points") or 0),
+                int(row["summary"].get("observations") or 0),
+            ),
+        )
+        best_model = sparse / str(best["modelDirectory"])
+        image_list = paths["sfm"] / "anchor-images.txt"
+        image_list.write_text("\n".join(ANCHORS) + "\n", encoding="utf-8")
+        run(
+            [
+                "colmap", "image_undistorter", "--image_path", str(paths["frames"]), "--input_path", str(best_model),
+                "--output_path", str(paths["sfm"] / "undistorted-anchors"), "--output_type", "COLMAP",
+                "--image_list_path", str(image_list),
+            ],
+            paths["log"], commands,
+        )
+        paths["processed"].mkdir()
+        model_relative = Path(os.path.relpath(best_model, paths["processed"]))
+        run(
+            [
+                "ns-process-data", "images", "--data", str(paths["frames"]), "--output-dir", str(paths["processed"]),
+                "--skip-colmap", "--colmap-model-path", str(model_relative), "--num-downscales", "0",
+            ],
+            paths["log"], commands,
+        )
+        transforms = paths["processed"] / "transforms.json"
+        if not transforms.is_file():
+            raise RuntimeError("ns-process-data finished without transforms.json")
+        transform_data = json.loads(transforms.read_text(encoding="utf-8"))
+        if len(transform_data.get("frames", [])) < 100:
+            raise RuntimeError("Nerfstudio output lost too many registered frames")
+        dataset_split = apply_explicit_split(transform_data)
+        transforms.write_text(json.dumps(transform_data, indent=2) + "\n", encoding="utf-8")
+        result = {
+            **plan,
+            "dryRun": False,
+            "intakeMetadataStatus": metadata["status"],
+            "models": model_results,
+            "bestModelDirectory": str(best_model),
+            "bestModel": best,
+            "nerfstudioFrames": len(transform_data.get("frames", [])),
+            "datasetSplit": dataset_split,
+            "commands": commands,
+            "status": "SFM_GATE_PASS",
+        }
+        paths["result"].write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+        return result
+    except Exception as exc:
+        failure = {**plan, "dryRun": False, "status": "FAILED", "error": str(exc), "commands": commands}
+        (paths["report"] / "processing-failure.json").write_text(json.dumps(failure, indent=2) + "\n", encoding="utf-8")
+        raise
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--intake-job-id", required=True)
+    parser.add_argument("--scene-revision-id", required=True)
+    parser.add_argument("--max-frames", type=int, required=True)
+    parser.add_argument("--max-width", type=int, required=True)
+    parser.add_argument("--dry-run", action="store_true")
+    parser.add_argument("--project-root", type=Path, default=Path(__file__).resolve().parents[1], help=argparse.SUPPRESS)
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    if args.scene_revision_id != EXPECTED_SCENE_REVISION:
+        raise SystemExit(f"refusing unexpected scene revision: {args.scene_revision_id}")
+    if args.max_frames != EXPECTED_FRAMES or args.max_width != EXPECTED_MAX_WIDTH:
+        raise SystemExit("refusing parameters outside the frozen v7 extraction contract")
+    try:
+        result = execute(args)
+    except (RuntimeError, subprocess.CalledProcessError, json.JSONDecodeError) as exc:
+        print(str(exc), file=sys.stderr)
+        return 1
+    print(json.dumps(result, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
