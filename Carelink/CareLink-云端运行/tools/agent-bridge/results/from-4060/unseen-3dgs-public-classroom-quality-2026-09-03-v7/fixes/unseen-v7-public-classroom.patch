@@ -0,0 +1,268 @@
+#!/usr/bin/env python3
+"""Run exactly one guarded v7 Splatfacto stage and record its lineage."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+import re
+import signal
+import subprocess
+import time
+from pathlib import Path
+from typing import Any
+
+
+SCENE_REVISION = "pexels-classroom-5735358-r001"
+STAGES = (7000, 15000, 30000)
+PREVIOUS_STAGE = {15000: 7000, 30000: 15000}
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(4 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def quote_command(command: list[str]) -> str:
+    return " ".join(subprocess.list2cmdline([part]) for part in command)
+
+
+def load_json(path: Path) -> dict[str, Any]:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def ensure_no_active_job() -> None:
+    proc = subprocess.run(
+        ["pgrep", "-af", "[c]olmap|[n]s-train|[n]s-export|[t]rain_v7_stage"],
+        text=True,
+        stdout=subprocess.PIPE,
+    )
+    active = [line for line in proc.stdout.splitlines() if str(os.getpid()) not in line]
+    if active:
+        raise RuntimeError("another training, COLMAP, or export process is active:\n" + "\n".join(active))
+
+
+def expected_stage_paths(project_root: Path, stage: int) -> dict[str, Path]:
+    report_root = project_root / "reports/v7" / SCENE_REVISION
+    training_root = project_root / "artifacts/training/v7" / SCENE_REVISION
+    run_root = training_root / "pexels-classroom-v7" / "splatfacto" / f"stage-{stage}"
+    return {
+        "processing": report_root / "processing-result.json",
+        "processed": project_root / "data/v7" / SCENE_REVISION / "processed",
+        "report": report_root / "stages" / str(stage),
+        "marker": report_root / f"training-attempt-{stage}.started",
+        "run": run_root,
+        "checkpoint": run_root / "nerfstudio_models" / f"step-{stage - 1:09d}.ckpt",
+        "config": run_root / "config.yml",
+        "result": report_root / "stages" / str(stage) / "stage-result.json",
+        "log": report_root / "stages" / str(stage) / "train.log",
+        "gpu": report_root / "stages" / str(stage) / "gpu-samples.csv",
+    }
+
+
+def validate_stage(project_root: Path, stage: int) -> tuple[dict[str, Path], Path | None, str | None]:
+    if stage not in STAGES:
+        raise RuntimeError(f"unsupported v7 stage: {stage}")
+    paths = expected_stage_paths(project_root, stage)
+    processing = load_json(paths["processing"])
+    if processing.get("status") != "SFM_GATE_PASS" or not processing.get("bestModel", {}).get("gate", {}).get("pass"):
+        raise RuntimeError("v7 SfM gate is not PASS")
+    transforms = paths["processed"] / "transforms.json"
+    dataset = load_json(transforms)
+    if len(dataset.get("frames", [])) != 105 or len(dataset.get("train_filenames", [])) != 95 or len(dataset.get("test_filenames", [])) != 10:
+        raise RuntimeError("v7 processed dataset or explicit split is incomplete")
+    anchors = {"images/frame_00001.jpg", "images/frame_00053.jpg", "images/frame_00105.jpg"}
+    if not anchors.issubset(dataset["train_filenames"]):
+        raise RuntimeError("photo anchors are not all in the training split")
+    if paths["marker"].exists() or paths["run"].exists() or paths["report"].exists():
+        raise RuntimeError(f"refusing a second stage-{stage} attempt")
+    input_checkpoint: Path | None = None
+    input_hash: str | None = None
+    if stage == 7000:
+        later_markers = [expected_stage_paths(project_root, value)["marker"] for value in (15000, 30000)]
+        if any(path.exists() for path in later_markers):
+            raise RuntimeError("later-stage marker exists before the 7k run")
+    else:
+        previous = PREVIOUS_STAGE[stage]
+        previous_paths = expected_stage_paths(project_root, previous)
+        previous_result = load_json(previous_paths["result"])
+        decision = load_json(previous_paths["report"] / "gate-decision.json")
+        if not decision.get("allowNextStage"):
+            raise RuntimeError(f"stage-{previous} gate does not allow stage-{stage}")
+        input_checkpoint = Path(previous_result["outputCheckpoint"]["path"])
+        if input_checkpoint != previous_paths["checkpoint"] or not input_checkpoint.is_file():
+            raise RuntimeError("previous-stage checkpoint path is not the frozen lineage checkpoint")
+        input_hash = sha256(input_checkpoint)
+        if input_hash != previous_result["outputCheckpoint"]["sha256"]:
+            raise RuntimeError("previous-stage checkpoint SHA256 changed")
+    return paths, input_checkpoint, input_hash
+
+
+def build_command(paths: dict[str, Path], stage: int, input_checkpoint: Path | None) -> list[str]:
+    command = [
+        "ns-train",
+        "splatfacto",
+        "--output-dir",
+        str(paths["run"].parents[2]),
+        "--experiment-name",
+        "pexels-classroom-v7",
+        "--timestamp",
+        f"stage-{stage}",
+        "--max-num-iterations",
+        str(stage),
+        "--steps-per-save",
+        "2000",
+        "--steps-per-eval-image",
+        "100000",
+        "--steps-per-eval-all-images",
+        "100000",
+        "--vis",
+        "tensorboard",
+        "--pipeline.model.use-scale-regularization",
+        "True",
+        "--pipeline.model.random-init",
+        "False",
+        "--pipeline.model.camera-optimizer.mode",
+        "off",
+    ]
+    if input_checkpoint is not None:
+        command.extend(["--load-checkpoint", str(input_checkpoint)])
+    command.extend(
+        [
+            "nerfstudio-data",
+            "--data",
+            str(paths["processed"]),
+            "--load-3D-points",
+            "True",
+            "--orientation-method",
+            "up",
+            "--center-method",
+            "poses",
+            "--auto-scale-poses",
+            "True",
+        ]
+    )
+    return command
+
+
+def peak_vram(path: Path) -> int | None:
+    values: list[int] = []
+    if not path.is_file():
+        return None
+    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
+        fields = [part.strip() for part in line.split(",")]
+        if len(fields) >= 2 and fields[1].isdigit():
+            values.append(int(fields[1]))
+    return max(values) if values else None
+
+
+def execute(project_root: Path, stage: int) -> dict[str, Any]:
+    ensure_no_active_job()
+    paths, input_checkpoint, input_hash = validate_stage(project_root, stage)
+    paths["report"].mkdir(parents=True)
+    marker_payload = {
+        "stage": stage,
+        "startedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+        "inputCheckpoint": str(input_checkpoint) if input_checkpoint else None,
+        "inputCheckpointSha256": input_hash,
+    }
+    with paths["marker"].open("x", encoding="utf-8") as handle:
+        json.dump(marker_payload, handle, indent=2)
+        handle.write("\n")
+    command = build_command(paths, stage, input_checkpoint)
+    (paths["report"] / "command.txt").write_text(quote_command(command) + "\n", encoding="utf-8")
+    start = time.time()
+    monitor_log = paths["gpu"].open("w", encoding="utf-8")
+    monitor = subprocess.Popen(
+        [
+            "nvidia-smi",
+            "--query-gpu=timestamp,memory.used,utilization.gpu",
+            "--format=csv,noheader,nounits",
+            "-lms",
+            "500",
+        ],
+        stdout=monitor_log,
+        stderr=subprocess.STDOUT,
+        text=True,
+        start_new_session=True,
+    )
+    with paths["log"].open("w", encoding="utf-8") as training_log:
+        training_log.write(f"$ {quote_command(command)}\n")
+        training_log.flush()
+        proc = subprocess.run(command, stdout=training_log, stderr=subprocess.STDOUT, text=True)
+    end = time.time()
+    try:
+        os.killpg(monitor.pid, signal.SIGTERM)
+        monitor.wait(timeout=5)
+    except (ProcessLookupError, subprocess.TimeoutExpired):
+        monitor.kill()
+    finally:
+        monitor_log.close()
+    log_text = paths["log"].read_text(encoding="utf-8", errors="replace")
+    oom = bool(re.search(r"out of memory|cuda.*oom", log_text, re.IGNORECASE))
+    result: dict[str, Any] = {
+        "schemaVersion": "1.0",
+        "sceneRevisionId": SCENE_REVISION,
+        "stage": stage,
+        "fromScratch": input_checkpoint is None,
+        "inputCheckpoint": {"path": str(input_checkpoint), "sha256": input_hash} if input_checkpoint else None,
+        "command": command,
+        "startEpoch": start,
+        "endEpoch": end,
+        "wallSeconds": round(end - start, 3),
+        "exitCode": proc.returncode,
+        "oom": oom,
+        "peakVramMiB": peak_vram(paths["gpu"]),
+        "startStep": 0 if input_checkpoint is None else PREVIOUS_STAGE[stage],
+        "endStep": None,
+        "outputCheckpoint": None,
+    }
+    if proc.returncode == 0 and not oom:
+        if not paths["checkpoint"].is_file() or not paths["config"].is_file():
+            raise RuntimeError("training exited successfully without the expected checkpoint/config")
+        output_step = int(re.search(r"step-(\d+)\.ckpt$", paths["checkpoint"].name).group(1))
+        result.update(
+            {
+                "endStep": output_step,
+                "outputCheckpoint": {
+                    "path": str(paths["checkpoint"]),
+                    "bytes": paths["checkpoint"].stat().st_size,
+                    "sha256": sha256(paths["checkpoint"]),
+                },
+                "config": str(paths["config"]),
+                "status": "TRAINING_COMPLETE",
+            }
+        )
+        if output_step != stage - 1:
+            raise RuntimeError(f"stage-{stage} ended at unexpected step {output_step}")
+    else:
+        result["status"] = "OOM" if oom else "FAILED"
+    paths["result"].write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    if result["status"] != "TRAINING_COMPLETE":
+        raise RuntimeError(f"stage-{stage} training failed: {result['status']}")
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--stage", type=int, choices=STAGES, required=True)
+    parser.add_argument("--project-root", type=Path, default=Path(__file__).resolve().parents[1])
+    args = parser.parse_args()
+    try:
+        result = execute(args.project_root.resolve(), args.stage)
+    except (RuntimeError, OSError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
+        print(str(exc), file=sys.stderr)
+        return 1
+    print(json.dumps(result, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    import sys
+
+    raise SystemExit(main())
