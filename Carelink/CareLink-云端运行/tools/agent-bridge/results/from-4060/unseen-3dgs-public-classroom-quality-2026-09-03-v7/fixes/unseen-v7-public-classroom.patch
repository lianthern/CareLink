+  }
+  const middle = manifest.photoAnchors.find((anchor) => anchor.id === "frame_0053");
+  await page.locator('[data-photo-anchor-id="frame_0053"]').click();
+  await page.waitForTimeout(900);
+  const beforeWalk = await cameraState(page);
+  await page.locator("#sceneCanvas").click({ position: { x: 500, y: 350 } });
+  await page.keyboard.down("w");
+  await page.waitForTimeout(700);
+  await page.keyboard.up("w");
+  await page.waitForTimeout(200);
+  const walked = await cameraState(page);
