@@ -0,0 +1,134 @@
+#!/usr/bin/env python3
+"""Generate the v7 manifest and safe thumbnails from actual training cameras."""
+
+from __future__ import annotations
+
+import json
+import math
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageOps
+from nerfstudio.utils.eval_utils import eval_setup
+
+from generate_tum_v4_viewer import PLAYCANVAS_FROM_NERFSTUDIO, matrix_to_quaternion_xyzw, rounded
+
+
+SCENE_REVISION = "pexels-classroom-5735358-r001"
+ANCHORS = (
+    ("frame_0001", "frame_00001.jpg", "照片 1 · 首帧"),
+    ("frame_0053", "frame_00053.jpg", "照片 2 · 中段"),
+    ("frame_0105", "frame_00105.jpg", "照片 3 · 末帧"),
+)
+
+
+def camera_pose(camera: object) -> tuple[np.ndarray, float]:
+    saved = camera.camera_to_worlds.detach().cpu().numpy()[0]
+    c2w = np.eye(4, dtype=np.float64)
+    c2w[:3, :4] = saved
+    playcanvas = PLAYCANVAS_FROM_NERFSTUDIO @ c2w
+    height = float(camera.height.detach().cpu().reshape(-1)[0])
+    fy = float(camera.fy.detach().cpu().reshape(-1)[0])
+    fov = math.degrees(2.0 * math.atan(height / (2.0 * fy)))
+    return playcanvas, fov
+
+
+def main() -> int:
+    project_root = Path(__file__).resolve().parents[1]
+    config = project_root / "artifacts/training/v7" / SCENE_REVISION / "pexels-classroom-v7/splatfacto/stage-7000/config.yml"
+    report_root = project_root / "reports/v7" / SCENE_REVISION
+    manifest_path = project_root / "viewer/pexels-classroom-v7.scene.json"
+    validation_path = report_root / "viewer-transform.json"
+    asset_root = project_root / "viewer/assets/v7"
+    thumbnail_paths = [asset_root / f"thumb-{anchor_id}.jpg" for anchor_id, _, _ in ANCHORS]
+    if manifest_path.exists() or validation_path.exists() or any(path.exists() for path in thumbnail_paths):
+        raise SystemExit("refusing to overwrite existing v7 Viewer metadata")
+    _, pipeline, checkpoint, step = eval_setup(config, test_mode="test")
+    if step != 6999:
+        raise SystemExit(f"unexpected best checkpoint step: {step}")
+    datamanager = pipeline.datamanager
+    _ = datamanager.cached_train
+    _ = datamanager.cached_eval
+    camera_by_name: dict[str, object] = {}
+    all_positions: list[np.ndarray] = []
+    for dataset in (datamanager.train_dataset, datamanager.eval_dataset):
+        for index, image_path in enumerate(dataset.image_filenames):
+            camera = dataset.cameras[index : index + 1]
+            camera_by_name[image_path.name] = camera
+            pose, _ = camera_pose(camera)
+            all_positions.append(pose[:3, 3])
+    missing = {name for _, name, _ in ANCHORS} - camera_by_name.keys()
+    if missing:
+        raise SystemExit(f"actual training cameras are missing anchors: {sorted(missing)}")
+    asset_root.mkdir(parents=True, exist_ok=True)
+    anchors: list[dict[str, object]] = []
+    for (anchor_id, image_name, label), thumbnail_path in zip(ANCHORS, thumbnail_paths):
+        pose, fov = camera_pose(camera_by_name[image_name])
+        source_path = report_root / "stages/7000/anchors" / f"{Path(image_name).stem}-source.png"
+        with Image.open(source_path) as image:
+            thumbnail = ImageOps.fit(image.convert("RGB"), (320, 180), method=Image.Resampling.LANCZOS)
+            thumbnail.save(thumbnail_path, format="JPEG", quality=76, optimize=True)
+        anchors.append(
+            {
+                "id": anchor_id,
+                "label": label,
+                "sceneRevisionId": SCENE_REVISION,
+                "position": rounded(pose[:3, 3]),
+                "quaternion": rounded(np.asarray(matrix_to_quaternion_xyzw(pose[:3, :3]))),
+                "fov": round(fov, 9),
+                "sourceFrame": image_name,
+                "thumbnail": f"./assets/v7/thumb-{anchor_id}.jpg",
+            }
+        )
+    positions = np.asarray(all_positions)
+    margin = 0.15
+    boundary = [
+        [round(float(positions[:, 0].min() - margin), 9), round(float(positions[:, 2].min() - margin), 9)],
+        [round(float(positions[:, 0].max() + margin), 9), round(float(positions[:, 2].min() - margin), 9)],
+        [round(float(positions[:, 0].max() + margin), 9), round(float(positions[:, 2].max() + margin), 9)],
+        [round(float(positions[:, 0].min() - margin), 9), round(float(positions[:, 2].max() + margin), 9)],
+    ]
+    start = anchors[1]
+    manifest = {
+        "$schema": "./scene.schema.json",
+        "sceneRevisionId": SCENE_REVISION,
+        "name": "Pexels classroom · v7 local quality scene",
+        "sceneAsset": {
+            "url": "./assets/v7/pexels-classroom-v7.scene.sog",
+            "format": "sog",
+            "required": True,
+            "position": [0.0, 0.0, 0.0],
+            "rotationEuler": [-90.0, 0.0, 0.0],
+            "scale": 1.0,
+        },
+        "backgroundColor": [0.15, 0.15, 0.15],
+        "defaultPhotoAnchorId": "frame_0053",
+        "navigation": {
+            "eyeHeight": start["position"][1],
+            "moveSpeed": 0.15,
+            "lookSensitivity": 0.11,
+            "boundaryXZ": boundary,
+            "startPose": {"position": start["position"], "quaternion": start["quaternion"], "fov": start["fov"]},
+        },
+        "photoAnchors": anchors,
+    }
+    manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+    validation = {
+        "status": "PASS",
+        "sceneRevisionId": SCENE_REVISION,
+        "checkpoint": str(checkpoint),
+        "step": step,
+        "cameraSource": "Nerfstudio train/eval Cameras after cache undistortion plus dataparser transform and scale",
+        "coordinateConversion": "c2w_pc = Rx(-90deg) @ c2w_nerfstudio",
+        "anchorCount": len(anchors),
+        "anchors": anchors,
+        "boundaryXZ": boundary,
+        "photoModePreservesAnchorY": True,
+    }
+    validation_path.write_text(json.dumps(validation, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+    print(json.dumps(validation, indent=2, ensure_ascii=False))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
