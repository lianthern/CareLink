+  await page.locator('[data-photo-anchor-id="frame_0053"]').click();
+  await page.waitForTimeout(1000);
+  const returned = await cameraState(page);
+  const returnErrors = {
+    positionMaxAbs: maxAbs(returned.position, middle.position),
+    quaternionMaxAbs: Math.min(
+      maxAbs(returned.quaternion, middle.quaternion),
+      maxAbs(returned.quaternion, middle.quaternion.map((value) => -value))
