+#!/usr/bin/env python3
+"""Build safe side-by-side source-thumbnail and Viewer-render comparisons."""
+
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont
+
+
+ROOT = Path(__file__).resolve().parents[1]
+ASSET_DIR = ROOT / "viewer" / "assets" / "v7"
+REPORT_DIR = ROOT / "reports" / "v7" / "pexels-classroom-5735358-r001"
+RENDER_DIR = REPORT_DIR / "viewer-renders"
+ANCHORS = ("0001", "0053", "0105")
+
+
+def fit(image: Image.Image, width: int, height: int) -> Image.Image:
+    copy = image.copy()
+    copy.thumbnail((width, height), Image.Resampling.LANCZOS)
+    return copy
+
+
+def build(anchor: str) -> Path:
+    source_path = ASSET_DIR / f"thumb-frame_{anchor}.jpg"
+    render_path = RENDER_DIR / f"frame_{anchor}-render.png"
+    output_path = REPORT_DIR / f"anchor-{anchor}-compare.jpg"
+
+    with Image.open(source_path) as source_raw, Image.open(render_path) as render_raw:
+        source = fit(source_raw.convert("RGB"), 640, 500)
+        render = fit(render_raw.convert("RGB"), 640, 500)
+
+    canvas = Image.new("RGB", (1328, 572), "#101820")
+    draw = ImageDraw.Draw(canvas)
+    font = ImageFont.load_default(size=18)
+    draw.text((24, 18), f"frame_{anchor} - safe source thumbnail", fill="#f1c27d", font=font)
+    draw.text((688, 18), f"frame_{anchor} - SOG Viewer render", fill="#f1c27d", font=font)
+
+    for image, left in ((source, 24), (render, 688)):
+        top = 52 + (500 - image.height) // 2
+        canvas.paste(image, (left + (640 - image.width) // 2, top))
+        draw.rectangle((left - 1, 51, left + 640, 552), outline="#44515c", width=1)
+
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    canvas.save(output_path, "JPEG", quality=92, optimize=True)
+    return output_path
+
+
+def main() -> None:
+    for anchor in ANCHORS:
+        print(build(anchor))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/evaluate_v7_stage.py b/scripts/evaluate_v7_stage.py
new file mode 100644
index 0000000000000000000000000000000000000000..374f2589fe74f85711b0aaaddaa69d672038d50a
--- /dev/null
+++ b/scripts/evaluate_v7_stage.py
@@ -0,0 +1,186 @@
+#!/usr/bin/env python3
+"""Score v7 training anchors and the frozen held-out split for one stage."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import torch
+from PIL import Image
+from nerfstudio.utils.eval_utils import eval_setup
+
+
+ANCHORS = ("frame_00001.jpg", "frame_00053.jpg", "frame_00105.jpg")
+ANCHOR_THRESHOLDS = {"psnr": 20.0, "ssim": 0.78, "lpips": 0.30}
+HELDOUT_THRESHOLDS = {"psnr": 18.0, "ssim": 0.65, "lpips": 0.40}
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(4 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def save_rgb(path: Path, tensor: torch.Tensor) -> None:
+    array = tensor.detach().cpu().clamp(0.0, 1.0).mul(255.0).round().to(torch.uint8).numpy()
+    Image.fromarray(array).save(path)
+
+
+def render_metrics(model: Any, camera: Any, batch: dict[str, Any]) -> tuple[dict[str, float], torch.Tensor]:
+    with torch.no_grad():
+        outputs = model.get_outputs_for_camera(camera)
+        metrics, _ = model.get_image_metrics_and_images(outputs, batch)
+    return {key: float(metrics[key]) for key in ("psnr", "ssim", "lpips")}, outputs["rgb"]
+
+
+def metric_means(rows: list[dict[str, Any]]) -> dict[str, float]:
+    return {key: float(np.mean([float(row[key]) for row in rows])) for key in ("psnr", "ssim", "lpips")}
+
+
+def hard_gate(anchors: list[dict[str, Any]], heldout_means: dict[str, float]) -> dict[str, Any]:
+    anchor_pass = all(
+        row["psnr"] >= ANCHOR_THRESHOLDS["psnr"]
+        and row["ssim"] >= ANCHOR_THRESHOLDS["ssim"]
+        and row["lpips"] <= ANCHOR_THRESHOLDS["lpips"]
+        for row in anchors
+    )
+    heldout_pass = (
+        heldout_means["psnr"] >= HELDOUT_THRESHOLDS["psnr"]
+        and heldout_means["ssim"] >= HELDOUT_THRESHOLDS["ssim"]
+        and heldout_means["lpips"] <= HELDOUT_THRESHOLDS["lpips"]
+    )
+    return {
+        "anchorThresholds": ANCHOR_THRESHOLDS,
+        "heldOutThresholds": HELDOUT_THRESHOLDS,
+        "anchorsPass": anchor_pass,
+        "heldOutPass": heldout_pass,
+        "pass": anchor_pass and heldout_pass,
+    }
+
+
+def compare_to_previous(current: dict[str, Any], previous: dict[str, Any]) -> dict[str, Any]:
+    previous_by_frame = {row["frame"]: row for row in previous["anchors"]}
+    nonregression = []
+    for row in current["anchors"]:
+        old = previous_by_frame[row["frame"]]
+        passed = row["psnr"] >= old["psnr"] - 0.5 and row["ssim"] >= old["ssim"] - 0.03 and row["lpips"] <= old["lpips"] + 0.03
+        nonregression.append(
+            {
+                "frame": row["frame"],
+                "psnrDelta": row["psnr"] - old["psnr"],
+                "ssimDelta": row["ssim"] - old["ssim"],
+                "lpipsDelta": row["lpips"] - old["lpips"],
+                "pass": passed,
+            }
+        )
+    mean_delta = {
+        key: current["heldOutMeans"][key] - previous["heldOutMeans"][key]
+        for key in ("psnr", "ssim", "lpips")
+    }
+    material = mean_delta["psnr"] >= 0.25 or mean_delta["ssim"] >= 0.01 or mean_delta["lpips"] <= -0.01
+    return {
+        "perAnchorNonRegression": nonregression,
+        "allAnchorsNonRegression": all(row["pass"] for row in nonregression),
+        "heldOutMeanDelta": mean_delta,
+        "materialImprovement": material,
+        "pass": all(row["pass"] for row in nonregression) and material,
+    }
+
+
+def execute(project_root: Path, stage: int) -> dict[str, Any]:
+    report_root = project_root / "reports/v7/pexels-classroom-5735358-r001/stages" / str(stage)
+    stage_result_path = report_root / "stage-result.json"
+    stage_result = json.loads(stage_result_path.read_text(encoding="utf-8"))
+    if stage_result.get("status") != "TRAINING_COMPLETE":
+        raise RuntimeError("stage training result is not complete")
+    checkpoint = Path(stage_result["outputCheckpoint"]["path"])
+    if sha256(checkpoint) != stage_result["outputCheckpoint"]["sha256"]:
+        raise RuntimeError("stage checkpoint SHA256 changed before evaluation")
+    output_path = report_root / "evaluation.json"
+    decision_path = report_root / "gate-decision.json"
+    anchors_dir = report_root / "anchors"
+    if output_path.exists() or decision_path.exists() or anchors_dir.exists():
+        raise RuntimeError(f"refusing to overwrite stage-{stage} evaluation")
+    anchors_dir.mkdir()
+    config_path = Path(stage_result["config"])
+    _, pipeline, loaded_checkpoint, loaded_step = eval_setup(config_path, test_mode="test")
+    if loaded_checkpoint != checkpoint or loaded_step != stage - 1:
+        raise RuntimeError(f"evaluation loaded unexpected checkpoint: {loaded_checkpoint} step {loaded_step}")
+    datamanager = pipeline.datamanager
+    model = pipeline.model
+    # FullImageDatamanager crops/undistorts cached images and updates camera
+    # intrinsics in place. Materialize each cache before slicing its cameras.
+    cached_train = datamanager.cached_train
+    train_names = [path.name for path in datamanager.train_dataset.image_filenames]
+    anchor_rows: list[dict[str, Any]] = []
+    for anchor in ANCHORS:
+        if anchor not in train_names:
+            raise RuntimeError(f"contract anchor is not in train split: {anchor}")
+        index = train_names.index(anchor)
+        camera = datamanager.train_dataset.cameras[index : index + 1].to(pipeline.device)
+        batch = cached_train[index]
+        metrics, rendered = render_metrics(model, camera, batch)
+        source = model.get_gt_img(batch["image"])
+        save_rgb(anchors_dir / f"{Path(anchor).stem}-checkpoint.png", rendered)
+        save_rgb(anchors_dir / f"{Path(anchor).stem}-source.png", source)
+        anchor_rows.append({"frame": Path(anchor).stem, "trainIndex": index, **metrics})
+    cached_eval = datamanager.cached_eval
+    eval_names = [path.name for path in datamanager.eval_dataset.image_filenames]
+    heldout_rows: list[dict[str, Any]] = []
+    for index, name in enumerate(eval_names):
+        camera = datamanager.eval_dataset.cameras[index : index + 1].to(pipeline.device)
+        batch = cached_eval[index]
+        metrics, _ = render_metrics(model, camera, batch)
+        heldout_rows.append({"frame": Path(name).stem, "evalIndex": index, **metrics})
+    result: dict[str, Any] = {
+        "schemaVersion": "1.0",
+        "stage": stage,
+        "checkpoint": str(loaded_checkpoint),
+        "checkpointSha256": stage_result["outputCheckpoint"]["sha256"],
+        "step": loaded_step,
+        "anchors": anchor_rows,
+        "anchorMeans": metric_means(anchor_rows),
+        "heldOut": heldout_rows,
+        "heldOutMeans": metric_means(heldout_rows),
+    }
+    result["hardGate"] = hard_gate(anchor_rows, result["heldOutMeans"])
+    comparison = None
+    replace_previous = bool(result["hardGate"]["pass"])
+    if stage > 7000:
+        previous_stage = 7000 if stage == 15000 else 15000
+        previous_path = report_root.parent / str(previous_stage) / "evaluation.json"
+        comparison = compare_to_previous(result, json.loads(previous_path.read_text(encoding="utf-8")))
+        replace_previous = bool(result["hardGate"]["pass"] and comparison["pass"])
+    result["comparisonToPrevious"] = comparison
+    output_path.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    decision = {
+        "stage": stage,
+        "hardGatePass": bool(result["hardGate"]["pass"]),
+        "replacePrevious": replace_previous,
+        "allowNextStage": bool(replace_previous and stage < 30000),
+        "bestStageAfterEvaluation": stage if replace_previous else (None if stage == 7000 else (7000 if stage == 15000 else 15000)),
+        "comparisonBasis": "per-anchor non-regression and held-out mean material improvement" if stage > 7000 else "v7 hard gates",
+    }
+    decision_path.write_text(json.dumps(decision, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"evaluation": result, "decision": decision}, indent=2))
+    return result
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--stage", type=int, choices=(7000, 15000, 30000), required=True)
+    parser.add_argument("--project-root", type=Path, default=Path(__file__).resolve().parents[1])
+    args = parser.parse_args()
+    execute(args.project_root.resolve(), args.stage)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
