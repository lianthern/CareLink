+    url,
+    sceneState: await page.locator("#sceneState").innerText(),
+    fpsSample: Number(await page.locator("#fpsValue").innerText()),
+    manifestSceneRevisionId: manifest.sceneRevisionId,
+    buttonCount,
+    thumbnails,
+    anchorChecks,
+    walk: { beforeWalk, walked, movementDistance, returned, returnErrors },
+    consoleErrors,
+    checks,
+  };
+  fs.writeFileSync(resultPath, JSON.stringify(result, null, 2) + "\n");
+  console.log(JSON.stringify(result, null, 2));
+  await browser.close();
+  if (result.status !== "PASS") process.exitCode = 1;
+})().catch((error) => {
+  console.error(error.stack || String(error));
+  process.exitCode = 1;
+});
