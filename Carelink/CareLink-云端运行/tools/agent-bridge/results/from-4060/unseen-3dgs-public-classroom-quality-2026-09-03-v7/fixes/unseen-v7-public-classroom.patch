+#!/usr/bin/env python3
+"""Contract tests for the v7 public classroom processor."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+import process_v7_classroom as v7
+
+
+JOB_ID = "local-20260903T022428Z-ce09410a"
+
+
+class V7ProcessorTests(unittest.TestCase):
+    def test_metadata_path_escape_and_symlink_are_rejected(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            project = Path(temporary)
+            intake = project / "data/local-intake" / JOB_ID
+            intake.mkdir(parents=True)
+            outside = project / "outside.mp4"
+            outside.write_bytes(b"video")
+            escaped = {
+                "jobId": JOB_ID,
+                "status": "UPLOADED_VALIDATED_AWAITING_EXPLICIT_PREVIEW",
+                "source": {"localPath": str(outside.absolute())},
+            }
+            with self.assertRaisesRegex(RuntimeError, "escapes"):
+                v7.validate_intake_metadata_path(project, JOB_ID, escaped)
+
+            source = intake / "source.mp4"
+            source.symlink_to(outside)
+            linked = {
+                "jobId": JOB_ID,
+                "status": "UPLOADED_VALIDATED_AWAITING_EXPLICIT_PREVIEW",
+                "source": {"localPath": str(source.absolute())},
+            }
+            with self.assertRaisesRegex(RuntimeError, "symlink"):
+                v7.validate_intake_metadata_path(project, JOB_ID, linked)
+
+    def test_frame_contract_is_deterministic_and_byte_checked(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            source = root / "source.mp4"
+            source.write_bytes(b"source")
+            frame_dir = root / "frames"
+            frame_dir.mkdir()
+            for index in range(1, 4):
+                (frame_dir / f"frame_{index:04d}.jpg").write_bytes(bytes([index]))
+            expected_a = v7.build_frame_contract(source, 3, 1280)
+            expected_b = v7.build_frame_contract(source, 3, 1280)
+            self.assertEqual(expected_a, expected_b)
+            actual = v7.add_frame_hashes(expected_a, frame_dir, 3)
+            contract_path = root / "frames.contract.json"
+            contract_path.write_text(json.dumps(actual), encoding="utf-8")
+            v7.verify_frame_contract(contract_path, frame_dir, expected_a)
+            (frame_dir / "frame_0002.jpg").write_bytes(b"changed")
+            with self.assertRaisesRegex(RuntimeError, "frame bytes"):
+                v7.verify_frame_contract(contract_path, frame_dir, expected_a)
+
+    def test_colmap_summary_parser(self) -> None:
+        text = """Cameras: 1
+Images: 105
+Registered images: 105
+Points: 8026
+Observations: 165125
+Mean track length: 20.573760
+Mean observations per image: 1572.619048
+Mean reprojection error: 1.026420px
+"""
+        parsed = v7.parse_model_analyzer(text)
+        self.assertEqual(parsed["registeredImages"], 105)
+        self.assertEqual(parsed["points"], 8026)
+        self.assertAlmostEqual(float(parsed["meanTrackLength"]), 20.573760)
+        self.assertAlmostEqual(float(parsed["meanReprojectionErrorPx"]), 1.026420)
+
+    def test_full_time_coverage_gate(self) -> None:
+        rows = [
+            {
+                "name": f"frame_{index:04d}.jpg",
+                "qvec": (1.0, 0.0, 0.0, 0.0),
+                "tvec": (-float(index), 0.0, 0.0),
+            }
+            for index in range(1, 106)
+        ]
+        self.assertTrue(v7.coverage_gate(rows, 105)["pass"])
+        without_middle = [row for row in rows if row["name"] != "frame_0053.jpg"]
+        self.assertFalse(v7.coverage_gate(without_middle, 105)["pass"])
+
+    def test_camera_gate_rejects_principal_point_drift(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            camera_path = Path(temporary) / "cameras.txt"
+            camera_path.write_text(
+                "1 SIMPLE_RADIAL 1280 720 1072.494661 640 360 -0.0358097\n",
+                encoding="utf-8",
+            )
+            self.assertTrue(v7.read_camera_gate(camera_path)["pass"])
+            camera_path.write_text(
+                "1 SIMPLE_RADIAL 1280 720 1090.92 677.94 460.46 -0.02895\n",
+                encoding="utf-8",
+            )
+            self.assertFalse(v7.read_camera_gate(camera_path)["pass"])
+
+    def test_explicit_split_keeps_photo_anchors_in_training(self) -> None:
+        transforms = {
+            "frames": [
+                {"file_path": f"images/frame_{index:05d}.jpg"}
+                for index in range(1, 106)
+            ]
+        }
+        summary = v7.apply_explicit_split(transforms)
+        self.assertEqual(summary["trainCount"], 95)
+        self.assertEqual(summary["heldOutCount"], 10)
+        self.assertTrue(set(summary["anchorFilenames"]).issubset(transforms["train_filenames"]))
+        self.assertTrue(set(transforms["test_filenames"]).isdisjoint(summary["anchorFilenames"]))
+
+    def test_existing_output_is_refused(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            project = Path(temporary)
+            paths = v7.scene_paths(project, v7.EXPECTED_SCENE_REVISION)
+            paths["data"].mkdir(parents=True)
+            with self.assertRaisesRegex(RuntimeError, "existing v7 output"):
+                v7.assert_output_absent(paths)
+
+    def test_dry_run_does_not_create_training_marker_or_output(self) -> None:
+        with tempfile.TemporaryDirectory() as temporary:
+            project = Path(temporary)
+            intake = project / "data/local-intake" / JOB_ID
+            intake.mkdir(parents=True)
+            source = intake / "source.mp4"
+            content = b"frozen-test-video"
+            source.write_bytes(content)
+            digest = hashlib.sha256(content).hexdigest()
+            metadata = {
+                "jobId": JOB_ID,
+                "status": "UPLOADED_VALIDATED_AWAITING_EXPLICIT_PREVIEW",
+                "source": {
+                    "localPath": str(source.absolute()),
+                    "bytes": len(content),
+                    "sha256": digest,
+                    "ffprobe": {"normalizedDurationSeconds": v7.EXPECTED_DURATION_SECONDS},
+                },
+            }
+            (intake / "intake.json").write_text(json.dumps(metadata), encoding="utf-8")
+            args = argparse.Namespace(
+                project_root=project,
+                intake_job_id=JOB_ID,
+                scene_revision_id=v7.EXPECTED_SCENE_REVISION,
+                max_frames=105,
+                max_width=1280,
+                dry_run=True,
+            )
+            with mock.patch.multiple(
+                v7,
+                EXPECTED_SOURCE_BYTES=len(content),
+                EXPECTED_SOURCE_SHA256=digest,
+            ):
+                result = v7.execute(args)
+            paths = v7.scene_paths(project, v7.EXPECTED_SCENE_REVISION)
+            self.assertTrue(result["dryRun"])
+            self.assertFalse(paths["training_marker"].exists())
+            self.assertFalse(paths["data"].exists())
+            self.assertFalse(paths["report"].exists())
+
+
+if __name__ == "__main__":
+    unittest.main()
