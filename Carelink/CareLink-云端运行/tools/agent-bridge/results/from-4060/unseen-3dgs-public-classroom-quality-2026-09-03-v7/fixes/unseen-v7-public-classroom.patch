+  };
+  await page.screenshot({ path: overviewPath, type: "png" });
+  const checks = {
+    sogReady: (await page.locator("#sceneState").innerText()).includes("SOG ready"),
+    threePhotoButtons: buttonCount === 3,
+    threeSafeThumbnails:
+      thumbnails.length === 3 && thumbnails.every((image) => image.complete && image.width === 320 && image.height === 180),
+    allAnchorsRestoreWithinGate: anchorChecks.every((row) => row.pass),
+    boundedWalkMoved: movementDistance > 0.005,
