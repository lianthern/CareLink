+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import tarfile
+import tempfile
+import unittest
+from pathlib import Path
+
+from safe_extract_tum import validate_member
+
+
+class SafeExtractionTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.temporary = tempfile.TemporaryDirectory()
+        self.destination = Path(self.temporary.name).resolve() / "raw"
+
+    def tearDown(self) -> None:
+        self.temporary.cleanup()
+
+    def test_regular_relative_member_is_allowed(self) -> None:
+        validate_member(tarfile.TarInfo("dataset/rgb.txt"), self.destination)
+
+    def test_absolute_and_parent_paths_are_rejected(self) -> None:
+        for name in ("/tmp/escape", "dataset/../../escape", "dataset\\escape"):
+            with self.subTest(name=name), self.assertRaises(RuntimeError):
+                validate_member(tarfile.TarInfo(name), self.destination)
+
+    def test_links_are_rejected(self) -> None:
+        for member_type in (tarfile.SYMTYPE, tarfile.LNKTYPE):
+            member = tarfile.TarInfo("dataset/link")
+            member.type = member_type
+            with self.subTest(member_type=member_type), self.assertRaises(RuntimeError):
+                validate_member(member, self.destination)
+
+
+if __name__ == "__main__":
+    unittest.main()
