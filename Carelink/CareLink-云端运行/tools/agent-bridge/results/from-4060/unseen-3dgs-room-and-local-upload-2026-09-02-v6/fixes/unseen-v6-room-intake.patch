diff --git a/scripts/download_https_ranges.py b/scripts/download_https_ranges.py
new file mode 100644
index 0000000..60416f9
--- /dev/null
+++ b/scripts/download_https_ranges.py
@@ -0,0 +1,192 @@
+#!/usr/bin/env python3
+"""Resume a large HTTPS file with validated parallel byte ranges."""
+
+from __future__ import annotations
+
+import argparse
+import concurrent.futures
+import json
+import os
+import re
+import ssl
+import threading
+import time
+import urllib.request
+from pathlib import Path
+
+
+def download_segment(
+    url: str,
+    path: Path,
+    start: int,
+    end: int,
+    attempts: int,
+) -> dict[str, object]:
+    expected = end - start + 1
+    headers_seen: dict[str, str] = {}
+    effective_url = url
+    for attempt in range(1, attempts + 1):
+        have = path.stat().st_size if path.exists() else 0
+        if have == expected:
+            return {
+                "path": str(path),
+                "start": start,
+                "end": end,
+                "bytes": have,
+                "effectiveUrl": effective_url,
+                "headers": headers_seen,
+                "attempts": attempt - 1,
+            }
+        if have > expected:
+            raise RuntimeError(f"oversized range part: {path} ({have} > {expected})")
+        request_start = start + have
+        request = urllib.request.Request(
+            url,
+            headers={
+                "Range": f"bytes={request_start}-{end}",
+                "User-Agent": "UNSEEN-v6-official-fixture-downloader/1.0",
+            },
+        )
+        try:
+            with urllib.request.urlopen(request, timeout=60, context=ssl.create_default_context()) as response:
+                if response.status != 206:
+                    raise RuntimeError(f"range request returned HTTP {response.status}")
+                content_range = response.headers.get("Content-Range", "")
+                match = re.fullmatch(r"bytes (\d+)-(\d+)/(\d+)", content_range)
+                if not match or (int(match[1]), int(match[2])) != (request_start, end):
+                    raise RuntimeError(f"unexpected Content-Range: {content_range!r}")
+                effective_url = response.geturl()
+                headers_seen = {key.lower(): value for key, value in response.headers.items()}
+                with path.open("ab") as destination:
+                    while True:
+                        block = response.read(1024 * 1024)
+                        if not block:
+                            break
+                        destination.write(block)
+            if path.stat().st_size == expected:
+                return {
+                    "path": str(path),
+                    "start": start,
+                    "end": end,
+                    "bytes": expected,
+                    "effectiveUrl": effective_url,
+                    "headers": headers_seen,
+                    "attempts": attempt,
+                }
+        except Exception:
+            if attempt == attempts:
+                raise
+            time.sleep(min(2**attempt, 15))
+    raise RuntimeError(f"range did not complete: {path}")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--url", required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--expected-bytes", type=int, required=True)
+    parser.add_argument("--connections", type=int, default=8)
+    parser.add_argument("--attempts", type=int, default=8)
+    parser.add_argument("--metadata", type=Path, required=True)
+    args = parser.parse_args()
+    if not args.url.startswith("https://"):
+        parser.error("--url must use HTTPS")
+    if args.expected_bytes <= 0:
+        parser.error("--expected-bytes must be positive")
+    if not 1 <= args.connections <= 16:
+        parser.error("--connections must be in the range 1..16")
+    if args.output.suffix != ".part":
+        parser.error("--output must retain a .part suffix until separately verified")
+
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.metadata.parent.mkdir(parents=True, exist_ok=True)
+    segment_dir = args.output.parent / f"{args.output.name}.segments"
+    segment_dir.mkdir(exist_ok=True)
+    ranges = []
+    for index in range(args.connections):
+        start = args.expected_bytes * index // args.connections
+        end = args.expected_bytes * (index + 1) // args.connections - 1
+        ranges.append((index, start, end))
+
+    first_part = segment_dir / "segment-000.part"
+    if args.output.exists() and not any(segment_dir.iterdir()):
+        if args.output.stat().st_size > ranges[0][2] - ranges[0][1] + 1:
+            raise RuntimeError("existing sequential partial is larger than the first range")
+        os.replace(args.output, first_part)
+
+    started = time.time()
+    stop_progress = threading.Event()
+
+    def progress() -> None:
+        while not stop_progress.wait(10):
+            downloaded = sum(path.stat().st_size for path in segment_dir.glob("segment-*.part"))
+            print(
+                json.dumps(
+                    {
+                        "downloadedBytes": downloaded,
+                        "expectedBytes": args.expected_bytes,
+                        "percent": round(100.0 * downloaded / args.expected_bytes, 3),
+                    }
+                ),
+                flush=True,
+            )
+
+    progress_thread = threading.Thread(target=progress, daemon=True)
+    progress_thread.start()
+    rows = []
+    try:
+        with concurrent.futures.ThreadPoolExecutor(max_workers=args.connections) as pool:
+            futures = [
+                pool.submit(
+                    download_segment,
+                    args.url,
+                    segment_dir / f"segment-{index:03d}.part",
+                    start,
+                    end,
+                    args.attempts,
+                )
+                for index, start, end in ranges
+            ]
+            for future in concurrent.futures.as_completed(futures):
+                rows.append(future.result())
+    finally:
+        stop_progress.set()
+        progress_thread.join()
+
+    assembling = args.output.with_name(f"{args.output.name}.assembling")
+    with assembling.open("wb") as destination:
+        for index, start, end in ranges:
+            path = segment_dir / f"segment-{index:03d}.part"
+            expected = end - start + 1
+            if path.stat().st_size != expected:
+                raise RuntimeError(f"incomplete segment before assembly: {path}")
+            with path.open("rb") as source:
+                while True:
+                    block = source.read(1024 * 1024)
+                    if not block:
+                        break
+                    destination.write(block)
+    if assembling.stat().st_size != args.expected_bytes:
+        raise RuntimeError("assembled byte length does not match --expected-bytes")
+    os.replace(assembling, args.output)
+
+    finished = time.time()
+    result = {
+        "schemaVersion": "1.0",
+        "sourceUrl": args.url,
+        "effectiveUrls": sorted({str(row["effectiveUrl"]) for row in rows}),
+        "expectedBytes": args.expected_bytes,
+        "actualBytes": args.output.stat().st_size,
+        "connections": args.connections,
+        "startedEpoch": started,
+        "finishedEpoch": finished,
+        "wallSeconds": finished - started,
+        "segments": sorted(rows, key=lambda row: int(row["start"])),
+    }
+    args.metadata.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
