diff --git a/scripts/intake_e2e.js b/scripts/intake_e2e.js
new file mode 100644
index 0000000..a2805a9
--- /dev/null
+++ b/scripts/intake_e2e.js
@@ -0,0 +1,61 @@
+const fs = require("fs");
+const { chromium } = require("playwright");
+
+const args = process.argv.slice(2);
+if (args.length !== 3) {
+  console.error("Usage: node intake_e2e.js <intake-url> <result-json> <screenshot-png>");
+  process.exit(2);
+}
+
+(async () => {
+  const [url, resultPath, screenshotPath] = args;
+  const parsed = new URL(url);
+  if (parsed.hostname !== "127.0.0.1" || Number(parsed.port) < 8780 || Number(parsed.port) > 8789) {
+    throw new Error("refusing to test a non-loopback or out-of-contract intake URL");
+  }
+  const browser = await chromium.launch({
+    headless: true,
+    executablePath:
+      process.env.CHROME_PATH || "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
+  });
+  const page = await browser.newPage({ viewport: { width: 1100, height: 760 }, deviceScaleFactor: 1 });
+  const consoleErrors = [];
+  page.on("console", (message) => {
+    if (message.type() === "error") consoleErrors.push(message.text());
+  });
+  page.on("pageerror", (error) => consoleErrors.push(error.message));
+  await page.route("**/favicon.ico", (route) => route.fulfill({ status: 204, body: "" }));
+  const response = await page.goto(url, { waitUntil: "networkidle" });
+  const health = await page.evaluate(() => fetch("/api/health").then((result) => result.json()));
+  const title = await page.title();
+  const heading = await page.locator("h1").innerText();
+  const body = await page.locator("body").innerText();
+  const accept = await page.locator("#file").getAttribute("accept");
+  await page.screenshot({ path: screenshotPath, type: "png", fullPage: true });
+  const checks = {
+    http200: response && response.status() === 200,
+    expectedTitle: title === "UNSEEN 本机视频入口",
+    expectedHeading: heading === "把视频送进 WSL",
+    localOnlyDisclosure: body.includes("不经过 GitHub、iCloud 或生产服务器"),
+    noAutoTrainDisclosure: body.includes("不会自动训练"),
+    mp4AndMovOnly: accept.includes(".mp4") && accept.includes(".mov"),
+    healthReady: health.status === "READY",
+    loopbackOnly: health.bindAddress === "127.0.0.1",
+    trainingDoesNotStartAutomatically: health.trainingStartsAutomatically === false,
+    noConsoleErrors: consoleErrors.length === 0,
+  };
+  const result = {
+    status: Object.values(checks).every(Boolean) ? "PASS" : "FAIL",
+    url,
+    title,
+    heading,
+    health,
+    consoleErrors,
+    checks,
+    privateVideoSelectedOrUploaded: false,
+  };
+  fs.writeFileSync(resultPath, JSON.stringify(result, null, 2) + "\n");
+  console.log(JSON.stringify(result, null, 2));
+  await browser.close();
+  if (result.status !== "PASS") process.exitCode = 1;
+})();
diff --git a/scripts/run_tum_room_v6_train.sh b/scripts/run_tum_room_v6_train.sh
new file mode 100644
index 0000000..50e3a84
--- /dev/null
+++ b/scripts/run_tum_room_v6_train.sh
@@ -0,0 +1,100 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+project_root="/home/max/src/unseen-3dgs-sceneworker"
+data_root="$project_root/data/tum-room-v6/processed/room-2.5hz"
+output_root="$project_root/artifacts/training/tum-room-v6"
+experiment_name="tum-freiburg1-room-v6"
+report_root="$project_root/reports/tum-room-v6"
+log_root="$report_root/logs"
+attempt_marker="$report_root/training-attempt-7000.started"
+
+[[ -f "$data_root/transforms.json" ]] || { echo "missing v6 adapter output" >&2; exit 1; }
+[[ -f "$data_root/adapter-validation.json" ]] || {
+  echo "missing v6 adapter validation" >&2
+  exit 1
+}
+python3 - "$data_root/adapter-validation.json" <<'PY'
+import json
+import sys
+
+validation = json.load(open(sys.argv[1], encoding="utf-8"))
+if validation.get("status") != "PASS":
+    raise SystemExit("adapter validation status is not PASS")
+if validation.get("selectedFrames") != 120 or validation.get("uniqueRgbFrames") != 120:
+    raise SystemExit("adapter did not produce 120 unique RGB frames")
+if not all(validation.get("checks", {}).values()):
+    raise SystemExit("one or more adapter gate checks failed")
+PY
+if pgrep -af '[n]s-train|[c]olmap|[n]s-export' >/dev/null; then
+  echo "refusing to overlap another training, COLMAP, or export process" >&2
+  pgrep -af '[n]s-train|[c]olmap|[n]s-export' >&2 || true
+  exit 1
+fi
+[[ ! -e "$output_root/$experiment_name" ]] || {
+  echo "refusing to launch a second v6 training run: output already exists" >&2
+  exit 1
+}
+[[ ! -e "$attempt_marker" ]] || {
+  echo "refusing to launch a second v6 training run: attempt marker already exists" >&2
+  exit 1
+}
+mkdir -p "$output_root" "$log_root"
+set -o noclobber
+printf 'started_at=%s\niterations=7000\n' "$(date --utc --iso-8601=seconds)" >"$attempt_marker"
+set +o noclobber
+
+# shellcheck disable=SC1091
+source "$project_root/.venv/bin/activate"
+
+nvidia-smi --query-gpu=timestamp,memory.used,utilization.gpu \
+  --format=csv,noheader,nounits -lms 500 >"$log_root/gpu-samples.csv" &
+monitor_pid=$!
+cleanup() {
+  kill "$monitor_pid" 2>/dev/null || true
+  wait "$monitor_pid" 2>/dev/null || true
+}
+trap cleanup EXIT
+
+start_epoch=$(date +%s)
+set +e
+/usr/bin/time -v ns-train splatfacto \
+  --output-dir "$output_root" \
+  --experiment-name "$experiment_name" \
+  --max-num-iterations 7000 \
+  --steps-per-save 2000 \
+  --steps-per-eval-image 100000 \
+  --steps-per-eval-all-images 100000 \
+  --vis tensorboard \
+  --pipeline.model.use-scale-regularization True \
+  --pipeline.model.random-init False \
+  nerfstudio-data \
+  --data "$data_root" \
+  --load-3D-points True \
+  --orientation-method up \
+  --center-method poses \
+  --auto-scale-poses True \
+  2>&1 | tee "$log_root/train.log"
+train_status=${PIPESTATUS[0]}
+set -e
+end_epoch=$(date +%s)
+cleanup
+trap - EXIT
+
+oom=false
+if grep -Eiq 'out of memory|cuda.*oom' "$log_root/train.log"; then
+  oom=true
+fi
+{
+  printf 'start_epoch=%s\n' "$start_epoch"
+  printf 'end_epoch=%s\n' "$end_epoch"
+  printf 'wall_seconds=%s\n' "$((end_epoch - start_epoch))"
+  printf 'train_exit_code=%s\n' "$train_status"
+  printf 'oom_detected=%s\n' "$oom"
+  awk -F, '
+    {gsub(/ /, "", $2); if (($2 + 0) > peak) peak=$2 + 0}
+    END {printf "peak_vram_mib=%d\n", peak}
+  ' "$log_root/gpu-samples.csv"
+} >"$report_root/train-runtime.txt"
+
+exit "$train_status"
diff --git a/scripts/safe_extract_tum.py b/scripts/safe_extract_tum.py
new file mode 100644
index 0000000..4674c7d
--- /dev/null
+++ b/scripts/safe_extract_tum.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""Inspect and extract a TUM tar archive without following archive links."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import shutil
+import tarfile
+from pathlib import Path, PurePosixPath
+
+
+REQUIRED_INDEXES = ("rgb.txt", "depth.txt", "groundtruth.txt")
+
+
+def validate_member(member: tarfile.TarInfo, destination: Path) -> None:
+    name = member.name
+    path = PurePosixPath(name)
+    if not name or "\\" in name or path.is_absolute() or ".." in path.parts:
+        raise RuntimeError(f"unsafe archive path: {name!r}")
+    if member.issym() or member.islnk():
+        raise RuntimeError(f"archive links are forbidden: {name!r}")
+    if not (member.isdir() or member.isfile()):
+        raise RuntimeError(f"unsupported archive member type: {name!r}")
+    target = (destination / Path(*path.parts)).resolve()
+    if target != destination and destination not in target.parents:
+        raise RuntimeError(f"archive path escapes destination: {name!r}")
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--archive", type=Path, required=True)
+    parser.add_argument("--destination", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    args = parser.parse_args()
+    archive_path = args.archive.resolve(strict=True)
+    destination = args.destination.resolve()
+    if destination.exists():
+        raise SystemExit(f"refusing to overwrite extraction destination: {destination}")
+
+    members: list[tarfile.TarInfo]
+    with tarfile.open(archive_path, mode="r:gz") as archive:
+        members = archive.getmembers()
+        if not members:
+            raise RuntimeError("archive is empty")
+        for member in members:
+            validate_member(member, destination)
+
+        destination.mkdir(parents=True)
+        for member in members:
+            target = destination / Path(*PurePosixPath(member.name).parts)
+            if member.isdir():
+                target.mkdir(parents=True, exist_ok=True)
+                continue
+            target.parent.mkdir(parents=True, exist_ok=True)
+            source = archive.extractfile(member)
+            if source is None:
+                raise RuntimeError(f"could not read regular member: {member.name!r}")
+            with source, target.open("xb") as output:
+                shutil.copyfileobj(source, output, length=1024 * 1024)
+
+    candidates = {
+        name: sorted(destination.rglob(name))
+        for name in REQUIRED_INDEXES
+    }
+    if any(len(paths) != 1 for paths in candidates.values()):
+        raise RuntimeError(
+            "expected exactly one rgb.txt, depth.txt, and groundtruth.txt after extraction"
+        )
+    dataset_roots = {paths[0].parent for paths in candidates.values()}
+    if len(dataset_roots) != 1:
+        raise RuntimeError("required TUM indexes do not share one dataset root")
+    dataset_root = dataset_roots.pop()
+    result = {
+        "schemaVersion": "1.0",
+        "status": "PASS",
+        "archive": str(archive_path),
+        "destination": str(destination),
+        "datasetRoot": str(dataset_root),
+        "memberCount": len(members),
+        "regularFileCount": sum(member.isfile() for member in members),
+        "declaredRegularBytes": sum(member.size for member in members if member.isfile()),
+        "safetyChecks": {
+            "noAbsolutePaths": True,
+            "noParentTraversal": True,
+            "noBackslashPaths": True,
+            "noSymlinkOrHardlink": True,
+            "regularFilesAndDirectoriesOnly": True,
+            "singleRequiredIndexSet": True,
+        },
+        "requiredIndexes": {
