+        )
+    else:
+        result["status"] = "OOM" if oom else "FAILED"
+    (stage_root / "stage-result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, indent=2))
+    if result["status"] != "TRAINING_COMPLETE":
