+#!/usr/bin/env python3
+"""Materialize the exact v9 Nerfstudio train/eval split without starting GPU work."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from nerfstudio.data.dataparsers.colmap_dataparser import ColmapDataParserConfig
+
+
+def temporal_bin(name: str) -> int:
+    index = int(Path(name).stem)
+    return min(12, ((index - 1) * 12) // 371 + 1)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--dataset", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    dataset = args.dataset.resolve()
+    config = ColmapDataParserConfig(
+        data=dataset,
+        images_path=Path("images_2"),
+        colmap_path=Path("sparse_2/0"),
+        load_3D_points=True,
+        orientation_method="up",
+        center_method="poses",
+        auto_scale_poses=True,
+        eval_mode="interval",
+        eval_interval=30,
+    )
+    dataparser = config.setup()
+    train = dataparser.get_dataparser_outputs(split="train")
+    evaluation = dataparser.get_dataparser_outputs(split="val")
+    train_names = [path.name for path in train.image_filenames]
+    eval_names = [path.name for path in evaluation.image_filenames]
+    eval_bins = sorted({temporal_bin(name) for name in eval_names})
+    checks = {
+        "allImagesAccountedFor": len(train_names) + len(eval_names) == 371,
+        "disjointSplit": not (set(train_names) & set(eval_names)),
+        "evalAtLeast12": len(eval_names) >= 12,
+        "evalCovers12Bins": eval_bins == list(range(1, 13)),
+        "cameraWidth": int(train.cameras.width[0].item()) == 980 and int(evaluation.cameras.width[0].item()) == 980,
+        "cameraHeight": int(train.cameras.height[0].item()) == 543 and int(evaluation.cameras.height[0].item()) == 543,
+        "threeDimensionalSeed": train.metadata.get("points3D_xyz") is not None,
+    }
+    result = {
+        "schemaVersion": "1.0",
+        "status": "PASS" if all(checks.values()) else "FAIL",
+        "dataset": str(dataset),
+        "imagesPath": "images_2",
+        "colmapPath": "sparse_2/0",
+        "orientationMethod": "up",
+        "centerMethod": "poses",
+        "autoScalePoses": True,
+        "load3DPoints": True,
+        "evalMode": "interval",
+        "evalInterval": 30,
+        "trainCount": len(train_names),
+        "evalCount": len(eval_names),
+        "evalNames": eval_names,
+        "evalBins": eval_bins,
+        "dataparserScale": float(train.dataparser_scale),
+        "dataparserTransform": train.dataparser_transform.tolist(),
+        "checks": checks,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps(result, indent=2))
+    return 0 if result["status"] == "PASS" else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
