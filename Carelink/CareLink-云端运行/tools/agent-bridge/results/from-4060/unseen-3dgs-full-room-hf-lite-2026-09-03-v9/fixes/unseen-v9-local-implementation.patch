+#!/usr/bin/env python3
+"""Analyze the frozen v9 Meetingroom known-pose input before GPU work."""
+
+from __future__ import annotations
+
+import argparse
+import json
+import math
+from pathlib import Path
+import struct
+
+import numpy as np
+from PIL import Image, ImageDraw, ImageFont
+
+
+EXPECTED_NAMES = {f"{index:06d}.jpg" for index in range(1, 372)}
+EXPECTED_WIDTH = 980
+EXPECTED_HEIGHT = 543
+EXPECTED_POINTS = 124_162
+EXPECTED_CAMERA_PARAMS = (579.5208916063547, 579.5208916063547, 490.0, 271.5)
+
+
+def read_cameras(path: Path) -> list[dict]:
+    cameras: list[dict] = []
+    with path.open("rb") as handle:
+        count = struct.unpack("<Q", handle.read(8))[0]
+        for _ in range(count):
+            camera_id, model_id, width, height = struct.unpack("<iiQQ", handle.read(24))
+            param_count = {0: 3, 1: 4, 2: 4, 3: 5, 4: 8, 5: 8, 6: 12, 7: 5, 8: 4, 9: 5, 10: 12}.get(model_id)
+            if param_count is None:
+                raise ValueError(f"unsupported COLMAP camera model id: {model_id}")
+            params = struct.unpack("<" + "d" * param_count, handle.read(8 * param_count))
+            cameras.append({"cameraId": camera_id, "modelId": model_id, "width": width, "height": height, "params": params})
+        if handle.read(1):
+            raise ValueError("unexpected trailing bytes in cameras.bin")
+    return cameras
+
+
+def quaternion_to_rotation(qvec: np.ndarray) -> np.ndarray:
+    w, x, y, z = qvec
+    return np.asarray(
+        [
+            [1 - 2 * y * y - 2 * z * z, 2 * x * y - 2 * w * z, 2 * x * z + 2 * w * y],
+            [2 * x * y + 2 * w * z, 1 - 2 * x * x - 2 * z * z, 2 * y * z - 2 * w * x],
+            [2 * x * z - 2 * w * y, 2 * y * z + 2 * w * x, 1 - 2 * x * x - 2 * y * y],
+        ],
+        dtype=np.float64,
+    )
+
+
+def read_images(path: Path) -> list[dict]:
+    images: list[dict] = []
+    with path.open("rb") as handle:
+        count = struct.unpack("<Q", handle.read(8))[0]
+        for _ in range(count):
+            raw = handle.read(64)
+            if len(raw) != 64:
+                raise ValueError("truncated images.bin pose row")
+            row = struct.unpack("<idddddddi", raw)
+            image_id = row[0]
+            qvec = np.asarray(row[1:5], dtype=np.float64)
+            tvec = np.asarray(row[5:8], dtype=np.float64)
+            camera_id = row[8]
+            name_bytes = bytearray()
+            while True:
+                char = handle.read(1)
+                if not char:
+                    raise ValueError("truncated images.bin image name")
+                if char == b"\x00":
+                    break
+                name_bytes.extend(char)
+            name = name_bytes.decode("utf-8")
+            points_count = struct.unpack("<Q", handle.read(8))[0]
+            handle.seek(points_count * 24, 1)
+            world_to_camera = quaternion_to_rotation(qvec)
+            camera_to_world = world_to_camera.T
+            center = -camera_to_world @ tvec
+            images.append(
+                {
+                    "imageId": image_id,
+                    "cameraId": camera_id,
+                    "name": name,
+                    "center": center,
+                    "up": -camera_to_world[:, 1],
+                    "forward": camera_to_world[:, 2],
+                }
+            )
+        if handle.read(1):
+            raise ValueError("unexpected trailing bytes in images.bin")
+    return sorted(images, key=lambda item: item["name"])
+
+
+def convex_hull(points: np.ndarray) -> np.ndarray:
+    unique = sorted({(float(row[0]), float(row[1])) for row in points})
+    if len(unique) < 3:
+        raise ValueError("camera footprint has fewer than three unique planar points")
+
+    def cross(origin: tuple[float, float], left: tuple[float, float], right: tuple[float, float]) -> float:
+        return (left[0] - origin[0]) * (right[1] - origin[1]) - (left[1] - origin[1]) * (right[0] - origin[0])
+
+    lower: list[tuple[float, float]] = []
+    for point in unique:
+        while len(lower) >= 2 and cross(lower[-2], lower[-1], point) <= 0:
+            lower.pop()
+        lower.append(point)
+    upper: list[tuple[float, float]] = []
+    for point in reversed(unique):
+        while len(upper) >= 2 and cross(upper[-2], upper[-1], point) <= 0:
+            upper.pop()
+        upper.append(point)
+    return np.asarray(lower[:-1] + upper[:-1], dtype=np.float64)
+
+
+def polygon_area(polygon: np.ndarray) -> float:
+    return abs(float(np.dot(polygon[:, 0], np.roll(polygon[:, 1], -1)) - np.dot(polygon[:, 1], np.roll(polygon[:, 0], -1)))) / 2.0
+
+
+def hull_diameter(polygon: np.ndarray) -> float:
+    delta = polygon[:, None, :] - polygon[None, :, :]
+    return float(np.sqrt(np.max(np.sum(delta * delta, axis=2))))
+
+
+def make_contact_sheet(images_dir: Path, selected: list[dict], output: Path) -> None:
+    thumb_width, thumb_height = 360, 200
+    label_height = 34
+    sheet = Image.new("RGB", (thumb_width * 4, (thumb_height + label_height) * 3), "white")
+    draw = ImageDraw.Draw(sheet)
+    font = ImageFont.load_default()
+    for index, item in enumerate(selected):
+        source = Image.open(images_dir / item["name"]).convert("RGB")
+        source.thumbnail((thumb_width, thumb_height), Image.Resampling.LANCZOS)
+        tile = Image.new("RGB", (thumb_width, thumb_height), (24, 24, 24))
+        offset = ((thumb_width - source.width) // 2, (thumb_height - source.height) // 2)
+        tile.paste(source, offset)
+        x = (index % 4) * thumb_width
+        y = (index // 4) * (thumb_height + label_height)
+        sheet.paste(tile, (x, y))
+        draw.rectangle((x, y + thumb_height, x + thumb_width, y + thumb_height + label_height), fill=(250, 250, 250))
+        draw.text((x + 8, y + thumb_height + 9), f"bin {index + 1:02d}  {item['name']}", fill=(15, 15, 15), font=font)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    sheet.save(output, quality=92)
+
+
+def make_footprint(points: np.ndarray, hull: np.ndarray, bin_index: np.ndarray, metrics: dict, output: Path) -> None:
+    width, height, margin = 1200, 900, 90
+    image = Image.new("RGB", (width, height), "white")
+    draw = ImageDraw.Draw(image)
+    font = ImageFont.load_default()
+    minimum = np.minimum(points.min(axis=0), hull.min(axis=0))
+    maximum = np.maximum(points.max(axis=0), hull.max(axis=0))
+    span = np.maximum(maximum - minimum, 1e-9)
+    scale = min((width - 2 * margin) / span[0], (height - 2 * margin - 70) / span[1])
+
+    def pixel(point: np.ndarray) -> tuple[int, int]:
+        x = margin + (point[0] - minimum[0]) * scale
+        y = height - margin - (point[1] - minimum[1]) * scale
+        return int(round(x)), int(round(y))
+
+    palette = [
+        (31, 119, 180), (255, 127, 14), (44, 160, 44), (214, 39, 40),
+        (148, 103, 189), (140, 86, 75), (227, 119, 194), (127, 127, 127),
+        (188, 189, 34), (23, 190, 207), (57, 59, 121), (156, 158, 222),
+    ]
+    trajectory = [pixel(point) for point in points]
+    draw.line(trajectory, fill=(175, 190, 205), width=2)
+    hull_pixels = [pixel(point) for point in hull]
+    draw.line(hull_pixels + [hull_pixels[0]], fill=(196, 45, 45), width=5)
+    for point, bin_value in zip(points, bin_index):
+        x, y = pixel(point)
+        draw.ellipse((x - 4, y - 4, x + 4, y + 4), fill=palette[int(bin_value)], outline=(0, 0, 0))
+    draw.text((margin, 20), "Tanks and Temples Meetingroom v9 — aligned camera footprint", fill=(0, 0, 0), font=font)
+    draw.text(
+        (margin, 42),
+        f"PCA ratio={metrics['planarPcaRatio']:.6f}  hull area={metrics['hullArea']:.6f}  path/hull={metrics['trajectoryToHullDiameter']:.6f}",
+        fill=(0, 0, 0),
+        font=font,
+    )
+    for index, color in enumerate(palette):
+        x = margin + (index % 6) * 150
+        y = 64 + (index // 6) * 18
+        draw.rectangle((x, y, x + 12, y + 12), fill=color)
+        draw.text((x + 18, y + 1), f"bin {index + 1:02d}", fill=(0, 0, 0), font=font)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    image.save(output)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--dataset", type=Path, required=True)
+    parser.add_argument("--report", type=Path, required=True)
+    parser.add_argument("--contact-sheet", type=Path, required=True)
+    parser.add_argument("--footprint", type=Path, required=True)
+    args = parser.parse_args()
+    dataset = args.dataset.resolve()
+    images_dir = dataset / "images_2"
+    sparse = dataset / "sparse_2/0"
+    prepared = json.loads((dataset / ".prepared.json").read_text(encoding="utf-8"))
+    cameras = read_cameras(sparse / "cameras.bin")
+    images = read_images(sparse / "images.bin")
+    image_names = {item["name"] for item in images}
+    disk_names = {path.name for path in images_dir.glob("*.jpg")}
+    with (sparse / "points3D.bin").open("rb") as handle:
+        points_count = struct.unpack("<Q", handle.read(8))[0]
+    if len(cameras) != 1 or cameras[0]["modelId"] != 1:
+        raise ValueError("v9 accepts exactly one PINHOLE camera")
+    camera = cameras[0]
+    camera_params_match = all(math.isclose(a, b, abs_tol=1e-9, rel_tol=0) for a, b in zip(camera["params"], EXPECTED_CAMERA_PARAMS))
+    if image_names != EXPECTED_NAMES or disk_names != EXPECTED_NAMES:
+        raise ValueError("image/model filenames are not the exact 371-image set")
+
+    centers = np.stack([item["center"] for item in images])
+    average_up = np.mean(np.stack([item["up"] for item in images]), axis=0)
+    average_up /= np.linalg.norm(average_up)
+    centered = centers - np.mean(centers, axis=0)
+    flattened = centered - np.outer(centered @ average_up, average_up)
+    covariance = flattened.T @ flattened / len(flattened)
+    eigenvalues, eigenvectors = np.linalg.eigh(covariance)
+    order = np.argsort(eigenvalues)[::-1]
+    lambda1 = float(eigenvalues[order[0]])
+    lambda2 = float(eigenvalues[order[1]])
+    axis_x = eigenvectors[:, order[0]]
+    axis_x -= average_up * float(np.dot(axis_x, average_up))
+    axis_x /= np.linalg.norm(axis_x)
+    axis_z = np.cross(average_up, axis_x)
+    axis_z /= np.linalg.norm(axis_z)
+    planar = np.column_stack((centered @ axis_x, centered @ axis_z))
+    hull = convex_hull(planar)
+    area = polygon_area(hull)
+    diameter = hull_diameter(hull)
+    trajectory_length = float(np.sum(np.linalg.norm(np.diff(planar, axis=0), axis=1)))
+    heights = centers @ average_up
+    bins = np.array_split(np.arange(len(images)), 12)
+    selected = [images[int(rows[len(rows) // 2])] for rows in bins]
+    bin_index = np.zeros(len(images), dtype=np.int64)
+    for index, rows in enumerate(bins):
+        bin_index[rows] = index
+    metrics = {
+        "lambda1": lambda1,
+        "lambda2": lambda2,
+        "planarPcaRatio": lambda2 / lambda1,
+        "hullArea": area,
+        "hullDiameter": diameter,
+        "trajectoryLength": trajectory_length,
+        "trajectoryToHullDiameter": trajectory_length / diameter,
+        "averageWorldUp": average_up.tolist(),
+        "planarAxisX": axis_x.tolist(),
+        "planarAxisZ": axis_z.tolist(),
+        "medianEyeHeight": float(np.median(heights)),
+        "p05EyeHeight": float(np.percentile(heights, 5)),
+        "p95EyeHeight": float(np.percentile(heights, 95)),
+    }
+    checks = {
+        "preparedReady": prepared.get("status") == "READY",
+        "exact371Images": len(images) == 371 and image_names == EXPECTED_NAMES and disk_names == EXPECTED_NAMES,
+        "registeredFractionOne": len(images) / 371 == 1.0,
+        "singlePinholeCamera": len(cameras) == 1 and camera["modelId"] == 1,
+        "cameraDimensions": (camera["width"], camera["height"]) == (EXPECTED_WIDTH, EXPECTED_HEIGHT),
+        "cameraParameters": camera_params_match,
+        "points3D": points_count == EXPECTED_POINTS,
+        "all12BinsPopulated": len(bins) == 12 and all(len(rows) > 0 for rows in bins),
+        "planarPcaRatio": metrics["planarPcaRatio"] >= 0.15,
+        "positiveHullArea": area > 0,
+        "trajectoryToHullDiameter": metrics["trajectoryToHullDiameter"] >= 2.0,
+    }
+    report = {
+        "schemaVersion": "1.0",
+        "status": "MACHINE_GATE_PASS" if all(checks.values()) else "MACHINE_GATE_FAIL",
+        "dataset": str(dataset),
+        "images": len(images),
+        "registeredImages": len(images),
+        "registeredFraction": len(images) / 371,
+        "cameraModel": "PINHOLE",
+        "cameraCount": len(cameras),
+        "cameraWidth": camera["width"],
+        "cameraHeight": camera["height"],
+        "cameraParams": list(camera["params"]),
+        "points3D": points_count,
+        "temporalBins": [
+            {
+                "bin": index + 1,
+                "count": len(rows),
+                "first": images[int(rows[0])]["name"],
+                "representative": selected[index]["name"],
+                "last": images[int(rows[-1])]["name"],
+            }
+            for index, rows in enumerate(bins)
+        ],
+        "metrics": metrics,
+        "checks": checks,
+    }
+    args.report.parent.mkdir(parents=True, exist_ok=True)
+    args.report.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    make_contact_sheet(images_dir, selected, args.contact_sheet)
+    make_footprint(planar, hull, bin_index, metrics, args.footprint)
+    print(json.dumps(report, indent=2))
+    return 0 if all(checks.values()) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
