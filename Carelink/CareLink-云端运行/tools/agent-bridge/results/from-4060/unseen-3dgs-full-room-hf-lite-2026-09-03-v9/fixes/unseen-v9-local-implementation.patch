+#!/usr/bin/env python3
+"""Run the single permitted v9 7000-step Splatfacto training invocation."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import subprocess
+import time
+from typing import Any
+
+
+SCENE_REVISION = "tandt-meetingroom-hf-r001"
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(4 * 1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def quote_command(command: list[str]) -> str:
+    return " ".join(subprocess.list2cmdline([part]) for part in command)
+
+
+def load_json(path: Path) -> dict[str, Any]:
+    return json.loads(path.read_text(encoding="utf-8"))
+
+
+def ensure_no_active_job() -> None:
+    process = subprocess.run(
+        ["pgrep", "-af", "[c]olmap|[n]s-train|[n]s-export|[t]rain_v[0-9]"],
+        text=True,
+        stdout=subprocess.PIPE,
+    )
+    active = [line for line in process.stdout.splitlines() if str(os.getpid()) not in line]
+    if active:
+        raise RuntimeError("another training, COLMAP, or export process is active:\n" + "\n".join(active))
+
+
+def peak_vram(path: Path) -> int | None:
+    values: list[int] = []
+    if path.is_file():
+        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
+            fields = [part.strip() for part in line.split(",")]
+            if len(fields) >= 2 and fields[1].isdigit():
+                values.append(int(fields[1]))
+    return max(values) if values else None
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--project-root", type=Path, default=Path(__file__).resolve().parents[1])
+    args = parser.parse_args()
+    project_root = args.project_root.resolve()
+    dataset = project_root / "data/tandt-meetingroom-v9/prepared/meetingroom"
+    report_root = project_root / "reports/v9" / SCENE_REVISION
+    input_gate = load_json(report_root / "input-gate.json")
+    manual_gate = load_json(report_root / "manual-contact-review.json")
+    preflight = load_json(report_root / "dataparser-preflight.json")
+    prepared = load_json(dataset / ".prepared.json")
+    if input_gate.get("status") != "MACHINE_GATE_PASS" or not all(input_gate.get("checks", {}).values()):
+        raise RuntimeError("v9 machine input gate is not PASS")
+    if manual_gate.get("status") != "PASS" or manual_gate.get("counts", {}).get("floor", 0) < 8 or manual_gate.get("counts", {}).get("upperWallLightsBeamsCeiling", 0) < 8:
+        raise RuntimeError("v9 manual contact-sheet gate is not PASS")
+    if not manual_gate.get("footprintReview", {}).get("coversTwoPlanarDirections"):
+        raise RuntimeError("v9 footprint did not pass two-direction review")
+    if preflight.get("status") != "PASS" or not all(preflight.get("checks", {}).values()):
+        raise RuntimeError("v9 Nerfstudio dataparser preflight is not PASS")
+    if prepared.get("status") != "READY" or prepared.get("images") != 371 or prepared.get("registeredImages") != 371:
+        raise RuntimeError("v9 prepared source is incomplete")
+    ensure_no_active_job()
+
+    output_root = project_root / "artifacts/training/v9" / SCENE_REVISION
+    run_root = output_root / "tandt-meetingroom-v9/splatfacto/stage-7000"
+    stage_root = report_root / "stages/7000"
+    marker = report_root / "training-attempt-7000.started"
+    checkpoint = run_root / "nerfstudio_models/step-000006999.ckpt"
+    config = run_root / "config.yml"
+    if marker.exists() or stage_root.exists() or run_root.exists():
+        raise RuntimeError("refusing a second v9 training attempt")
+    stage_root.mkdir(parents=True)
+    marker_payload = {
+        "sceneRevisionId": SCENE_REVISION,
+        "stage": 7000,
+        "fromScratch": True,
+        "startedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
+    }
+    with marker.open("x", encoding="utf-8") as handle:
+        json.dump(marker_payload, handle, indent=2)
+        handle.write("\n")
+
+    command = [
+        "ns-train", "splatfacto",
+        "--output-dir", str(output_root),
+        "--experiment-name", "tandt-meetingroom-v9",
+        "--timestamp", "stage-7000",
+        "--max-num-iterations", "7000",
+        "--steps-per-save", "2000",
+        "--steps-per-eval-image", "100000",
+        "--steps-per-eval-all-images", "100000",
+        "--vis", "tensorboard",
+        "--pipeline.model.use-scale-regularization", "True",
+        "--pipeline.model.random-init", "False",
+        "--pipeline.model.camera-optimizer.mode", "off",
+        "colmap",
+        "--data", str(dataset),
+        "--images-path", "images_2",
