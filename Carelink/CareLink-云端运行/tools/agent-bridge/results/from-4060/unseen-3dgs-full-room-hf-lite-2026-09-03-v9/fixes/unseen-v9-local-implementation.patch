+    with train_log.open("w", encoding="utf-8") as log:
+        log.write(f"$ {quote_command(command)}\n")
+        log.flush()
+        process = subprocess.run(command, stdout=log, stderr=subprocess.STDOUT, text=True)
+    ended = time.time()
+    try:
+        os.killpg(monitor.pid, signal.SIGTERM)
+        monitor.wait(timeout=5)
+    except (ProcessLookupError, subprocess.TimeoutExpired):
+        monitor.kill()
+    finally:
+        monitor_handle.close()
+    log_text = train_log.read_text(encoding="utf-8", errors="replace")
+    oom = bool(re.search(r"out of memory|cuda.*oom", log_text, re.IGNORECASE))
+    result: dict[str, Any] = {
