+        "--auto-scale-poses", "True",
+        "--eval-mode", "interval",
+        "--eval-interval", "30",
+    ]
+    (stage_root / "command.txt").write_text(quote_command(command) + "\n", encoding="utf-8")
+    gpu_log = stage_root / "gpu-samples.csv"
+    train_log = stage_root / "train.log"
+    monitor_handle = gpu_log.open("w", encoding="utf-8")
+    monitor = subprocess.Popen(
+        ["nvidia-smi", "--query-gpu=timestamp,memory.used,utilization.gpu", "--format=csv,noheader,nounits", "-lms", "500"],
+        stdout=monitor_handle,
+        stderr=subprocess.STDOUT,
+        text=True,
+        start_new_session=True,
