+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import unittest
+
+import numpy as np
+
+from generate_tum_v4_viewer import (
+    PLAYCANVAS_FROM_NERFSTUDIO,
+    apply_dataparser_transform,
+    matrix_to_quaternion_xyzw,
+)
+
+
+def quaternion_xyzw_to_matrix(values: list[float]) -> np.ndarray:
+    x, y, z, w = values
+    return np.asarray(
+        [
+            [1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w)],
+            [2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w)],
+            [2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y)],
+        ]
+    )
+
+
+class ViewerTransformTests(unittest.TestCase):
+    def test_matrix_quaternion_roundtrip(self) -> None:
+        matrix = PLAYCANVAS_FROM_NERFSTUDIO[:3, :3]
+        quaternion = matrix_to_quaternion_xyzw(matrix)
+        np.testing.assert_allclose(quaternion_xyzw_to_matrix(quaternion), matrix, atol=1e-12)
+
+    def test_dataparser_translation_is_scaled_after_transform(self) -> None:
+        pose = np.eye(4)
+        pose[:3, 3] = [1.0, 2.0, 3.0]
+        transform = np.asarray([[1, 0, 0, 4], [0, 1, 0, 5], [0, 0, 1, 6]], dtype=float)
+        result = apply_dataparser_transform(pose, transform, 0.5)
+        np.testing.assert_allclose(result[:3, 3], [2.5, 3.5, 4.5])
+
+
+if __name__ == "__main__":
+    unittest.main()
