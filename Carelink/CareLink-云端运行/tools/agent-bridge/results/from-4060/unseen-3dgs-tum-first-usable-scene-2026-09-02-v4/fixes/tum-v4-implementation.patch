+#!/usr/bin/env python3
+"""Minimal convention tests for tum_v4_adapter.py."""
+
+from __future__ import annotations
+
+import unittest
+
+import numpy as np
+
+from tum_v4_adapter import TimedPose, nearest_index, tum_pose_matrices
+
+
+class AdapterConventionTests(unittest.TestCase):
+    def test_nearest_timestamp_is_deterministic(self) -> None:
+        timestamps = [1.0, 2.0, 3.0]
+        self.assertEqual(nearest_index(timestamps, 2.49), 1)
+        self.assertEqual(nearest_index(timestamps, 2.50), 1)
+        self.assertEqual(nearest_index(timestamps, 2.51), 2)
+
+    def test_opencv_to_opengl_camera_axes(self) -> None:
+        pose = TimedPose(0.0, np.array([1.0, 2.0, 3.0]), np.array([0.0, 0.0, 0.0, 1.0]))
+        c2w_cv, c2w_gl = tum_pose_matrices(pose)
+        np.testing.assert_allclose(c2w_cv, np.eye(4) + np.array([[0, 0, 0, 1], [0, 0, 0, 2], [0, 0, 0, 3], [0, 0, 0, 0]]))
+        np.testing.assert_allclose(c2w_gl[:3, 0], [1.0, 0.0, 0.0])
+        np.testing.assert_allclose(c2w_gl[:3, 1], [0.0, -1.0, 0.0])
+        np.testing.assert_allclose(c2w_gl[:3, 2], [0.0, 0.0, -1.0])
+        np.testing.assert_allclose(c2w_gl[:3, 3], [1.0, 2.0, 3.0])
+
+    def test_rotation_is_orthonormal(self) -> None:
+        pose = TimedPose(0.0, np.zeros(3), np.array([0.2, -0.3, 0.1, 0.9]))
+        c2w_cv, _ = tum_pose_matrices(pose)
+        rotation = c2w_cv[:3, :3]
+        np.testing.assert_allclose(rotation.T @ rotation, np.eye(3), atol=1e-12)
+        self.assertAlmostEqual(float(np.linalg.det(rotation)), 1.0, places=12)
+
+
+if __name__ == "__main__":
+    unittest.main()
