+++ b/scripts/tum_v4_adapter.py
@@ -0,0 +1,352 @@
+#!/usr/bin/env python3
+"""Build the v4 TUM freiburg1/desk Nerfstudio fixture from known poses.
+
+The adapter deterministically samples at 5 Hz, associates RGB/depth/ground
+truth by timestamp, converts the TUM/OpenCV camera-to-world pose to the
+Nerfstudio/OpenGL convention, and creates a bounded colored depth seed.
+"""
+
+from __future__ import annotations
+
+import argparse
+import bisect
+import json
+import math
+import shutil
+from dataclasses import dataclass
+from pathlib import Path
+
+import cv2
+import numpy as np
+from plyfile import PlyData, PlyElement
+
+
+RGB_FX = 525.0
+RGB_FY = 525.0
+RGB_CX = 319.5
+RGB_CY = 239.5
+WIDTH = 640
+HEIGHT = 480
+DEPTH_FACTOR = 5000.0
+MAX_DEPTH_METERS = 5.0
+SAMPLE_HZ = 5.0
+MAX_FRAMES = 120
+MAX_SEED_POINTS = 200_000
+OPENGL_FROM_OPENCV = np.diag([1.0, -1.0, -1.0, 1.0])
+
+
+@dataclass(frozen=True)
+class TimedPath:
+    timestamp: float
+    path: str
+
+
+@dataclass(frozen=True)
+class TimedPose:
+    timestamp: float
+    translation: np.ndarray
+    quaternion_xyzw: np.ndarray
+
+
+def read_timed_paths(path: Path) -> list[TimedPath]:
+    rows: list[TimedPath] = []
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if not line or line.startswith("#"):
+            continue
+        timestamp, relative_path = line.split(maxsplit=1)
+        rows.append(TimedPath(float(timestamp), relative_path))
+    return rows
+
+
+def read_timed_poses(path: Path) -> list[TimedPose]:
+    rows: list[TimedPose] = []
+    for line in path.read_text(encoding="utf-8").splitlines():
+        line = line.strip()
+        if not line or line.startswith("#"):
+            continue
+        values = [float(item) for item in line.split()]
+        rows.append(
+            TimedPose(
+                timestamp=values[0],
+                translation=np.asarray(values[1:4], dtype=np.float64),
+                quaternion_xyzw=np.asarray(values[4:8], dtype=np.float64),
+            )
+        )
+    return rows
+
+
+def nearest_index(timestamps: list[float], target: float) -> int:
+    insertion = bisect.bisect_left(timestamps, target)
+    choices = [index for index in (insertion - 1, insertion) if 0 <= index < len(timestamps)]
+    return min(choices, key=lambda index: (abs(timestamps[index] - target), index))
+
+
+def quaternion_xyzw_to_rotation(quaternion: np.ndarray) -> np.ndarray:
+    quaternion = quaternion.astype(np.float64)
+    norm = np.linalg.norm(quaternion)
+    if not np.isfinite(norm) or norm < 1e-12:
+        raise ValueError("invalid quaternion")
+    x, y, z, w = quaternion / norm
+    return np.asarray(
+        [
+            [1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w)],
+            [2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w)],
+            [2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y)],
+        ],
+        dtype=np.float64,
+    )
+
+
+def tum_pose_matrices(pose: TimedPose) -> tuple[np.ndarray, np.ndarray]:
+    """Return TUM/OpenCV c2w and Nerfstudio/OpenGL c2w."""
+    c2w_opencv = np.eye(4, dtype=np.float64)
+    c2w_opencv[:3, :3] = quaternion_xyzw_to_rotation(pose.quaternion_xyzw)
+    c2w_opencv[:3, 3] = pose.translation
+    c2w_opengl = c2w_opencv @ OPENGL_FROM_OPENCV
+    return c2w_opencv, c2w_opengl
+
+
+def backproject_depth(
+    depth: np.ndarray, rgb_bgr: np.ndarray, c2w_opencv: np.ndarray, grid_step: int = 12
+) -> tuple[np.ndarray, np.ndarray]:
+    vv, uu = np.mgrid[0:HEIGHT:grid_step, 0:WIDTH:grid_step]
+    raw_depth = depth[vv, uu].astype(np.float64)
+    z = raw_depth / DEPTH_FACTOR
+    valid = (raw_depth > 0) & np.isfinite(z) & (z >= 0.2) & (z <= MAX_DEPTH_METERS)
+    u = uu[valid].astype(np.float64)
+    v = vv[valid].astype(np.float64)
+    z = z[valid]
+    xyz_camera = np.stack(
+        [
+            (u - RGB_CX) * z / RGB_FX,
+            (v - RGB_CY) * z / RGB_FY,
+            z,
+        ],
+        axis=1,
+    )
+    xyz_world = xyz_camera @ c2w_opencv[:3, :3].T + c2w_opencv[:3, 3]
+    colors_rgb = rgb_bgr[vv[valid], uu[valid], ::-1]
+    return xyz_world.astype(np.float32), colors_rgb.astype(np.uint8)
+
+
+def write_ply(path: Path, points: np.ndarray, colors: np.ndarray) -> None:
+    vertices = np.empty(
+        len(points),
+        dtype=[
+            ("x", "f4"),
+            ("y", "f4"),
+            ("z", "f4"),
+            ("red", "u1"),
+            ("green", "u1"),
+            ("blue", "u1"),
+        ],
+    )
+    vertices["x"], vertices["y"], vertices["z"] = points.T
+    vertices["red"], vertices["green"], vertices["blue"] = colors.T
+    PlyData([PlyElement.describe(vertices, "vertex")], text=False).write(path)
+
+
+def projection_roundtrip_error(depth: np.ndarray, c2w_opencv: np.ndarray) -> dict[str, float | int]:
+    vv, uu = np.mgrid[0:HEIGHT:24, 0:WIDTH:24]
+    raw_depth = depth[vv, uu].astype(np.float64)
+    z = raw_depth / DEPTH_FACTOR
+    valid = (raw_depth > 0) & (z >= 0.2) & (z <= MAX_DEPTH_METERS)
+    u = uu[valid].astype(np.float64)
+    v = vv[valid].astype(np.float64)
+    z = z[valid]
+    camera = np.stack([(u - RGB_CX) * z / RGB_FX, (v - RGB_CY) * z / RGB_FY, z], axis=1)
+    world = camera @ c2w_opencv[:3, :3].T + c2w_opencv[:3, 3]
+    recovered = (world - c2w_opencv[:3, 3]) @ c2w_opencv[:3, :3]
+    projected_u = RGB_FX * recovered[:, 0] / recovered[:, 2] + RGB_CX
+    projected_v = RGB_FY * recovered[:, 1] / recovered[:, 2] + RGB_CY
+    error = np.sqrt((projected_u - u) ** 2 + (projected_v - v) ** 2)
+    return {
+        "validSamples": int(len(error)),
+        "medianReprojectionErrorPx": float(np.median(error)),
+        "maxReprojectionErrorPx": float(np.max(error)),
+        "minRecoveredDepthMeters": float(np.min(recovered[:, 2])),
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    source = args.source.resolve()
+    output = args.output.resolve()
+    if output.exists():
+        raise SystemExit(f"refusing to overwrite existing adapter output: {output}")
+    (output / "images").mkdir(parents=True)
+    (output / "depth").mkdir()
+
+    rgb_rows = read_timed_paths(source / "rgb.txt")
+    depth_rows = read_timed_paths(source / "depth.txt")
+    pose_rows = read_timed_poses(source / "groundtruth.txt")
+    rgb_times = [row.timestamp for row in rgb_rows]
+    depth_times = [row.timestamp for row in depth_rows]
+    pose_times = [row.timestamp for row in pose_rows]
+    overlap_start = max(rgb_times[0], depth_times[0], pose_times[0])
+    overlap_end = min(rgb_times[-1], depth_times[-1], pose_times[-1])
+    requested_count = min(MAX_FRAMES, int(math.floor((overlap_end - overlap_start) * SAMPLE_HZ)) + 1)
+
+    selected: list[dict[str, object]] = []
+    used_rgb_indices: set[int] = set()
+    all_points: list[np.ndarray] = []
+    all_colors: list[np.ndarray] = []
+    frames: list[dict[str, object]] = []
+    for target_index in range(requested_count):
+        target_timestamp = overlap_start + target_index / SAMPLE_HZ
+        rgb_index = nearest_index(rgb_times, target_timestamp)
+        if rgb_index in used_rgb_indices:
+            continue
+        used_rgb_indices.add(rgb_index)
+        rgb_row = rgb_rows[rgb_index]
+        depth_row = depth_rows[nearest_index(depth_times, rgb_row.timestamp)]
+        pose_row = pose_rows[nearest_index(pose_times, rgb_row.timestamp)]
+        c2w_opencv, c2w_opengl = tum_pose_matrices(pose_row)
+
+        frame_name = f"frame_{len(selected):05d}.png"
+        depth_name = f"depth_{len(selected):05d}.png"
+        shutil.copy2(source / rgb_row.path, output / "images" / frame_name)
+        shutil.copy2(source / depth_row.path, output / "depth" / depth_name)
+        rgb_bgr = cv2.imread(str(source / rgb_row.path), cv2.IMREAD_COLOR)
+        depth = cv2.imread(str(source / depth_row.path), cv2.IMREAD_UNCHANGED)
+        if rgb_bgr is None or depth is None or rgb_bgr.shape[:2] != (HEIGHT, WIDTH) or depth.shape != (HEIGHT, WIDTH):
+            raise RuntimeError(f"unexpected image shape at {rgb_row.path} / {depth_row.path}")
+        points, colors = backproject_depth(depth, rgb_bgr, c2w_opencv)
+        all_points.append(points)
+        all_colors.append(colors)
+        frames.append(
+            {
+                "file_path": f"images/{frame_name}",
+                "transform_matrix": c2w_opengl.tolist(),
+            }
+        )
+        selected.append(
+            {
+                "index": len(selected),
+                "targetTimestamp": target_timestamp,
+                "rgbTimestamp": rgb_row.timestamp,
+                "rgbSource": rgb_row.path,
+                "depthTimestamp": depth_row.timestamp,
+                "depthSource": depth_row.path,
+                "groundTruthTimestamp": pose_row.timestamp,
