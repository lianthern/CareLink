     return [round(float(value), digits) for value in values]
 
 
+def convex_hull_xz(points: np.ndarray) -> np.ndarray:
+    """Return the counter-clockwise 2D convex hull without repeating its first point."""
+    unique = sorted({(float(point[0]), float(point[1])) for point in np.asarray(points)})
+    if len(unique) < 3:
+        raise ValueError("navigation needs at least three unique camera positions")
+
+    def cross(origin: tuple[float, float], left: tuple[float, float], right: tuple[float, float]) -> float:
+        return (left[0] - origin[0]) * (right[1] - origin[1]) - (left[1] - origin[1]) * (right[0] - origin[0])
+
+    lower: list[tuple[float, float]] = []
+    for point in unique:
+        while len(lower) >= 2 and cross(lower[-2], lower[-1], point) <= 0:
+            lower.pop()
+        lower.append(point)
+    upper: list[tuple[float, float]] = []
+    for point in reversed(unique):
+        while len(upper) >= 2 and cross(upper[-2], upper[-1], point) <= 0:
+            upper.pop()
+        upper.append(point)
+    hull = np.asarray(lower[:-1] + upper[:-1], dtype=np.float64)
+    if len(hull) < 3:
+        raise ValueError("camera trajectory is collinear; no navigation hull exists")
+    return hull
+
+
+def buffer_convex_polygon(polygon: np.ndarray, distance: float) -> np.ndarray:
+    """Apply a small, deterministic mitred buffer to a CCW convex polygon."""
+    vertices = np.asarray(polygon, dtype=np.float64)
+    if len(vertices) < 3 or distance < 0:
+        raise ValueError("buffer requires a convex polygon and a non-negative distance")
+    if distance == 0:
+        return vertices.copy()
+
+    edges = np.roll(vertices, -1, axis=0) - vertices
+    lengths = np.linalg.norm(edges, axis=1)
+    if np.any(lengths <= 1e-12):
+        raise ValueError("navigation hull contains a zero-length edge")
+    outward = np.column_stack((edges[:, 1], -edges[:, 0])) / lengths[:, None]
+    buffered: list[np.ndarray] = []
+    for index in range(len(vertices)):
+        previous = (index - 1) % len(vertices)
+        first = vertices[previous] + outward[previous] * distance
+        second = vertices[index] + outward[index] * distance
+        direction_a = edges[previous]
+        direction_b = edges[index]
+        denominator = direction_a[0] * direction_b[1] - direction_a[1] * direction_b[0]
+        if abs(denominator) <= 1e-12:
+            buffered.append(vertices[index] + (outward[previous] + outward[index]) * (distance / 2))
+            continue
+        delta = second - first
+        parameter = (delta[0] * direction_b[1] - delta[1] * direction_b[0]) / denominator
+        buffered.append(first + direction_a * parameter)
+    return np.asarray(buffered)
+
+
+def navigation_boundary(positions: np.ndarray, buffer_distance: float = 0.05) -> list[list[float]]:
+    xz = np.asarray(positions, dtype=np.float64)[:, [0, 2]]
+    return [rounded(point) for point in buffer_convex_polygon(convex_hull_xz(xz), buffer_distance)]
+
+
