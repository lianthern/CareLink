+++ b/scripts/viewer_v8_regression_e2e.js
@@ -0,0 +1,249 @@
+const fs = require("fs");
+const path = require("path");
+const { chromium } = require("playwright");
+
+const args = process.argv.slice(2);
+if (args.length !== 3) {
+  console.error("Usage: node viewer_v8_regression_e2e.js <viewer-url> <result-json> <overview-png>");
+  process.exit(2);
+}
+
+function maxAbs(left, right) {
+  return Math.max(...left.map((value, index) => Math.abs(value - right[index])));
+}
+
+function angleDifference(left, right) {
+  return Math.abs(((left - right + 180) % 360 + 360) % 360 - 180);
+}
+
+function pointInPolygon(x, z, polygon) {
+  let inside = false;
+  for (let i = 0, j = polygon.length - 1; i < polygon.length; j = i++) {
+    const [xi, zi] = polygon[i];
+    const [xj, zj] = polygon[j];
+    if (zi > z !== zj > z && x < ((xj - xi) * (z - zi)) / (zj - zi) + xi) inside = !inside;
+  }
+  return inside;
+}
+
+async function cameraState(page) {
+  return page.locator("#sceneCanvas").evaluate((canvas) => ({
+    position: canvas.dataset.cameraPosition.split(",").map(Number),
+    quaternion: canvas.dataset.cameraQuaternion.split(",").map(Number),
+    euler: canvas.dataset.cameraEuler.split(",").map(Number),
+    fov: Number(canvas.dataset.cameraFov),
+    mode: canvas.dataset.navigationMode,
+    walkY: Number(canvas.dataset.walkY),
+    speedTier: canvas.dataset.speedTier,
+    moveSpeed: Number(canvas.dataset.moveSpeed),
+  }));
+}
+
+async function holdForward(page, milliseconds, sprint = false) {
+  if (sprint) await page.keyboard.down("Shift");
+  await page.keyboard.down("w");
+  await page.waitForTimeout(milliseconds);
+  await page.keyboard.up("w");
+  if (sprint) await page.keyboard.up("Shift");
+  await page.waitForTimeout(120);
+}
+
+async function resetWalk(page) {
+  await page.locator("#freeWalkAction").click();
+  await page.waitForTimeout(120);
+}
+
+(async () => {
+  const [url, resultPath, overviewPath] = args;
+  fs.mkdirSync(path.dirname(resultPath), { recursive: true });
+  fs.mkdirSync(path.dirname(overviewPath), { recursive: true });
+  const browser = await chromium.launch({
+    headless: true,
+    executablePath: process.env.CHROME_PATH || "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
+  });
+  const page = await browser.newPage({ viewport: { width: 1440, height: 900 }, deviceScaleFactor: 1 });
+  const progress = (message) => console.log(`[e2e] ${message}`);
+  const consoleErrors = [];
+  page.on("console", (message) => {
+    if (message.type() === "error") consoleErrors.push(message.text());
+  });
+  page.on("pageerror", (error) => consoleErrors.push(error.message));
+  progress("opening Viewer");
+  await page.goto(url, { waitUntil: "networkidle" });
+  await page.waitForFunction(
+    () => document.querySelector("#sceneState")?.textContent?.includes("SOG ready"),
+    null,
+    { timeout: 60000 }
+  );
+  await page.waitForFunction(() => document.querySelector("#sceneCanvas")?.dataset.cameraEuler);
+  progress("SOG ready and camera telemetry active");
+  const manifest = await page.evaluate(() => {
+    const sceneUrl = new URLSearchParams(window.location.search).get("scene");
+    return fetch(sceneUrl).then((response) => response.json());
+  });
+
+  const anchorChecks = [];
+  for (const anchor of manifest.photoAnchors) {
+    await page.locator(`[data-photo-anchor-id="${anchor.id}"]`).click();
+    await page.waitForTimeout(700);
+    const actual = await cameraState(page);
+    const positionMaxAbs = maxAbs(actual.position, anchor.position);
+    const quaternionMaxAbs = Math.min(
+      maxAbs(actual.quaternion, anchor.quaternion),
+      maxAbs(actual.quaternion, anchor.quaternion.map((value) => -value))
+    );
+    const fovAbs = Math.abs(actual.fov - anchor.fov);
+    anchorChecks.push({
+      id: anchor.id,
+      actual,
+      positionMaxAbs,
+      quaternionMaxAbs,
+      fovAbs,
+      pass:
+        actual.mode === "photo-anchor" &&
+        positionMaxAbs <= 1e-5 &&
+        quaternionMaxAbs <= 1e-5 &&
+        fovAbs <= 1e-6,
+    });
+  }
+  progress("photo anchors verified");
+
+  const middle = manifest.photoAnchors.find((anchor) => anchor.id === "frame_0053") || manifest.photoAnchors[1];
+  await page.locator(`[data-photo-anchor-id="${middle.id}"]`).click();
+  await page.waitForTimeout(700);
+  const photoPose = await cameraState(page);
+  await resetWalk(page);
+  const levelPose = await cameraState(page);
+  const levelGate = {
+    yawDifferenceDegrees: angleDifference(photoPose.euler[1], levelPose.euler[1]),
+    pitchAbs: Math.abs(levelPose.euler[0]),
+    rollAbs: Math.abs(levelPose.euler[2]),
+    eyeHeightAbs: Math.abs(levelPose.position[1] - manifest.navigation.eyeHeight),
+  };
+  progress("free-walk leveling verified");
+
+  await page.keyboard.press("0");
+  const defaultZoom = await cameraState(page);
+  await page.locator("#zoomInAction").click();
+  const buttonZoom = await cameraState(page);
+  await page.locator("#sceneCanvas").dispatchEvent("wheel", { deltaY: 120 });
+  const wheelZoom = await cameraState(page);
+  for (let index = 0; index < 20; index++) await page.locator("#zoomInAction").click();
+  const minZoom = await cameraState(page);
+  for (let index = 0; index < 20; index++) await page.locator("#zoomOutAction").click();
+  const maxZoom = await cameraState(page);
+  await page.keyboard.press("0");
+  const restoredZoom = await cameraState(page);
+  const fovUi = Number((await page.locator("#fovValue").innerText()).replace("°", ""));
+  progress("zoom controls verified");
+
+  await resetWalk(page);
+  const beforeOneSecond = await cameraState(page);
+  await holdForward(page, 1000);
+  const afterOneSecond = await cameraState(page);
+  const oneSecondDistance = Math.hypot(
+    afterOneSecond.position[0] - beforeOneSecond.position[0],
+    afterOneSecond.position[2] - beforeOneSecond.position[2]
+  );
+  progress("one-second normal walk measured");
+
+  await resetWalk(page);
+  const normalStart = await cameraState(page);
+  await holdForward(page, 250);
+  const normalEnd = await cameraState(page);
+  const normalDistance = Math.hypot(
+    normalEnd.position[0] - normalStart.position[0],
+    normalEnd.position[2] - normalStart.position[2]
+  );
+  await resetWalk(page);
+  const sprintStart = await cameraState(page);
+  await holdForward(page, 250, true);
+  const sprintEnd = await cameraState(page);
+  const sprintDistance = Math.hypot(
+    sprintEnd.position[0] - sprintStart.position[0],
+    sprintEnd.position[2] - sprintStart.position[2]
+  );
+  const sprintRatio = sprintDistance / normalDistance;
+  progress("sprint ratio measured");
+
+  await resetWalk(page);
+  const beforeLook = await cameraState(page);
+  const canvasBox = await page.locator("#sceneCanvas").boundingBox();
+  await page.mouse.move(canvasBox.x + canvasBox.width / 2, canvasBox.y + canvasBox.height - 35);
+  await page.mouse.down();
+  await page.mouse.move(canvasBox.x + canvasBox.width / 2, canvasBox.y + 35, { steps: 12 });
+  await page.mouse.up();
+  await page.waitForTimeout(100);
+  const afterLook = await cameraState(page);
+  await holdForward(page, 200);
+  const afterLookWalk = await cameraState(page);
+  progress("look clamp and level walk verified");
+
+  await page.locator(`[data-photo-anchor-id="${middle.id}"]`).click();
+  await page.waitForTimeout(700);
+  const returned = await cameraState(page);
+  const returnedPositionError = maxAbs(returned.position, middle.position);
+  const returnedQuaternionError = Math.min(
+    maxAbs(returned.quaternion, middle.quaternion),
+    maxAbs(returned.quaternion, middle.quaternion.map((value) => -value))
+  );
+  const returnedFovError = Math.abs(returned.fov - middle.fov);
+  progress("photo-anchor return verified");
+
+  await resetWalk(page);
+  await page.locator("#zoomInAction").click();
+  await page.keyboard.down("Shift");
+  await page.waitForTimeout(120);
+  const screenshotState = await cameraState(page);
+  await page.screenshot({ path: overviewPath, type: "png" });
+  await page.keyboard.up("Shift");
+  const oldShortSide = 0.312741989 - -0.326478013;
+  const checks = {
+    sogReady: (await page.locator("#sceneState").innerText()).includes("SOG ready"),
+    allAnchorsRestoreExactly: anchorChecks.every((row) => row.pass),
+    freeWalkMode: levelPose.mode === "walk",
+    freeWalkYawContinuous: levelGate.yawDifferenceDegrees <= 0.5,
+    freeWalkPitchLevel: levelGate.pitchAbs <= 0.5,
+    freeWalkRollLevel: levelGate.rollAbs <= 0.5,
+    freeWalkUsesMedianHeight: levelGate.eyeHeightAbs <= 1e-5,
+    buttonZoomChangesAtLeastFiveDegrees: defaultZoom.fov - buttonZoom.fov >= 4.999,
+    wheelZoomChangesAtLeastFiveDegrees: wheelZoom.fov - buttonZoom.fov >= 4.999,
+    fovMinimumClamp: Math.abs(minZoom.fov - 30) <= 1e-6,
+    fovMaximumClamp: Math.abs(maxZoom.fov - 90) <= 1e-6,
+    zeroRestoresDefaultFov: Math.abs(restoredZoom.fov - manifest.navigation.defaultFov) <= 1e-6,
+    fovUiMatchesCamera: Math.abs(fovUi - restoredZoom.fov) <= 0.051,
+    normalOneSecondVisible: oneSecondDistance >= oldShortSide * 0.25,
+    normalWalkInsideHull: pointInPolygon(afterOneSecond.position[0], afterOneSecond.position[2], manifest.navigation.boundaryXZ),
+    sprintRatioIsThree: sprintRatio >= 2.7 && sprintRatio <= 3.3,
+    dragPitchClamp: Math.abs(Math.abs(afterLook.euler[0]) - 75) <= 0.5,
+    dragRollZero: Math.abs(afterLook.euler[2]) <= 0.5,
+    forwardDoesNotChangeY: Math.abs(afterLookWalk.position[1] - beforeLook.position[1]) <= 1e-5,
+    photoAnchorReturnAfterWalk: returned.mode === "photo-anchor" && returnedPositionError <= 1e-5 && returnedQuaternionError <= 1e-5 && returnedFovError <= 1e-6,
+    screenshotShowsFreeWalk: screenshotState.mode === "walk",
+    screenshotShowsSprint: screenshotState.speedTier === "sprint",
+    noConsoleErrors: consoleErrors.length === 0,
+  };
+  const result = {
+    status: Object.values(checks).every(Boolean) ? "PASS" : "FAIL",
+    url,
+    sceneState: await page.locator("#sceneState").innerText(),
+    manifestSceneRevisionId: manifest.sceneRevisionId,
