@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""Create a safe side-by-side Viewer regression image without source media."""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+from PIL import Image, ImageDraw, ImageFont, ImageOps
+
+
+def fit(image: Image.Image, size: tuple[int, int]) -> Image.Image:
+    return ImageOps.fit(image.convert("RGB"), size, method=Image.Resampling.LANCZOS)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--before", type=Path, required=True)
+    parser.add_argument("--after", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+
+    panel_size = (960, 600)
+    header = 56
+    canvas = Image.new("RGB", (panel_size[0] * 2, panel_size[1] + header), "#142329")
+    with Image.open(args.before) as before, Image.open(args.after) as after:
+        canvas.paste(fit(before, panel_size), (0, header))
+        canvas.paste(fit(after, panel_size), (panel_size[0], header))
+
+    draw = ImageDraw.Draw(canvas)
+    try:
+        font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 24)
+    except OSError:
+        font = ImageFont.load_default()
+    draw.text((24, 14), "BEFORE — v7 camera-like controls", fill="#f2f0e9", font=font)
+    draw.text((panel_size[0] + 24, 14), "AFTER — level free-walk, zoom, sprint, hull", fill="#e6a75e", font=font)
+    draw.line((panel_size[0], 0, panel_size[0], canvas.height), fill="#e6a75e", width=2)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    canvas.save(args.output, format="JPEG", quality=88, optimize=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
