@@ -0,0 +1,313 @@
+#!/usr/bin/env python3
+"""Run one contract-bounded v3 SfM candidate without touching the baseline.
+
+The script reuses the baseline database so SIFT features and exhaustive matches
+are byte-for-byte identical.  It only replaces the single camera row in an
+isolated database copy, then runs COLMAP mapper and the same final principal
+point bundle adjustment used by Nerfstudio 1.1.5.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import re
+import shutil
+import sqlite3
+import struct
+import subprocess
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+
+
+PROJECT = Path(__file__).resolve().parents[1]
+BASELINE_DB = PROJECT / "data/processed/preview-primary/colmap/database.db"
+IMAGE_DIR = PROJECT / "data/processed/preview-primary/images"
+OUTPUT_ROOT = PROJECT / "reports/repair-v3/sfm"
+ANCHORS = ("frame_00001.jpg", "frame_00036.jpg", "frame_00072.jpg")
+EVIDENCE_FOCAL = 832.1797717687189
+
+
+@dataclass(frozen=True)
+class Candidate:
+    camera_model: str
+    camera_model_id: int
+    params: tuple[float, ...]
+    prior_focal_length: int
+    refine_focal_length: bool
+    evidence: str
+
+
+CANDIDATES = {
+    "SIMPLE_RADIAL_AUTO": Candidate(
+        camera_model="SIMPLE_RADIAL",
+        camera_model_id=2,
+        params=(1536.0, 640.0, 360.0, 0.0),
+        prior_focal_length=0,
+        refine_focal_length=True,
+        evidence=(
+            "COLMAP default_focal_length_factor=1.2 at max(width,height)=1280; "
+            "principal point is the 1280x720 image center; k=0."
+        ),
+    ),
+    "SIMPLE_RADIAL_PRIOR": Candidate(
+        camera_model="SIMPLE_RADIAL",
+        camera_model_id=2,
+        params=(EVIDENCE_FOCAL, 640.0, 360.0, 0.0),
+        prior_focal_length=1,
+        refine_focal_length=False,
+        evidence=(
+            "f=832.1797717687189 is the plausible horizontal focal component "
+            "from the frozen v2 OPENCV solution; principal point is the image "
+            "center. COLMAP 3.7 has no soft focal prior, so focal refinement is "
+            "disabled to make the sourced prior an actual constraint."
+        ),
+    ),
+    "SQUARE_PIXEL_LOW_DOF_PRIOR": Candidate(
+        camera_model="SIMPLE_PINHOLE",
+        camera_model_id=0,
+        params=(EVIDENCE_FOCAL, 640.0, 360.0),
+        prior_focal_length=1,
+        refine_focal_length=False,
+        evidence=(
+            "SIMPLE_PINHOLE is the alternate square-pixel low-DOF model; "
+            "f=832.1797717687189 comes from the frozen v2 horizontal focal "
+            "component and the principal point is the image center."
+        ),
+    ),
+}
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def quote_command(command: list[str]) -> str:
+    return " ".join(subprocess.list2cmdline([part]) for part in command)
+
+
+def run(command: list[str], log_path: Path, command_lines: list[str]) -> str:
+    command_lines.append(quote_command(command))
+    proc = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+    with log_path.open("a", encoding="utf-8") as handle:
+        handle.write(f"\n$ {quote_command(command)}\n")
+        handle.write(proc.stdout)
+    if proc.returncode:
+        raise subprocess.CalledProcessError(proc.returncode, command, output=proc.stdout)
+    return proc.stdout
+
+
+def parse_analyzer(text: str) -> dict[str, float | int | str | None]:
+    patterns = {
+        "cameras": r"^Cameras:\s+(\d+)",
+        "images": r"^Images:\s+(\d+)",
+        "registeredImages": r"^Registered images:\s+(\d+)",
+        "points": r"^Points:\s+(\d+)",
+        "observations": r"^Observations:\s+(\d+)",
+        "meanTrackLength": r"^Mean track length:\s+([0-9.eE+-]+)",
+        "meanObservationsPerImage": r"^Mean observations per image:\s+([0-9.eE+-]+)",
+        "meanReprojectionErrorPx": r"^Mean reprojection error:\s+([0-9.eE+-]+)px",
+    }
+    result: dict[str, float | int | str | None] = {"raw": text}
+    for key, pattern in patterns.items():
+        match = re.search(pattern, text, re.MULTILINE)
+        if not match:
+            result[key] = None
+        elif key in {"cameras", "images", "registeredImages", "points", "observations"}:
+            result[key] = int(match.group(1))
+        else:
+            result[key] = float(match.group(1))
+    return result
+
+
+def replace_camera(database: Path, candidate: Candidate) -> dict[str, object]:
+    connection = sqlite3.connect(database)
+    try:
+        rows = list(
+            connection.execute(
+                "SELECT camera_id, model, width, height, params, prior_focal_length FROM cameras"
+            )
+        )
+        if len(rows) != 1:
+            raise RuntimeError(f"expected one shared camera, found {len(rows)}")
+        camera_id, old_model, width, height, old_blob, old_prior = rows[0]
+        old_params = struct.unpack("<" + "d" * (len(old_blob) // 8), old_blob)
+        new_blob = struct.pack("<" + "d" * len(candidate.params), *candidate.params)
+        connection.execute(
+            "UPDATE cameras SET model=?, params=?, prior_focal_length=? WHERE camera_id=?",
+            (
+                candidate.camera_model_id,
+                new_blob,
+                candidate.prior_focal_length,
+                camera_id,
+            ),
+        )
+        connection.commit()
+        return {
+            "cameraId": camera_id,
+            "width": width,
+            "height": height,
+            "before": {
+                "modelId": old_model,
+                "params": old_params,
+                "priorFocalLength": old_prior,
+            },
+            "after": {
+                "model": candidate.camera_model,
+                "modelId": candidate.camera_model_id,
+                "params": candidate.params,
+                "priorFocalLength": candidate.prior_focal_length,
+            },
+        }
+    finally:
+        connection.close()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("candidate", choices=CANDIDATES)
+    args = parser.parse_args()
+    candidate = CANDIDATES[args.candidate]
+    output = OUTPUT_ROOT / args.candidate
+    if output.exists():
+        raise SystemExit(f"refusing to overwrite existing isolated candidate: {output}")
+    output.mkdir(parents=True)
+    sparse = output / "sparse"
+    sparse.mkdir()
+    database = output / "database.db"
+    log_path = output / "colmap.log"
+    command_lines: list[str] = []
+
+    shutil.copy2(BASELINE_DB, database)
+    db_before_hash = sha256(BASELINE_DB)
+    camera_change = replace_camera(database, candidate)
+    metadata: dict[str, object] = {
+        "candidate": args.candidate,
+        "cameraModel": candidate.camera_model,
+        "evidence": candidate.evidence,
+        "baselineDatabase": str(BASELINE_DB),
+        "baselineDatabaseSha256": db_before_hash,
+        "matching": "reused byte-identical baseline SIFT features and exhaustive matches",
+        "cameraChange": camera_change,
+        "refineFocalLength": candidate.refine_focal_length,
+    }
+    (output / "candidate-input.json").write_text(
+        json.dumps(metadata, indent=2) + "\n", encoding="utf-8"
+    )
+
+    mapper = [
+        "colmap",
+        "mapper",
+        "--database_path",
+        str(database),
+        "--image_path",
+        str(IMAGE_DIR),
+        "--output_path",
+        str(sparse),
+        "--Mapper.ba_global_function_tolerance=1e-6",
+        "--Mapper.ba_refine_focal_length",
+        "1" if candidate.refine_focal_length else "0",
+    ]
+    run(mapper, log_path, command_lines)
+
+    model_dirs = sorted(path for path in sparse.iterdir() if path.is_dir())
+    if not model_dirs:
+        raise RuntimeError("COLMAP mapper produced no sparse model")
+    summaries: list[dict[str, object]] = []
+    for model_dir in model_dirs:
+        bundle_adjuster = [
+            "colmap",
+            "bundle_adjuster",
+            "--input_path",
+            str(model_dir),
+            "--output_path",
+            str(model_dir),
+            "--BundleAdjustment.refine_focal_length",
+            "1" if candidate.refine_focal_length else "0",
+            "--BundleAdjustment.refine_principal_point",
+            "1",
+        ]
+        run(bundle_adjuster, log_path, command_lines)
+        analyzer = run(
+            ["colmap", "model_analyzer", "--path", str(model_dir)],
+            log_path,
+            command_lines,
+        )
+        (output / f"model_analyzer-{model_dir.name}.txt").write_text(analyzer, encoding="utf-8")
+        parsed = parse_analyzer(analyzer)
+        parsed["modelDirectory"] = model_dir.name
+        summaries.append(parsed)
+
+    best = max(
+        summaries,
+        key=lambda item: (
+            int(item.get("registeredImages") or 0),
+            int(item.get("points") or 0),
+            int(item.get("observations") or 0),
+        ),
+    )
+    best_dir = sparse / str(best["modelDirectory"])
+    txt_dir = output / "model-txt"
+    txt_dir.mkdir()
+    run(
+        [
+            "colmap",
+            "model_converter",
+            "--input_path",
+            str(best_dir),
+            "--output_path",
+            str(txt_dir),
+            "--output_type",
+            "TXT",
+        ],
+        log_path,
+        command_lines,
+    )
+    anchor_list = output / "anchor-images.txt"
+    anchor_list.write_text("\n".join(ANCHORS) + "\n", encoding="utf-8")
+    undistorted = output / "undistorted-anchors"
+    run(
+        [
+            "colmap",
+            "image_undistorter",
+            "--image_path",
+            str(IMAGE_DIR),
+            "--input_path",
+            str(best_dir),
+            "--output_path",
+            str(undistorted),
+            "--output_type",
+            "COLMAP",
+            "--image_list_path",
+            str(anchor_list),
+        ],
+        log_path,
+        command_lines,
+    )
+    result = {
+        **metadata,
+        "models": summaries,
+        "bestModelDirectory": str(best_dir),
+        "bestModel": best,
+        "commands": command_lines,
+    }
+    (output / "candidate-result.json").write_text(
+        json.dumps(result, indent=2) + "\n", encoding="utf-8"
+    )
+    (output / "commands.txt").write_text("\n".join(command_lines) + "\n", encoding="utf-8")
+    print(json.dumps(best, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except subprocess.CalledProcessError as exc:
+        print(exc.output, file=sys.stderr)
+        raise
