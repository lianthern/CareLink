@@ -0,0 +1,173 @@
+#!/usr/bin/env python3
+"""Render the repaired v3 checkpoint at the three contract anchors."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import cv2
+import numpy as np
+import torch
+from PIL import Image
+from nerfstudio.utils.eval_utils import eval_setup
+
+
+ANCHORS = ("frame_00001.jpg", "frame_00036.jpg", "frame_00072.jpg")
+
+
+def save_rgb(path: Path, tensor: torch.Tensor) -> None:
+    array = (
+        tensor.detach().cpu().clamp(0.0, 1.0).mul(255.0).round().to(torch.uint8).numpy()
+    )
+    Image.fromarray(array).save(path)
+
+
+def undistort_original(image: np.ndarray, transforms: dict) -> np.ndarray:
+    """Apply the same OpenCV projection used by Nerfstudio's image cache."""
+    intrinsic = np.asarray(
+        [
+            [transforms["fl_x"], 0.0, transforms["cx"] - 0.5],
+            [0.0, transforms["fl_y"], transforms["cy"] - 0.5],
+            [0.0, 0.0, 1.0],
+        ],
+        dtype=np.float64,
+    )
+    distortion = np.asarray(
+        [
+            transforms.get("k1", 0.0),
+            transforms.get("k2", 0.0),
+            transforms.get("p1", 0.0),
+            transforms.get("p2", 0.0),
+            transforms.get("k3", 0.0),
+            0.0,
+            0.0,
+            0.0,
+        ],
+        dtype=np.float64,
+    )
+    new_intrinsic, (x, y, width, height) = cv2.getOptimalNewCameraMatrix(
+        intrinsic, distortion, (image.shape[1], image.shape[0]), 0
+    )
+    undistorted = cv2.undistort(image, intrinsic, distortion, None, new_intrinsic)
+    return undistorted[y : y + height, x : x + width]
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--config", type=Path, required=True)
+    parser.add_argument("--original-root", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(parents=True, exist_ok=True)
+
+    _, pipeline, checkpoint_path, step = eval_setup(args.config, test_mode="test")
+    datamanager = pipeline.datamanager
+    model = pipeline.model
+    transforms_path = Path(datamanager.config.dataparser.data) / "transforms.json"
+    transforms = json.loads(transforms_path.read_text(encoding="utf-8"))
+    cached_train = datamanager.cached_train
+    names = [path.name for path in datamanager.train_dataset.image_filenames]
+    rows = []
+    for anchor in ANCHORS:
+        if anchor not in names:
+            raise RuntimeError(f"contract anchor is not in train split: {anchor}")
+        index = names.index(anchor)
+        camera = datamanager.train_dataset.cameras[index : index + 1].to(pipeline.device)
+        batch = cached_train[index]
+        with torch.no_grad():
+            outputs = model.get_outputs_for_camera(camera)
+        rendered = outputs["rgb"]
+        source_tensor = model.get_gt_img(batch["image"])
+        processed_path = Path(datamanager.train_dataset.image_filenames[index])
+        original_path = args.original_root / anchor
+        processed_source = np.asarray(Image.open(processed_path).convert("RGB"), dtype=np.uint8)
+        original_source = np.asarray(Image.open(original_path).convert("RGB"), dtype=np.uint8)
+        original_metric_target = undistort_original(original_source, transforms)
+        cached_source = (
+            source_tensor.detach()
+            .cpu()
+            .clamp(0.0, 1.0)
+            .mul(255.0)
+            .round()
+            .to(torch.uint8)
+            .numpy()
+        )
+        if original_metric_target.shape != tuple(rendered.shape):
+            raise RuntimeError(
+                f"original-source projection shape {original_metric_target.shape} "
+                f"does not match render {tuple(rendered.shape)}"
+            )
+        original_tensor = (
+            torch.from_numpy(original_metric_target.copy()).to(rendered.device).float() / 255.0
+        )
+        gt_metric = torch.moveaxis(original_tensor, -1, 0)[None, ...]
+        prediction_metric = torch.moveaxis(rendered, -1, 0)[None, ...]
+        metrics = {
+            "psnr": float(model.psnr(gt_metric, prediction_metric).item()),
+            "ssim": float(model.ssim(gt_metric, prediction_metric)),
+            "lpips": float(model.lpips(gt_metric, prediction_metric)),
+        }
+        save_rgb(args.output / f"{Path(anchor).stem}-checkpoint.png", rendered)
+        Image.fromarray(original_metric_target).save(
+            args.output / f"{Path(anchor).stem}-source-projected.png"
+        )
+        rows.append(
+            {
+                "frame": Path(anchor).stem,
+                "trainIndex": index,
+                "psnr": metrics["psnr"],
+                "ssim": metrics["ssim"],
+                "lpips": metrics["lpips"],
+                "processedSourceMatchesOriginalExactly": bool(
+                    np.array_equal(processed_source, original_source)
+                ),
+                "processedSourceMaxAbsByteError": int(
+                    np.max(
+                        np.abs(
+                            processed_source.astype(np.int16)
+                            - original_source.astype(np.int16)
+                        )
+                    )
+                ),
+                "metricTarget": "Nerfstudio/OpenCV projection applied directly to the original source",
+                "originalShape": list(original_source.shape),
+                "metricTargetShape": list(original_metric_target.shape),
+                "metricTargetVsTrainingCacheMaxAbsByteError": int(
+                    np.max(
+                        np.abs(
+                            original_metric_target.astype(np.int16)
+                            - cached_source.astype(np.int16)
+                        )
+                    )
+                ),
+            }
+        )
+    result = {
+        "checkpoint": str(checkpoint_path),
+        "step": step,
+        "anchors": rows,
+        "means": {
+            key: float(np.mean([float(row[key]) for row in rows]))
+            for key in ("psnr", "ssim", "lpips")
+        },
+        "gate": {
+            "thresholds": {"psnrMin": 20.0, "ssimMin": 0.80, "lpipsMax": 0.30},
+            "pass": all(
+                float(row["psnr"]) >= 20.0
+                and float(row["ssim"]) >= 0.80
+                and float(row["lpips"]) <= 0.30
+                for row in rows
+            ),
+        },
+    }
+    (args.output / "checkpoint-metrics.json").write_text(
+        json.dumps(result, indent=2) + "\n", encoding="utf-8"
+    )
+    print(json.dumps(result, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
