+++ b/scripts/run_repair_v3_train.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+data_root="$project_root/reports/repair-v3/processed/SIMPLE_RADIAL_AUTO"
+output_root="$project_root/artifacts/training/repair-v3"
+report_root="$project_root/reports/repair-v3"
+log_root="$report_root/logs"
+
+[[ -f "$data_root/transforms.json" ]] || { echo "missing repaired dataset" >&2; exit 1; }
+[[ ! -e "$output_root/pexels-simple-radial-auto-v3" ]] || {
+  echo "refusing to launch a second v3 training run: output already exists" >&2
+  exit 1
+}
+mkdir -p "$output_root" "$log_root"
+source "$project_root/.venv/bin/activate"
+
+nvidia-smi --query-gpu=timestamp,memory.used,utilization.gpu \
+  --format=csv,noheader,nounits -lms 500 >"$log_root/gpu-samples.csv" &
+monitor_pid=$!
+cleanup() {
+  kill "$monitor_pid" 2>/dev/null || true
+  wait "$monitor_pid" 2>/dev/null || true
+}
+trap cleanup EXIT
+
+start_epoch=$(date +%s)
+set +e
+/usr/bin/time -v ns-train splatfacto \
+  --output-dir "$output_root" \
+  --experiment-name pexels-simple-radial-auto-v3 \
+  --max-num-iterations 7000 \
+  --steps-per-save 2000 \
+  --steps-per-eval-image 100000 \
+  --steps-per-eval-all-images 100000 \
+  --vis tensorboard \
+  --pipeline.model.use-scale-regularization True \
+  --pipeline.model.random-init False \
+  nerfstudio-data \
+  --data "$data_root" \
+  --load-3D-points True \
+  --orientation-method up \
+  --center-method poses \
+  --auto-scale-poses True \
+  --eval-mode all \
+  2>&1 | tee "$log_root/train.log"
+train_status=${PIPESTATUS[0]}
+set -e
+end_epoch=$(date +%s)
+cleanup
+trap - EXIT
+
+{
+  printf 'start_epoch=%s\n' "$start_epoch"
+  printf 'end_epoch=%s\n' "$end_epoch"
+  printf 'wall_seconds=%s\n' "$((end_epoch - start_epoch))"
+  printf 'train_exit_code=%s\n' "$train_status"
+  awk -F, '
+    {gsub(/ /, "", $2); if (($2 + 0) > peak) peak=$2 + 0}
+    END {printf "peak_vram_mib=%d\n", peak}
+  ' "$log_root/gpu-samples.csv"
+} >"$report_root/train-runtime.txt"
+
+exit "$train_status"
