# Book Lab stays disabled unless this is the exact string true.
UNSEEN_BOOK_LAB_ENABLED=false

# Core and same-origin listener. Use absolute private paths. Set the browser-visible origin behind TLS/reverse proxy.
UNSEEN_API_HOST=127.0.0.1
UNSEEN_API_PORT=8787
UNSEEN_PUBLIC_ORIGIN=https://<book-hostname>
UNSEEN_API_DB=<absolute-private-data-directory>/core.sqlite
UNSEEN_API_KEYSET=<absolute-private-data-directory>/core.keyset.json
UNSEEN_API_MEDIA_ROOT=<absolute-private-data-directory>/media
UNSEEN_BOOK_LAB_LOCK=<absolute-private-runtime-directory>/book-lab-deployment.lock

# Required only when enabling the real extension. Use an absolute persistent path.
UNSEEN_BOOK_LAB_DB=<absolute-private-data-directory>/book-lab.sqlite
UNSEEN_BOOK_LAB_RENDER_TMP=<absolute-private-runtime-directory>/book-render
UNSEEN_BOOK_LAB_RENDER_TIMEOUT_MS=120000
UNSEEN_CHROMIUM_PATH=/snap/chromium/3507/usr/lib/chromium-browser/chrome

# Linux production uses the dedicated default-off renderer service. These variables configure its API client only;
# the daemon reads no EnvironmentFile. Its socket is filesystem AF_UNIX and its root:ipc 0640 receipt pins all bytes.
# UNSEEN_BOOK_RENDERER_TRANSPORT=unseen-book-renderer-dedicated-service/v1
# UNSEEN_BOOK_RENDERER_SOCKET=/run/unseen-renderer/render.sock
# UNSEEN_BOOK_RENDERER_SPOOL=/var/lib/unseen/renderer-spool
# UNSEEN_BOOK_RENDERER_ACCEPTANCE_FILE=/run/unseen/approvals/book-renderer-acceptance.json
# UNSEEN_BOOK_RENDERER_ACCEPTANCE_SHA256=<target-acceptance-receipt-sha256>
# Target receipt generation only: ["/usr","/lib","/lib64","/etc/fonts","/snap/chromium/3507"]
# UNSEEN_BOOK_RENDERER_READ_ONLY_MOUNTS_JSON=<json-array-of-read-only-roots>

# macOS uses the built-in sandbox-exec egress profile. Other targets must provide a wrapper that executes argv as-is,
# denies network egress for the command and every descendant, and has been verified with TCP/UDP/DNS capability probes.
# Leave both unset on macOS. Supplying only one value or a different attestation fails startup/render preflight.
# UNSEEN_BOOK_LAB_EGRESS_WRAPPER=<absolute-executable-os-or-container-wrapper>
# UNSEEN_BOOK_LAB_EGRESS_ATTESTATION=unseen-egress-wrapper-deny-network-descendants/v1

# Four distinct secrets, each at least 32 characters, supplied by the deployment secret store.
UNSEEN_BOOK_LAB_ETAG_SECRET=<secret-store-reference>
UNSEEN_BOOK_LAB_WORKER_SECRET=<secret-store-reference>
UNSEEN_BOOK_LAB_CLEANUP_SECRET=<secret-store-reference>
UNSEEN_BOOK_LAB_RENDER_WORKER_SECRET=<secret-store-reference>

# Exact approved notice values. Do not substitute fixture or draft copy.
UNSEEN_BOOK_LAB_COLLECTION_NOTICE_VERSION=<approved-version>
UNSEEN_BOOK_LAB_COLLECTION_NOTICE_HASH=<approved-sha256>
UNSEEN_BOOK_LAB_COLLECTION_NOTICE_COPY=<approved-plain-language-copy>
UNSEEN_BOOK_LAB_GRANT_NOTICE_VERSION=<approved-version>
UNSEEN_BOOK_LAB_GRANT_NOTICE_HASH=<approved-sha256>
