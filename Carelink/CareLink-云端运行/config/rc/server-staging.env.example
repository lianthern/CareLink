# Non-secret server staging template. Copy outside Git, replace every example path/host, keep mode 0600.
UNSEEN_STAGING_MODE=server_staging
UNSEEN_STAGING_EXTERNAL_EXPOSURE_ACK=access_controlled_tls_reverse_proxy
UNSEEN_STAGING_HOST=127.0.0.1
UNSEEN_STAGING_PORT=4282
UNSEEN_STAGING_PUBLIC_ORIGIN=https://staging.example.com
UNSEEN_STAGING_EXPECT_REPOSITORY_STATE=clean

# Private persistent paths. The service applies umask 077; directories/files must remain 0700/0600.
UNSEEN_STAGING_DATA_DIR=/var/lib/unseen/staging/core-data
UNSEEN_STAGING_RUNTIME_EVIDENCE_DIR=/var/lib/unseen/staging/runtime-evidence
# Clean detached checkout at 7d3590d3329252f4226adb2a751ffe9a2384d390.
UNSEEN_BOOK_WORKTREE=/opt/unseen/book-web
UNSEEN_BOOK_OUTPUT_DIR=/var/lib/unseen/staging/book-artifacts
UNSEEN_STAGING_BACKUP_DIR=/var/backups/unseen/staging
UNSEEN_CHROMIUM_PATH=/usr/bin/chromium

# Honest current adapters. Production mode rejects startup until Tracks 1B/3B/6B/8C replace the fixture seams.
UNSEEN_STAGING_OTP_PROVIDER=local_fixture_only
UNSEEN_STAGING_MEDIA_PROVIDER=filesystem_fixture_only

# Paths only; never place a real credential value in this file or Git.
# UNSEEN_OTP_PROVIDER_SECRET_FILE=/run/secrets/unseen-otp-provider
# UNSEEN_MEDIA_PROVIDER_SECRET_FILE=/run/secrets/unseen-media-provider
