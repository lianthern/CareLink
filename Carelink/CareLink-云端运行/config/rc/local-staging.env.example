# Loopback-only local staging. Do not set a public or tunnel hostname here.
UNSEEN_STAGING_MODE=local
UNSEEN_STAGING_HOST=127.0.0.1
UNSEEN_STAGING_PORT=4180
UNSEEN_STAGING_PUBLIC_ORIGIN=http://127.0.0.1:4180
UNSEEN_STAGING_OTP_PROVIDER=local_fixture_only
UNSEEN_STAGING_MEDIA_PROVIDER=filesystem_fixture_only

# Set to clean in a deployed checkout. Local development may omit it while testing uncommitted staging changes.
# UNSEEN_STAGING_EXPECT_REPOSITORY_STATE=clean

# Optional overrides. Defaults use ~/Library/Application Support/UNSEEN/local-staging/.
# UNSEEN_STAGING_DATA_DIR=/absolute/private/path/core-data
# UNSEEN_STAGING_RUNTIME_EVIDENCE_DIR=/absolute/private/path/runtime-evidence
# Set this to a clean detached checkout at Book pin 7d3590d3329252f4226adb2a751ffe9a2384d390.
# Do not point verification at a mutable Book development worktree.
# UNSEEN_BOOK_WORKTREE=/absolute/path/to/detached/book-web
# UNSEEN_BOOK_OUTPUT_DIR=/absolute/private/path/book-artifacts
# UNSEEN_STAGING_BACKUP_DIR=/absolute/private/path/backups
# UNSEEN_CHROMIUM_PATH=/absolute/path/to/chromium

# Production provider credentials are not accepted by this file or current launcher.
# Future Track 1B adapters must receive real secrets from an external secret file/store.
# UNSEEN_OTP_PROVIDER_SECRET_FILE=/run/secrets/unseen-otp-provider
# UNSEEN_MEDIA_PROVIDER_SECRET_FILE=/run/secrets/unseen-media-provider
