# Non-secret production template. Copy to /etc/unseen/production.env, replace every
# `REQUIRED_*` value, keep mode 0600, and inject credentials only through the
# external service-manager secret environment below. The current preflight remains NO_GO.
UNSEEN_PRODUCTION_PROFILE=integrated_book_lab_8c
UNSEEN_INTEGRATED_8C_COMMIT=a16f7fdda14759429fd22054506f198980805e9d
UNSEEN_PRODUCTION_CANDIDATE_COMMIT=REQUIRED_CANDIDATE_COMMIT_FROM_PACKAGE_MANIFEST

# Accepted 8C lifecycle is integrated but stays default-off until the remaining
# facts/provider, Legal/Privacy and target authorization receipts exist. When
# false, preflight must not open the acceptance receipt or provider secret.
UNSEEN_BOOK_LAB_ENABLED=false
UNSEEN_CORE_FACTS_PROVIDER_ENABLED=false
UNSEEN_API_HOST=127.0.0.1
UNSEEN_API_PORT=4282
UNSEEN_PUBLIC_ORIGIN=https://REQUIRED_DOMAIN
UNSEEN_API_DB=/var/lib/unseen/production/core-data/unseen.sqlite
UNSEEN_API_KEYSET=/var/lib/unseen/production/core-data/keyset.json
UNSEEN_API_MEDIA_ROOT=/var/lib/unseen/production/core-data/media
UNSEEN_BOOK_LAB_LOCK=/var/lib/unseen/production/runtime-evidence/book-lab-deployment.lock

# Generic SMTP OTP transport remains default-off until Track 1B acceptance.
UNSEEN_OTP_DELIVERY_PROVIDER=disabled
# UNSEEN_SMTP_HOST=REQUIRED_SMTP_HOST
# UNSEEN_SMTP_PORT=REQUIRED_465_OR_587
# UNSEEN_SMTP_SECURITY=REQUIRED_implicit_tls_OR_starttls
# UNSEEN_SMTP_USERNAME=REQUIRED_SMTP_USERNAME
# UNSEEN_SMTP_FROM=REQUIRED_NORMALIZED_SENDER_EMAIL
# UNSEEN_SMTP_CONNECT_TIMEOUT_MS=5000
# UNSEEN_SMTP_SEND_TIMEOUT_MS=10000
# UNSEEN_SMTP_TOTAL_TIMEOUT_MS=30000
UNSEEN_BOOK_LAB_DB=/var/lib/unseen/production/core-data/book-lab.sqlite
UNSEEN_BOOK_LAB_RENDER_TMP=/var/lib/unseen/production/runtime-evidence/book-render
UNSEEN_BOOK_LAB_RENDER_TIMEOUT_MS=120000
UNSEEN_CHROMIUM_PATH=/snap/chromium/3507/usr/lib/chromium-browser/chrome

# These values configure only the API-side renderer client. The renderer daemon reads no EnvironmentFile and uses
# fixed production paths plus a root:unseen-render-ipc 0640 hash pin. Book remains inert while disabled.
UNSEEN_BOOK_RENDERER_TRANSPORT=unseen-book-renderer-dedicated-service/v1
UNSEEN_BOOK_RENDERER_SOCKET=/run/unseen-renderer/render.sock
UNSEEN_BOOK_RENDERER_SPOOL=/var/lib/unseen/renderer-spool
UNSEEN_BOOK_RENDERER_ACCEPTANCE_FILE=/run/unseen/approvals/book-renderer-acceptance.json
UNSEEN_BOOK_RENDERER_ACCEPTANCE_SHA256=REQUIRED_BOOK_RENDERER_ACCEPTANCE_SHA256
# Target receipt generation only (not read by the API service): JSON array containing /usr and the exact numeric snap root.
# UNSEEN_BOOK_RENDERER_READ_ONLY_MOUNTS_JSON=["/usr","/lib","/lib64","/etc/fonts","/snap/chromium/3507"]

# Target decoder executables are explicit immutable inputs. Use resolved regular
# files, not PATH names or symlinks. Preflight binds bytes but never executes them.
UNSEEN_FFMPEG_PATH=/REQUIRED_FFMPEG_EXECUTABLE
UNSEEN_FFMPEG_SHA256=REQUIRED_FFMPEG_BINARY_SHA256
UNSEEN_FFPROBE_PATH=/REQUIRED_FFPROBE_EXECUTABLE
UNSEEN_FFPROBE_SHA256=REQUIRED_FFPROBE_BINARY_SHA256
# Formal release separately requires target-operator evidence from an approved
# egress-constrained wrapper: exact -version stdout/stderr, build/configuration
# flags and zero unexpected egress. No receipt schema is defined by Stage5.

# Exact approved notices. These are non-secret release inputs.
UNSEEN_BOOK_LAB_COLLECTION_NOTICE_VERSION=REQUIRED_APPROVED_COLLECTION_NOTICE_VERSION
UNSEEN_BOOK_LAB_COLLECTION_NOTICE_HASH=REQUIRED_APPROVED_COLLECTION_NOTICE_SHA256
UNSEEN_BOOK_LAB_COLLECTION_NOTICE_COPY=REQUIRED_APPROVED_COLLECTION_NOTICE_COPY
UNSEEN_BOOK_LAB_GRANT_NOTICE_VERSION=REQUIRED_APPROVED_GRANT_NOTICE_VERSION
UNSEEN_BOOK_LAB_GRANT_NOTICE_HASH=REQUIRED_APPROVED_GRANT_NOTICE_SHA256

# Compatibility inputs for offline snapshot tooling. Book7d is retained only as
# the visibly labelled local-staging fixture; it is not a production Book input.
UNSEEN_STAGING_MODE=production
UNSEEN_STAGING_HOST=127.0.0.1
UNSEEN_STAGING_PORT=4282
UNSEEN_STAGING_PUBLIC_ORIGIN=https://REQUIRED_DOMAIN
UNSEEN_STAGING_EXPECT_REPOSITORY_STATE=clean
UNSEEN_STAGING_EXTERNAL_EXPOSURE_ACK=tls_reverse_proxy

# Private persistent volumes. Directories/files must remain 0700/0600.
UNSEEN_STAGING_DATA_DIR=/var/lib/unseen/production/core-data
UNSEEN_STAGING_RUNTIME_EVIDENCE_DIR=/var/lib/unseen/production/runtime-evidence
# Production snapshots bind the integrated candidate checkout itself. The
# separately bundled Book7d commit is used only by local staging.
UNSEEN_BOOK_WORKTREE=/opt/unseen/releases/REQUIRED_IMMUTABLE_RELEASE_COMMIT
UNSEEN_BOOK_OUTPUT_DIR=/var/lib/unseen/production/book-artifacts
UNSEEN_STAGING_BACKUP_DIR=/var/backups/unseen/production

# These are capability identifiers, never credential values. Replace only after
# the named tracks have supplied accepted production adapters.
UNSEEN_STAGING_OTP_PROVIDER=REQUIRED_TRACK1B_OTP_PROVIDER
UNSEEN_STAGING_MEDIA_PROVIDER=REQUIRED_TRACK1B_MEDIA_PROVIDER
UNSEEN_STAGING_LOCATOR_PROVIDER=REQUIRED_TRACK3B_LOCATOR_PROVIDER
UNSEEN_STAGING_BOOK_PROVIDER=integrated_8c_a16f7fdd

# Core provider secrets stay outside Git and this env file.
UNSEEN_OTP_PROVIDER_SECRET_FILE=/run/secrets/unseen-otp-provider
UNSEEN_MEDIA_PROVIDER_SECRET_FILE=/run/secrets/unseen-media-provider
UNSEEN_LOCATOR_PROVIDER_SECRET_FILE=/run/secrets/unseen-locator-provider

# Immutable acceptance/approval receipts supplied by their owners.
UNSEEN_TRACK1B_ACCEPTANCE_FILE=/run/unseen/approvals/track1b.json
UNSEEN_TRACK3B_ACCEPTANCE_FILE=/run/unseen/approvals/track3b.json
UNSEEN_CORE_FACTS_PROVIDER_ACCEPTANCE_FILE=/run/unseen/approvals/core-facts-provider.json
UNSEEN_CORE_FACTS_PROVIDER_ACCEPTANCE_SHA256=REQUIRED_CORE_FACTS_PROVIDER_ACCEPTANCE_SHA256
UNSEEN_LEGAL_PRIVACY_APPROVAL_FILE=/run/unseen/approvals/legal-privacy.json
UNSEEN_LEGAL_PRIVACY_APPROVAL_SHA256=REQUIRED_LEGAL_PRIVACY_APPROVAL_SHA256

# Target-specific operator inputs.
UNSEEN_DEPLOYMENT_ID=REQUIRED_DEPLOYMENT_ID
UNSEEN_BACKUP_RETENTION_DAYS=REQUIRED_BACKUP_RETENTION_DAYS
UNSEEN_BACKUP_TARGET=/REQUIRED_PRIVATE_BACKUP_TARGET
UNSEEN_ONCALL_OWNER=REQUIRED_ONCALL_OWNER

# The service manager must inject these four distinct values from its secret
# store via /run/unseen/production.secrets; never put them in this file or Git:
# UNSEEN_BOOK_LAB_ETAG_SECRET
# UNSEEN_BOOK_LAB_WORKER_SECRET
# UNSEEN_BOOK_LAB_CLEANUP_SECRET
# UNSEEN_BOOK_LAB_RENDER_WORKER_SECRET
