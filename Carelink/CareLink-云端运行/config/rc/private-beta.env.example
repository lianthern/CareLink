# Non-secret configuration for the private-beta services. Book and private AI remain default-off.
# This profile does not replace or weaken the formal production unit or its
# ExecStartPre. Copy only to the target host and keep the resulting files 0600.

# Core API: real persistent storage, loopback only, Book and question provider off.
UNSEEN_BOOK_LAB_ENABLED=false
UNSEEN_CORE_FACTS_PROVIDER_ENABLED=false
UNSEEN_API_HOST=127.0.0.1
UNSEEN_API_PORT=4282
UNSEEN_PUBLIC_ORIGIN=https://REQUIRED_PRIVATE_BETA_DOMAIN
UNSEEN_API_DB=/var/lib/unseen/private-beta/core-data/unseen.sqlite
UNSEEN_API_KEYSET=/var/lib/unseen/private-beta/core-data/keyset.json
UNSEEN_API_MEDIA_ROOT=/var/lib/unseen/private-beta/core-data/media
UNSEEN_BOOK_LAB_LOCK=/var/lib/unseen/private-beta/runtime/book-lab-deployment.lock

# Required together when Book is explicitly enabled. Keep secrets in the root-owned 0600 environment file;
# these values authenticate only same-process jobs and are never sent to the Mac worker.
# UNSEEN_BOOK_LAB_DB=/var/lib/unseen/private-beta/book-data/book.sqlite
# UNSEEN_BOOK_LAB_RENDER_TMP=/var/lib/unseen/private-beta/runtime/book-render-tmp
# UNSEEN_CHROMIUM_PATH=/usr/bin/chromium
# UNSEEN_BOOK_LAB_ETAG_SECRET=REQUIRED_RANDOM_32_PLUS_CHARACTERS
# UNSEEN_BOOK_LAB_WORKER_SECRET=REQUIRED_DISTINCT_RANDOM_32_PLUS_CHARACTERS
# UNSEEN_BOOK_LAB_CLEANUP_SECRET=REQUIRED_DISTINCT_RANDOM_32_PLUS_CHARACTERS
# UNSEEN_BOOK_LAB_RENDER_WORKER_SECRET=REQUIRED_DISTINCT_RANDOM_32_PLUS_CHARACTERS
# UNSEEN_BOOK_LAB_COLLECTION_NOTICE_VERSION=REQUIRED_PRIVATE_BETA_NOTICE_VERSION
# UNSEEN_BOOK_LAB_COLLECTION_NOTICE_HASH=REQUIRED_64_LOWERCASE_HEX
# UNSEEN_BOOK_LAB_COLLECTION_NOTICE_COPY=REQUIRED_PLAIN_LANGUAGE_PRIVATE_AI_NOTICE
# UNSEEN_BOOK_LAB_GRANT_NOTICE_VERSION=REQUIRED_BOOK_GRANT_NOTICE_VERSION
# UNSEEN_BOOK_LAB_GRANT_NOTICE_HASH=REQUIRED_64_LOWERCASE_HEX

# Private Codex subscription test worker: DEFAULT OFF / NOT DEPLOYED.
# Enable only after the Mac pull worker, prompt/policy hashes and exact model
# identity have passed the private-AI acceptance runbook. The server file stores
# only SHA-256(worker token), never the bearer token itself.
UNSEEN_PRIVATE_AI_WORKER_ENABLED=false
# UNSEEN_PRIVATE_AI_WORKER_TOKEN_HASH_FILE=/run/secrets/unseen-private-ai-worker-token.sha256
# UNSEEN_PRIVATE_AI_PROMPT_HASH=67a580e7617893004c7edb1e0f7578cd40a28509dd5ac756ae914ed201479d73
# UNSEEN_PRIVATE_AI_POLICY_HASH=75ea90bfd53213ce15adf81973de5e26db4f091c3ca853aa991033ee37d46e5d
# UNSEEN_PRIVATE_AI_MODEL=gpt-5.6-sol
# UNSEEN_PRIVATE_AI_MODEL_VERSION=codex-cli 0.147.0/gpt-5.6-sol

# Default-off generic SMTP OTP transport. Enable only after replacing every
# REQUIRED_* field and installing the password as a regular non-symlink 0400/0600 file.
UNSEEN_OTP_DELIVERY_PROVIDER=disabled
# UNSEEN_SMTP_HOST=REQUIRED_SMTP_HOST
# UNSEEN_SMTP_PORT=REQUIRED_465_OR_587
# UNSEEN_SMTP_SECURITY=REQUIRED_implicit_tls_OR_starttls
# UNSEEN_SMTP_USERNAME=REQUIRED_SMTP_USERNAME
# UNSEEN_SMTP_FROM=REQUIRED_NORMALIZED_SENDER_EMAIL
# UNSEEN_OTP_PROVIDER_SECRET_FILE=/run/secrets/unseen-smtp-password
# UNSEEN_SMTP_CONNECT_TIMEOUT_MS=5000
# UNSEEN_SMTP_SEND_TIMEOUT_MS=10000
# UNSEEN_SMTP_TOTAL_TIMEOUT_MS=30000

# Formal Web: no local fixture API, locator fixture, test mode or UI fixture.
UNSEEN_WEB_PORT=4173
UNSEEN_WEB_LOCAL_API=0
UNSEEN_WEB_TEST=0
UNSEEN_WEB_LOCAL_DETERMINISTIC_LOCATOR=0
UNSEEN_WEB_UI_PRODUCTIZATION_FIXTURE=0
# Independent from the API-side UNSEEN_BOOK_LAB_ENABLED above (see apps/web/server.mjs): that flag only
# mounts /v2-labs/* on the API. This one makes the Web process inject featureFlags.bookLab=true into the
# SPA's __UNSEEN_CONFIG__, which is what actually registers the BL01-BL06 routes and the "聊聊这张" photo-detail
# entry point (apps/web/src/extensions/book-lab.js). Both must be "on" together for a contributor to ever
# reach the question flow — flipping only the API-side flag leaves the AI worker fully configured with zero
# UI ever able to create a personal memory or enqueue a question job. Keep in lockstep with the API flag above.
UNSEEN_WEB_BOOK_LAB_ENABLED=0

# Private AI true requires Book true. It still has no SLA and must fail closed when the Mac worker is offline.
