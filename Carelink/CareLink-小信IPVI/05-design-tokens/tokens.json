{
  "name": "小信 CareLink",
  "version": "1.0",
  "date": "2026-10-31",
  "status": "project-design-proposal",
  "colors": {
    "blue": "#4BA8EC",
    "navy": "#0B2856",
    "white": "#FFFEFA",
    "mist": "#EAF5FF",
    "muted": "#52677F",
    "line": "#CBDDEB",
    "action": "#1465B8",
    "warm": "#E7A83E",
    "success": "#23785A",
    "danger": "#B63D4A"
  },
  "typography": {
    "family": "Noto Sans CJK SC, Microsoft YaHei, PingFang SC, sans-serif",
    "display": 48,
    "h1": 32,
    "h2": 24,
    "body": 20,
    "caption": 16,
    "lineHeight": 1.6
  },
  "radius": {
    "card": 24,
    "button": 16,
    "pill": 999
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "interaction": {
    "touchTargetMin": 48,
    "elderPrimaryTarget": 64,
    "focusRing": 3,
    "stateMustIncludeText": true,
    "reduceMotionSupported": true
  },
  "motionMs": {
    "press": 120,
    "stateTransition": 240,
    "gentleGreeting": 900
  },
